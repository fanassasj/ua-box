  [ "$shortcut" = "0" ] || [ -z "$shortcut" ] && return 0

  if ! printf '%s\n' "$shortcut" | grep -Eq '^[A-Za-z_][A-Za-z0-9_-]*$'; then
    echo "快捷键只能使用字母、数字、下划线或中划线，且不能以数字开头。"
    return 1
  fi

  shell_rc="$HOME/.bashrc"
  case "${SHELL##*/}" in zsh) shell_rc="$HOME/.zshrc" ;; esac
  target="$(readlink -f "$0" 2>/dev/null || echo "$0")"

  sed -i "/# UA Box shortcut:/d" "$shell_rc" 2>/dev/null || true
  sed -i "/alias ${shortcut}=/d" "$shell_rc" 2>/dev/null || true
  printf "\n# UA Box shortcut: %s\nalias %s='%s'\n" "$shortcut" "$shortcut" "$target" >> "$shell_rc"
  log_action "set shortcut $shortcut -> $target"
  echo "快捷键已设置: $shortcut"
  echo "重新登录 Shell 或执行 source $shell_rc 后生效。"
}

system_install_python_version() {
  local version pm pkg

  need_root || return 1
  read -r -e -p "请输入 Python 版本，例 3.11 或 3.12: " version
  [ -z "$version" ] && return 1

  if ! printf '%s\n' "$version" | grep -Eq '^3\.[0-9]+([.][0-9]+)?$'; then
    echo "版本格式不正确。"
    return 1
  fi

  pm="$(pkg_manager)"
  pkg="python${version}"
  log_action "install Python $version"

  case "$pm" in
    apt)
      apt update -y
      DEBIAN_FRONTEND=noninteractive apt install -y "$pkg" "${pkg}-venv" "${pkg}-dev" || {
        echo "包管理器未提供 $pkg。若已安装 pyenv，可改用 pyenv 安装。"
        if has_cmd pyenv; then
          read -r -e -p "是否尝试 pyenv install $version ? 输入 yes 确认: " answer
          [ "$answer" = "yes" ] && pyenv install -s "$version"
        fi
      }
      ;;
    dnf|yum) install_pkg "$pkg" ;;
    apk) install_pkg python3 py3-pip ;;
    pacman) install_pkg python ;;
    zypper) install_pkg "$pkg" ;;
    *) echo "未知包管理器，无法安装 Python。"; return 1 ;;
  esac
}

ssh_set_global_option() {
  local file="$1"
  local key="$2"
  local value="$3"
  local tmp

  tmp="$(mktemp "${file}.tmp.XXXXXX")" || return 1
  awk -v key="$key" -v value="$value" '
    BEGIN {
      done = 0
      in_match = 0
      key_lc = tolower(key)
    }
    {
      first = tolower($1)
    }
    first == "match" {
      if (!done) {
        print key " " value
        done = 1
      }
      in_match = 1
      print
      next
    }
    !in_match && first == key_lc {
      if (!done) {
        print key " " value
        done = 1
      }
      next
    }
    !in_match && $0 ~ "^[#[:space:]]*" key "[[:space:]]" {
      if (!done) {
        print key " " value
        done = 1
      }
      next
    }
    {
      print
    }
    END {
      if (!done) {
        print key " " value
      }
    }
  ' "$file" > "$tmp" && mv "$tmp" "$file"
  local rc=$?
  rm -f "$tmp"
  return "$rc"
}

ssh_restart_service() {
  svc restart ssh 2>/dev/null || svc restart sshd 2>/dev/null
}

ssh_apply_login_profile() {
  local label="$1"
  local root_login="$2"
  local password_auth="$3"
  local backup
  backup="/etc/ssh/sshd_config.ua-box.$(date +%Y%m%d-%H%M%S).bak"


  need_root || return 1
  if [ ! -f /etc/ssh/sshd_config ]; then
    echo "未找到 /etc/ssh/sshd_config。"
    return 1
  fi

  cp /etc/ssh/sshd_config "$backup" || return 1
  prune_old_backups "/etc/ssh" "sshd_config.ua-box.*.bak" "${UA_MAX_BACKUPS:-10}"
  if ! ssh_set_global_option /etc/ssh/sshd_config PermitRootLogin "$root_login" ||
     ! ssh_set_global_option /etc/ssh/sshd_config PasswordAuthentication "$password_auth" ||
     ! ssh_set_global_option /etc/ssh/sshd_config PubkeyAuthentication yes; then
    cp "$backup" /etc/ssh/sshd_config
    echo "SSH 配置写入失败，已回滚到: $backup"
    return 1
  fi

  if ! sshd -t; then
    cp "$backup" /etc/ssh/sshd_config
    echo "SSH 配置校验失败，已回滚到: $backup"
    return 1
  fi

  if ! ssh_restart_service; then
    cp "$backup" /etc/ssh/sshd_config
    ssh_restart_service >/dev/null 2>&1 || true
    echo "SSH 重启失败，已回滚到: $backup"
    return 1
  fi

  log_action "$label"
  echo "SSH 配置已更新并重启。备份: $backup"
  if has_cmd sshd; then
    echo "当前生效摘要:"
    sshd -T -C user=root,host=localhost,addr=127.0.0.1 2>/dev/null | grep -E '^(permitrootlogin|passwordauthentication|pubkeyauthentication)' || true
  fi
}

system_enable_root_password_login() {
  need_root || return 1

  echo "该功能会临时开启 root 密码登录，并开启全局 SSH 密码认证。"
  echo "建议只用于救援；确认 admin 密钥可登录后应关闭。"
  if confirm_danger "临时开启 ROOT 密码登录" "/etc/ssh/sshd_config"; then
    passwd root || return 1
    ssh_apply_login_profile "enable root password ssh login" yes yes
  fi
}

user_has_ssh_pubkey() {
  local target_user="$1"
  local home_dir key_file
  home_dir="$(getent passwd "$target_user" 2>/dev/null | cut -d: -f6)"
  [ -z "$home_dir" ] && return 1
  key_file="$home_dir/.ssh/authorized_keys"
  [ -f "$key_file" ] || return 1
  grep -Eq '^[[:space:]]*(ssh-rsa|ssh-dss|ecdsa-sha2-nistp[0-9]+|ssh-ed25519|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp[0-9]+@openssh\.com)[[:space:]]+' "$key_file" 2>/dev/null
}

any_login_user_has_ssh_pubkey() {
  local u users
  users="$(awk -F: '($3 == 0 || $3 >= 1000) && $7 !~ /nologin$|false$|sync$/ {print $1}' /etc/passwd 2>/dev/null)"
  for u in $users; do
    if user_has_ssh_pubkey "$u"; then
      return 0
    fi
  done
  return 1
}

system_disable_root_password_login() {
  need_root || return 1

  echo "该功能会关闭 root 密码登录，保留普通用户 SSH 密码登录，并保留公钥登录。"
  if ! user_has_ssh_pubkey root; then
    local normal_users
    normal_users="$(awk -F: '$3 >= 1000 && $7 !~ /nologin$|false$|sync$/ {print $1}' /etc/passwd 2>/dev/null)"
    if [ -z "$normal_users" ]; then
      echo -e "${gl_hong}⚠️  安全拦截:${gl_bai} 检测到 root 用户尚未配置任何有效的 SSH 公钥，且系统无其他普通登录用户！"
      echo "若此时关闭 root 密码登录，您将彻底失去 SSH 访问权限。"
      read -r -e -p "是否现在先为 root 导入 SSH 公钥？[Y/n]: " go_import
      go_import="${go_import:-Y}"
      if [[ "$go_import" =~ ^[Yy]$ ]]; then
        system_import_ssh_key || return 1
      else
        echo "已取消操作。"
        return 1
      fi
    else
      echo -e "${gl_huang}⚠️  警告:${gl_bai} root 尚未配置 SSH 公钥，关闭后需使用普通用户 (${normal_users}) 登录。"
    fi
  fi
  if confirm_danger "关闭 ROOT 密码登录，保留普通用户密码登录" "/etc/ssh/sshd_config"; then
    ssh_apply_login_profile "disable root password ssh login" prohibit-password yes
  fi
}

system_disable_all_password_login() {
  need_root || return 1

  echo "该功能会关闭 root 密码登录，并禁用所有用户的 SSH 密码认证，保留公钥登录。"
  if ! any_login_user_has_ssh_pubkey; then
    echo -e "${gl_hong}⚠️  高危锁死拦截:${gl_bai} 检测到系统所有可登录用户（含 root）均未配置有效的 SSH 公钥 (authorized_keys)！"
    echo "若此时禁用所有密码认证，重启 SSH 后您将彻底无法登录服务器！"
    read -r -e -p "是否现在先导入/安装 SSH 公钥？[Y/n]: " go_import
    go_import="${go_import:-Y}"
    if [[ "$go_import" =~ ^[Yy]$ ]]; then
      system_import_ssh_key || return 1
      any_login_user_has_ssh_pubkey || return 1
    else
      echo "已取消禁用密码登录操作。"
      return 1
    fi
  fi
  if confirm_danger "关闭 ROOT 密码登录并禁用所有密码认证" "/etc/ssh/sshd_config"; then
    ssh_apply_login_profile "disable all ssh password login" prohibit-password no
  fi
}

system_check_admin_key_login() {
  echo -e "${gl_kjlan}系统用户 SSH 密钥及权限诊断${gl_bai}"
  echo -e "${gl_kjlan}-------------------------------------------------------------------------${gl_bai}"
  printf "%-12s %-16s %-16s %-16s %s\n" "用户" "Home 目录" ".ssh 目录" "auth_keys" "状态"
  
  local users
  users=$(awk -F: '($3 == 0 || $3 >= 1000) && $7 !~ /nologin$|false$|sync$/ {print $1}' /etc/passwd)
  
  for u in $users; do
    local home_dir ssh_dir key_file
    home_dir="$(getent passwd "$u" | cut -d: -f6)"
    ssh_dir="$home_dir/.ssh"
    key_file="$ssh_dir/authorized_keys"
    
    local home_stat="缺失"
    local ssh_stat="缺失"
    local key_stat="缺失"
    local status_msg="${gl_lv}正常${gl_bai}"
    local err_count=0

    if [ -d "$home_dir" ]; then
      local h_perm h_owner
      h_perm=$(stat -c '%a' "$home_dir" 2>/dev/null)
      h_owner=$(stat -c '%U' "$home_dir" 2>/dev/null)
      home_stat="${h_owner}:${h_perm}"
      if [[ "$h_perm" =~ ^.[2367].$|^..[2367]$ ]]; then
        status_msg="${gl_hong}Home权限过大${gl_bai}"
        err_count=$((err_count+1))
      fi
    fi

    if [ -d "$ssh_dir" ]; then
      local s_perm s_owner
      s_perm=$(stat -c '%a' "$ssh_dir" 2>/dev/null)
      s_owner=$(stat -c '%U' "$ssh_dir" 2>/dev/null)
      ssh_stat="${s_owner}:${s_perm}"
      if [[ "$s_perm" != "700" ]]; then
        status_msg="${gl_hong}.ssh须700${gl_bai}"
        err_count=$((err_count+1))
      fi
    fi

    if [ -f "$key_file" ]; then
      local k_perm k_owner
      k_perm=$(stat -c '%a' "$key_file" 2>/dev/null)
      k_owner=$(stat -c '%U' "$key_file" 2>/dev/null)
      key_stat="${k_owner}:${k_perm}"
      if [[ "$k_perm" != "600" && "$k_perm" != "644" && "$k_perm" != "400" ]]; then
        status_msg="${gl_hong}Key须600${gl_bai}"
        err_count=$((err_count+1))
      fi
    else
        if [ "$err_count" -eq 0 ]; then
          status_msg="${gl_hui}无公钥${gl_bai}"
        fi
    fi
    
    if [ $err_count -gt 1 ]; then
        status_msg="${gl_hong}多项权限错误${gl_bai}"
    fi

    printf "%-12s %-16s %-16s %-16s %b\n" "$u" "$home_stat" "$ssh_stat" "$key_stat" "$status_msg"
  done
  echo -e "${gl_kjlan}-------------------------------------------------------------------------${gl_bai}"
  echo "提示: SSH StrictModes 要求 Home 目录不能被其他用户写入，.ssh 必须是 700，authorized_keys 必须是 600/644。"
  echo "一键修复参考 (以 root 为例): chown -R root:root /root/.ssh && chmod 700 /root/.ssh && chmod 600 /root/.ssh/authorized_keys"
}

system_view_ssh_connections() {
  echo -e "${gl_kjlan}当前 SSH 连接会话${gl_bai}"
  echo -e "${gl_kjlan}------------------------------------------------------------${gl_bai}"
  echo "当前登录用户 (who):"
  who
  echo -e "${gl_kjlan}------------------------------------------------------------${gl_bai}"
  echo "SSH 网络连接状态:"
  if has_cmd ss; then
    ss -tnpa 2>/dev/null | awk '
      BEGIN {printf "%-25s %-25s %s\n", "LOCAL_ADDRESS", "REMOTE_ADDRESS", "PROCESS"}
      /sshd/ && /ESTAB/ {
        proc = "-"
        for(i=6;i<=NF;i++) {
            if($i ~ /^users:/) {
                proc=$i
                sub(/^users:\(\("/, "", proc)
                sub(/".*/, "", proc)
                break
            }
        }
        printf "%-25s %-25s %s\n", $4, $5, proc
      }'
  else
    echo "未安装 ss 命令"
  fi
}

ssh_get_current_port() {
  local port=""
  if has_cmd sshd; then
    port="$(sshd -T 2>/dev/null | awk '$1 == "port" {print $2; exit}')"
  fi
  if [ -z "$port" ] && [ -f /etc/ssh/sshd_config ]; then
    port="$(grep -iE '^[[:space:]]*Port[[:space:]]+[0-9]+' /etc/ssh/sshd_config | head -n1 | awk '{print $2}')"
  fi
  echo "${port:-22}"
}

ssh_allow_port_firewall() {
  local port="$1"
  valid_port "$port" || return 1
  if has_cmd ufw && LC_ALL=C ufw status 2>/dev/null | grep -q '^Status: active'; then
    ufw allow "${port}/tcp" || return 1
  elif has_cmd firewall-cmd && firewall-cmd --state >/dev/null 2>&1; then
    firewall-cmd --permanent --add-port="${port}/tcp" && firewall-cmd --reload || return 1
  elif has_cmd iptables; then
    iptables -C INPUT -p tcp --dport "$port" -j ACCEPT 2>/dev/null || iptables -I INPUT -p tcp --dport "$port" -j ACCEPT || return 1
    if has_cmd ip6tables; then
      ip6tables -C INPUT -p tcp --dport "$port" -j ACCEPT 2>/dev/null || ip6tables -I INPUT -p tcp --dport "$port" -j ACCEPT || return 1
    fi
  else
    echo "无法自动确认防火墙放行，未修改 SSH。" >&2
    return 1
  fi
  log_action "firewall SSH port allowance acknowledged $port/tcp"
}

ssh_update_fail2ban_port() {
  run_recovery_operation fail2ban-port "$1" "$2"
}

system_change_ssh_port() {
  need_root || return 1
  has_cmd ss || { echo "缺少 ss，无法核验监听端口，未修改 SSH。" >&2; return 1; }
  local cur_port new_port backup
  cur_port="$(ssh_get_current_port)"
  
  echo -e "当前 SSH 监听端口为: ${gl_lv}${cur_port}${gl_bai}"
  echo -e "${gl_huang}警告: 修改端口后系统会自动在防火墙放行新端口，但请务必确认主机的云服务商安全组规则中已放行！${gl_bai}"
  echo ""
  read -r -e -p "请输入新的 SSH 端口 (1-65535，直接回车取消): " new_port
  
  if [ -z "$new_port" ]; then
    echo "操作已取消。"
    return 0
  fi

  if ! printf '%s\n' "$new_port" | grep -Eq '^[0-9]+$' || [ "$new_port" -lt 1 ] || [ "$new_port" -gt 65535 ]; then
    echo -e "${gl_hong}端口必须为 1 到 65535 之间的数字！${gl_bai}"
    return 1
  fi

  if [ "$new_port" -eq "$cur_port" ]; then
    echo "输入端口与当前端口相同，无需修改。"
    return 0
  fi
  if is_port_taken "$new_port"; then
    echo "目标端口已占用，未修改 SSH。" >&2
    return 1
  fi

  if [ "$new_port" -eq 80 ] || [ "$new_port" -eq 443 ] || [ "$new_port" -eq 3306 ] || [ "$new_port" -eq 6379 ]; then
    echo -e "${gl_huang}提醒: 端口 ${new_port} 常用于 Web/数据库服务，是否确定要设置为 SSH 端口？${gl_bai}"
    if ! confirm_danger "修改 SSH 端口为 $new_port" "Port $new_port"; then
      return 0
    fi
  fi

  backup="/etc/ssh/sshd_config.ua-box.$(date +%Y%m%d-%H%M%S).bak"
  cp /etc/ssh/sshd_config "$backup" || return 1
  prune_old_backups "/etc/ssh" "sshd_config.ua-box.*.bak" "${UA_MAX_BACKUPS:-10}"

  echo "1. 正在通过防火墙放行新端口 ${new_port}/tcp..."
  ssh_allow_port_firewall "$new_port" || { echo "防火墙放行失败，未修改 SSH 配置。" >&2; return 1; }

  echo "2. 正在修改 /etc/ssh/sshd_config..."
  if ! ssh_set_global_option /etc/ssh/sshd_config Port "$new_port"; then
    cp "$backup" /etc/ssh/sshd_config
    echo -e "${gl_hong}写入 SSH 配置失败，已自动回滚。${gl_bai}"
    return 1
  fi

  echo "3. 正在校验 SSH 语法..."
  if ! sshd -t; then
    cp "$backup" /etc/ssh/sshd_config
    echo -e "${gl_hong}SSH 配置语法测试失败，已自动回滚备份！${gl_bai}"
    return 1
  fi

  echo "4. 正在重启 SSH 服务..."
  if ! ssh_restart_service; then
    cp "$backup" /etc/ssh/sshd_config
    ssh_restart_service >/dev/null 2>&1 || true
    echo -e "${gl_hong}SSH 服务重启失败，已自动回滚备份！${gl_bai}"
    return 1
  fi

  if ! ss -H -ltn "sport = :$new_port" 2>/dev/null | grep -q .; then
    cp "$backup" /etc/ssh/sshd_config
    ssh_restart_service >/dev/null 2>&1 || { echo "SSH 恢复服务失败，请保留当前会话并手动检查。" >&2; return 1; }
    echo "新端口未监听，已恢复原配置；请核对实际连接。" >&2
    return 1
  fi

  # 5. 若已配置 Fail2ban jail.local，自动同步更新监控端口
  if [ -f /etc/fail2ban/jail.local ] && grep -q '^\[sshd\]' /etc/fail2ban/jail.local 2>/dev/null; then
    local f2b_port_val="ssh"
    [ "$new_port" != "22" ] && f2b_port_val="ssh,${new_port}"
    if ! ssh_update_fail2ban_port /etc/fail2ban/jail.local "$f2b_port_val"; then
      echo "SSH 端口已修改，但 Fail2ban 配置更新失败，请手动核对。" >&2
      return 1
    fi
    if systemctl is-active --quiet fail2ban 2>/dev/null; then
      systemctl reload fail2ban >/dev/null 2>&1 || systemctl restart fail2ban >/dev/null 2>&1 || {
        echo "SSH 端口已修改，但 Fail2ban 服务重载失败，请手动核对。" >&2; return 1;
      }
      echo "5. 已同步更新 Fail2ban 防暴破监控端口 (${f2b_port_val})。"
    fi
  fi

  log_action "change ssh port from ${cur_port} to ${new_port}"
  echo -e "\n${gl_lv}🎉 SSH 端口成功修改为: ${new_port}${gl_bai}"
  echo -e "${gl_huang}特别提醒: 请务必保留当前终端，并打开一个新终端测试新端口连接：${gl_bai}"
  echo "  ssh root@<你的服务器IP> -p $new_port"
}

system_import_ssh_key() {
  need_root || return 1
  local target_user key_source key_content github_user home_dir ssh_dir auth_keys_file
  
  read -r -e -p "请输入要配置公钥的目标用户名 (直接回车默认为 root): " target_user
  target_user="${target_user:-root}"

  if ! getent passwd "$target_user" >/dev/null 2>&1; then
    echo -e "${gl_hong}系统不存在用户: ${target_user}${gl_bai}"
    return 1
  fi

  home_dir="$(getent passwd "$target_user" | cut -d: -f6)"
  ssh_dir="$home_dir/.ssh"
  auth_keys_file="$ssh_dir/authorized_keys"

  echo -e "\n请选择公钥获取来源:"
  echo "1. 手动粘贴公钥字符串 (以 ssh-rsa / ssh-ed25519 等开头)"
  echo "2. 从 GitHub 抓取公钥 (https://github.com/username.keys)"
  read -r -e -p "请输入你的选择 (1/2): " key_source

  case "$key_source" in
    1)
      read -r -e -p "请粘贴你的 SSH 公钥: " key_content
      if [ -z "$key_content" ]; then
        echo "公钥为空，操作取消。"
        return 1
      fi
      ;;
    2)
      read -r -e -p "请输入你的 GitHub 用户名: " github_user
      if [ -z "$github_user" ]; then
        echo "用户名为空，操作取消。"
        return 1
      fi
      echo "正在从 GitHub 抓取 https://github.com/${github_user}.keys..."
      key_content="$(curl -fsSL "https://github.com/${github_user}.keys" 2>/dev/null)"
      if [ -z "$key_content" ]; then
        echo -e "${gl_hong}未能从 GitHub 获取到有效公钥，请检查用户名是否正确或公钥是否存在。${gl_bai}"
        return 1
      fi
      echo -e "${gl_lv}成功抓取到 GitHub 公钥！${gl_bai}"
      ;;
    *)
      echo "无效选择。"
      return 1
      ;;
  esac

  mkdir -p "$ssh_dir"
  touch "$auth_keys_file"

  local added_count=0
  local line
  while IFS= read -r line; do
    line="$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    [ -z "$line" ] && continue
    if [[ "$line" =~ ^(ssh-rsa|ssh-dss|ecdsa-sha2-nistp[0-9]+|ssh-ed25519|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp[0-9]+@openssh\.com) ]]; then
      if ! grep -Fqx "$line" "$auth_keys_file" 2>/dev/null; then
        echo "$line" >> "$auth_keys_file"
        added_count=$((added_count + 1))
      fi
    fi
  done <<< "$key_content"

  local user_group
  user_group="$(id -gn "$target_user" 2>/dev/null || echo "$target_user")"
  chown -R "$target_user:$user_group" "$ssh_dir"
  chmod 700 "$ssh_dir"
  chmod 600 "$auth_keys_file"

  if [ "$added_count" -gt 0 ]; then
    log_action "import ssh key for user $target_user (added $added_count keys)"
