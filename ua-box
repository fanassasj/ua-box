# ── 一键初始化优化 ──────────────────────────────────────────
# 初始化仅创建新的 Swap；已有活动 Swap 或同名文件不会被关闭、删除或覆盖。
system_init_swap() {
  local target_mb="$1" active_kb
  active_kb="$(awk 'NR > 1 {total += $3} END {printf "%.0f", total}' /proc/swaps)" || return 1
  if [ "$active_kb" -gt 0 ]; then
    echo "已有 Swap $(( (active_kb + 1023) / 1024 ))MB，保留现有配置（建议 ${target_mb}MB）。"
    return 0
  fi
  if [ "$target_mb" -eq 0 ]; then
    echo "磁盘空间不足，无法创建 Swap 并保留 2GB 空余空间。" >&2
    return 1
  fi
  if [ -e /swapfile ] || [ -L /swapfile ]; then
    echo "/swapfile 已存在但未启用；为保护原文件，请先手动检查。" >&2
    return 1
  fi
  (
    umask 077
    # 排他创建，防止检查后出现同名文件时覆盖它。
    set -o noclobber
    : > /swapfile || exit 1
    if has_cmd fallocate; then
      fallocate -l "${target_mb}M" /swapfile 2>/dev/null ||
        dd if=/dev/zero of=/swapfile bs=1M count="$target_mb" status=none || exit 1
    else
      dd if=/dev/zero of=/swapfile bs=1M count="$target_mb" status=none || exit 1
    fi
    chmod 600 /swapfile && mkswap /swapfile >/dev/null && swapon /swapfile || exit 1
    awk '$1 == "/swapfile" {found=1} END {exit !found}' /proc/swaps || exit 1
    if ! grep -Eq '^/swapfile[[:space:]]+[^[:space:]]+[[:space:]]+swap([[:space:]]|$)' /etc/fstab; then
      printf '%s\n' '/swapfile swap swap defaults 0 0' >> /etc/fstab || exit 1
    fi
  ) || {
    echo "Swap 创建或验证失败；保留现有文件和已启用的 Swap，请手动检查。" >&2
    return 1
  }
  echo "Swap 已设置为 ${target_mb}MB。"
}

