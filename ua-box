system_update() {
  need_root || return 1
  log_action "system update"

  local pm
  pm="$(pkg_manager)"
  echo -e "${gl_huang}正在系统更新...${gl_bai}"

  case "$pm" in
    apt)
      dpkg --configure -a 2>/dev/null || true
      apt update -y
      DEBIAN_FRONTEND=noninteractive apt full-upgrade -y
      ;;
    dnf) dnf -y update ;;
    yum) yum -y update ;;
    apk) apk update && apk upgrade ;;
    pacman) pacman -Syu --noconfirm ;;
    zypper) zypper refresh && zypper update -y ;;
    opkg) opkg update && opkg upgrade ;;
    *) echo "未知包管理器，无法系统更新。"; return 1 ;;
  esac
}

system_clean() {
  need_root || return 1
  log_action "system clean"

  local pm orphans
  pm="$(pkg_manager)"
  echo -e "${gl_huang}正在系统清理...${gl_bai}"

  case "$pm" in
    apt)
      apt autoremove --purge -y
      apt clean -y
      apt autoclean -y
      ;;
    dnf)
      dnf autoremove -y
      dnf clean all
      ;;
    yum)
      yum autoremove -y
      yum clean all
      ;;
    apk)
      apk cache clean
      ;;
    pacman)
      orphans="$(pacman -Qdtq 2>/dev/null || true)"
      if [ -n "$orphans" ]; then
        # shellcheck disable=SC2086
        pacman -Rns $orphans --noconfirm 2>/dev/null || true
      fi
      pacman -Scc --noconfirm
      ;;
    zypper)
      zypper clean --all
      ;;
    opkg)
      opkg clean
      ;;
    *) echo "未知包管理器，跳过包缓存清理。" ;;
  esac

  if has_cmd journalctl; then
    journalctl --rotate 2>/dev/null || true
    journalctl --vacuum-size=500M 2>/dev/null || true
  fi

  # 自动清理各模块超额历史备份文件
  prune_old_backups "$UA_BOX_BACKUP_DIR" "ua-box-*.bak" "${UA_MAX_BACKUPS:-10}"
  prune_old_backups "/etc/ssh" "sshd_config.ua-box.*.bak" "${UA_MAX_BACKUPS:-10}"
  prune_old_backups "/etc/caddy" "Caddyfile.ua-box.*.bak" "${UA_MAX_BACKUPS:-10}"
  prune_old_backups "/root/caddy" "Caddyfile.ua-box.*.bak" "${UA_MAX_BACKUPS:-10}"
  prune_old_backups "/etc/docker" "daemon.json.ua-box*" "${UA_MAX_BACKUPS:-10}"
}

