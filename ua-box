docker_container_port_access() {
  local mode="$1" proto port source_ip family tool check_rc failed=0
  local families=(4 6) rule=()
  need_root || return 1
  case "$mode" in open|close) ;; *) return 1 ;; esac
  has_cmd python3 || { echo "需要 python3 校验 IP/CIDR。" >&2; return 1; }
  echo "管理 DOCKER-USER 防火墙规则，输入的是容器端口，不改变端口映射。"
  echo "规则仅作用于当前防火墙状态；防火墙或主机重启后需重新核对。"
  read -r -e -p "请输入容器端口: " port || return 1
  read -r -e -p "请输入协议，回车默认 tcp: " proto || return 1
  read -r -e -p "限制来源 IP/CIDR，回车同时处理 IPv4/IPv6: " source_ip || return 1
  proto="${proto:-tcp}"
  valid_port "$port" && [[ "$proto" = tcp || "$proto" = udp ]] || { echo "端口或协议无效。" >&2; return 1; }
  if [ -n "$source_ip" ]; then
    family="$(python3 -c 'import ipaddress,sys; print(ipaddress.ip_network(sys.argv[1], strict=False).version)' "$source_ip" 2>/dev/null)" || { echo "来源 IP/CIDR 无效。" >&2; return 1; }
    families=("$family")
    rule=(-s "$source_ip")
  fi
  rule+=(-p "$proto" --dport "$port" -j DROP)
  # 预检所有地址族；缺失时不能声称端口已经完全关闭。
  for family in "${families[@]}"; do
    tool=iptables; [ "$family" = 6 ] && tool=ip6tables
    if ! has_cmd "$tool" || ! "$tool" -w -S DOCKER-USER >/dev/null 2>&1; then
      echo "IPv$family 缺少可用的 DOCKER-USER 链，未执行操作。" >&2
      return 1
    fi
  done
  for family in "${families[@]}"; do
    tool=iptables; [ "$family" = 6 ] && tool=ip6tables
    if [ "$mode" = close ]; then
      check_rc=0
      "$tool" -w -C DOCKER-USER "${rule[@]}" 2>/dev/null || check_rc=$?
      if [ "$check_rc" -eq 1 ]; then
        "$tool" -w -I DOCKER-USER 1 "${rule[@]}" || failed=1
      elif [ "$check_rc" -ne 0 ]; then
        failed=1
      fi
      "$tool" -w -C DOCKER-USER "${rule[@]}" 2>/dev/null || failed=1
    else
      while true; do
        check_rc=0
        "$tool" -w -C DOCKER-USER "${rule[@]}" 2>/dev/null || check_rc=$?
        [ "$check_rc" -eq 1 ] && break
        [ "$check_rc" -eq 0 ] || { failed=1; break; }
        "$tool" -w -D DOCKER-USER "${rule[@]}" || { failed=1; break; }
      done
    fi
    if [ "$failed" -eq 0 ]; then
      echo "IPv$family: 已核对 $mode 规则 ($proto/$port)。"
    else
      echo "IPv$family: 规则处理失败，可能存在部分变更，请核对。" >&2
    fi
  done
  [ "$failed" -eq 0 ] || return 1
  log_action "verified Docker firewall rule $mode $proto/$port ${source_ip:-IPv4+IPv6}"
  echo "仅核验了上述 DROP 规则；最终连通性仍取决于其他网络规则。"
}

valid_port() {
  [[ "$1" =~ ^[0-9]{1,5}$ ]] && ((10#$1 >= 1 && 10#$1 <= 65535))
