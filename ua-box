docker_container_all_action() {
  local action="$1" inventory id name state labels
  local ids=() names=()
  case "$action" in start|stop|restart|rm) ;; *) return 1 ;; esac
  inventory="$(docker ps -a --no-trunc --format '{{.ID}}\t{{.Names}}\t{{.State}}\t{{.Label "ua.recovery.operation"}}')" || return 1
  while IFS=$'\t' read -r id name state labels; do
    [ -n "$id" ] || continue
    case "$name" in *-ua-old-*|*-ua-failed-*) echo "跳过隔离保留容器: $name" >&2; continue ;; esac
    # 自动恢复管理的停止实例必须通过恢复流程核对后启动。
    [ "$action" = start ] && [ "$state" != running ] && [ -n "$labels" ] && continue
    case "$action" in
      start) [ "$state" = running ] && continue ;;
      stop|restart) [ "$state" != running ] && continue ;;
    esac
    ids+=("$id"); names+=("$name")
  done <<< "$inventory"
  [ "${#ids[@]}" -gt 0 ] || { echo "没有可操作的容器。"; return 0; }
  printf '将执行 %s，目标容器:\n' "$action"
  printf '  %s\n' "${names[@]}"
  confirm_danger "批量 Docker $action" "${names[*]}" || return 1
  log_action "docker $action selected containers: ${names[*]}"
  case "$action" in
    rm) docker rm -f "${ids[@]}" ;;
    *) docker "$action" "${ids[@]}" ;;
  esac
}

