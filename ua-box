system_reinstall_menu() {
  need_root || return 1

  echo -e "${gl_hong}一键重装系统会清空当前系统环境，请先备份数据。${gl_bai}"
  echo "脚本来源: $REINSTALL_SCRIPT"
  echo -e "${gl_kjlan}------------------------${gl_bai}"
  echo "1. Debian 13 (新 - Trixie)"
  echo "2. Debian 12 (稳定版)"
  echo "3. Ubuntu 24.04 LTS (新)"
  echo "4. Ubuntu 22.04 LTS"
  echo "5. Alpine Linux (轻量极速)"
  echo "6. 自定义 reinstall.sh 参数"
  echo "0. 取消"
  echo -e "${gl_kjlan}------------------------${gl_bai}"
  local choice
  read -r -e -p "请输入你的选择: " choice

  local args=()
  local pwd_input=""
  local port_input=""
  local key_input=""
  local username_input=""
  case "$choice" in
    1) args=(debian 13) ;;
    2) args=(debian 12) ;;
    3) args=(ubuntu 24.04) ;;
    4) args=(ubuntu 22.04) ;;
    5) args=(alpine) ;;
    6)
      local custom_args=""
      read -r -e -p "请输入 reinstall.sh 完整参数 (如: debian 12 --password mypass): " custom_args
      if [ -z "$custom_args" ]; then
        echo "未输入参数，已取消。"
        return 1
      fi
      # shellcheck disable=SC2206
      args=($custom_args)
      ;;
    0) return 0 ;;
    *) echo "无效输入"; return 1 ;;
  esac

  # 如果不是自定义完整参数，则提供便捷引导配置用户名/公钥/密码与端口
  if [ "$choice" -ge 1 ] && [ "$choice" -le 5 ]; then
    echo -e "\n${gl_huang}[可选便捷配置]${gl_bai}"

    # 1. 引导设置登录用户名
    read -r -e -p "请输入新系统的登录用户名 (直接回车默认为 root / administrator): " username_input
    if [ -n "$username_input" ]; then
      if printf '%s\n' "$username_input" | grep -Eq '^[a-z_][a-z0-9_-]*$'; then
        args+=(--username "$username_input")
      else
        echo -e "${gl_huang}用户名格式不合法（仅允许小写字母、数字、下划线、连字符，且不能以数字或连字符开头），已忽略。${gl_bai}"
      fi
    fi
    
    # 2. 优先引导密钥对登录，提高安全性并做格式校验
    while true; do
      read -r -e -p "请输入新系统的 SSH 公钥 (如 ssh-rsa...，直接回车则使用密码登录): " key_input
      if [ -z "$key_input" ]; then
        break
      fi
      # 校验公钥格式
      if grep -Eq '^(ssh-rsa|ssh-dss|ecdsa-sha2-nistp[0-9]+|ssh-ed25519|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp[0-9]+@openssh\.com)[[:space:]]+[A-Za-z0-9+/=]+([[:space:]]+.+)?$' <<< "$key_input"; then
        args+=(--ssh-key "$key_input")
        break
      else
        echo -e "${gl_hong}公钥格式不正确，请重新输入（应以 ssh-rsa / ssh-ed25519 等开头，后接 Base64 编码）。${gl_bai}"
      fi
    done

    # 3. 如果配置了公钥，则默认不强制配置密码（跳过密码输入）；如果未配置公钥，则引导设置 Root 密码
    if [ -z "$key_input" ]; then
      read -r -e -s -p "请输入新系统的 Root 密码 (直接回车表示使用脚本默认/随机生成): " pwd_input
      echo ""
      if [ -n "$pwd_input" ]; then
        args+=(--password "$pwd_input")
      fi
    else
      echo -e "${gl_lv}已检测到有效公钥，系统将默认采用密钥认证登录（跳过设置密码）。${gl_bai}"
    fi
    
    # 4. 引导配置 SSH 端口
    read -r -e -p "请输入新系统的 SSH 端口 (直接回车默认为 22): " port_input
    if [ -n "$port_input" ] && printf '%s\n' "$port_input" | grep -Eq '^[0-9]+$'; then
      if [ "$port_input" -ge 1 ] && [ "$port_input" -le 65535 ]; then
        args+=(--ssh-port "$port_input")
      else
        echo -e "${gl_huang}端口范围应为 1-65535，已忽略该配置。${gl_bai}"
      fi
    fi
  fi

  # 安全脱敏，避免在二次确认中明文打印密码和公钥
  local display_args="${args[*]}"
  if [ -n "$pwd_input" ]; then
    display_args="${display_args/$pwd_input/********}"
  fi
  if [ -n "$key_input" ]; then
    display_args="${display_args/$key_input/[SSH-KEY]}"
  fi

  if confirm_danger "即将重装系统，当前系统所有数据将彻底丢失" "reinstall.sh $display_args"; then
    download_to "$REINSTALL_SCRIPT" "$UA_BOX_TMP_DIR"/reinstall.sh || return 1
    chmod +x "$UA_BOX_TMP_DIR"/reinstall.sh
    log_action "reinstall system $display_args"
    bash "$UA_BOX_TMP_DIR"/reinstall.sh "${args[@]}"
  fi
}

system_port_status() {
  echo -e "${gl_kjlan}端口占用状态${gl_bai}"
  echo -e "${gl_kjlan}------------------------${gl_bai}"
  if has_cmd ss; then
    ss -tulpen | awk '
      NR==1 { printf "%-10s %-25s %-30s\n", "PROTO", "LOCAL ADDRESS:PORT", "PROCESS (PID)"; next }
      {
        proto = toupper($1)
        local_addr = $5
        proc = "-"
        for (i=6; i<=NF; i++) {
          if ($i ~ /^users:/) {
            raw = $i
            sub(/^users:\(\("/, "", raw)
            sub(/"?,pid=/, " (PID: ", raw)
            sub(/,.*/, ")", raw)
            proc = raw
            break
          }
        }
        if (local_addr ~ /:[0-9]+$/) {
            printf "%-10s %-25s %-30s\n", proto, local_addr, proc
        }
      }' | sort -k2
  elif has_cmd netstat; then
    netstat -tulpen 2>/dev/null | awk '
      BEGIN { printf "%-10s %-25s %-30s\n", "PROTO", "LOCAL ADDRESS:PORT", "PROCESS (PID)" }
      NR>2 {
        proto = toupper($1)
        local_addr = $4
        proc = $NF
        if (proc ~ /^[0-9]+\//) {
          split(proc, p, "/")
          proc = p[2] " (PID: " p[1] ")"
        } else {
          proc = "-"
        }
        if (proto ~ /^(TCP|UDP)/) {
            printf "%-10s %-25s %-30s\n", proto, local_addr, proc
        }
      }' | sort -k2
  else
    echo "未找到 ss/netstat，可先安装 iproute2 或 net-tools。"
    return 1
  fi
}

system_open_all_ports() {
