caddy_delete_reverse_proxy() {
  need_root || return 1

  local cfg_file
  if docker_container_exists caddy; then
    cfg_file="/root/caddy/Caddyfile"
  else
    cfg_file="/etc/caddy/Caddyfile"
  fi

  if [ ! -f "$cfg_file" ]; then
    echo "未找到 Caddy 配置文件: $cfg_file"
    return 1
  fi

  local domains
  domains="$(grep -E "^[[:space:]]*[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}[[:space:]]*\{" "$cfg_file" | awk '{print $1}' | tr -d '{')"

  if [ -z "$domains" ]; then
    echo "当前 Caddyfile 中未检测到任何已配置的反代域名。"
    return 0
  fi

  echo -e "${gl_kjlan}当前已配置的 Caddy 反代站点列表：${gl_bai}"
  local count=0
  local domain_array=()
  while IFS= read -r d; do
    [ -z "$d" ] && continue
    count=$((count + 1))
    domain_array+=("$d")
    local upstream_target
    upstream_target="$(caddy_get_domain_upstream "$cfg_file" "$d")"
    echo -e "  ${count}) ${gl_lv}${d}${gl_bai} -> ${gl_huang}${upstream_target:-未知}${gl_bai}"
  done <<< "$domains"

  echo -e "  0) 取消"
  read -r -e -p "请输入要删除的站点序号或指定域名: " del_input

  if [ -z "$del_input" ] || [ "$del_input" = "0" ]; then
    echo "已取消。"
    return 0
  fi

  local target_domain=""
  if printf '%s\n' "$del_input" | grep -Eq '^[0-9]+$'; then
    local idx=$((del_input - 1))
    if [ "$idx" -ge 0 ] && [ "$idx" -lt "${#domain_array[@]}" ]; then
      target_domain="${domain_array[$idx]}"
    else
      echo "无效序号。"
      return 1
    fi
  else
    target_domain="$del_input"
  fi

  if confirm_danger "删除 Caddy 反代站点规则 $target_domain" "$target_domain"; then
    local bak_file="${cfg_file}.ua-box.$(date +%Y%m%d-%H%M%S).bak"
    cp "$cfg_file" "$bak_file"
    prune_old_backups "$(dirname "$cfg_file")" "$(basename "$cfg_file").ua-box.*.bak" "${UA_MAX_BACKUPS:-10}"
    caddy_remove_domain_block "$cfg_file" "$target_domain"
    echo -e "${gl_lv}已成功删除反代站点 $target_domain 规则。${gl_bai}"

    if docker_container_exists caddy; then
      if docker_container_running caddy; then
        docker exec -w /etc/caddy caddy caddy fmt --overwrite Caddyfile 2>/dev/null || true
        if ! docker exec -w /etc/caddy caddy caddy validate --config /etc/caddy/Caddyfile >/dev/null 2>&1; then
          echo -e "${gl_hong}错误: 删除后 Caddyfile 语法校验失败，已自动回滚。${gl_bai}"
          cp "$bak_file" "$cfg_file"
          return 1
        fi
        docker exec -w /etc/caddy caddy caddy reload --config /etc/caddy/Caddyfile 2>/dev/null || docker restart caddy 2>/dev/null || true
      fi
    elif has_cmd caddy; then
      caddy fmt --overwrite /etc/caddy/Caddyfile 2>/dev/null || true
      if ! caddy validate --config /etc/caddy/Caddyfile; then
        echo -e "${gl_hong}错误: 删除后 Caddyfile 语法校验失败，已自动回滚。${gl_bai}"
        cp "$bak_file" "$cfg_file"
        return 1
      fi
      svc reload caddy 2>/dev/null || svc restart caddy 2>/dev/null || true
    fi
    echo "已重载 Caddy 配置生效。"
  fi
}

caddy_uninstall() {
  need_root || return 1

  if ! docker_container_exists caddy && ! has_cmd caddy; then
    echo "系统未检测到 Caddy 容器或原生服务。"
    return 0
  fi

  if confirm_danger "删除 Caddy 容器/服务及相关配置" "caddy"; then
    if docker_container_exists caddy; then
      docker rm -f caddy 2>/dev/null || true
      echo "已删除 Caddy Docker 容器。"
    fi
    if has_cmd caddy; then
      systemctl stop caddy 2>/dev/null || true
      systemctl disable caddy 2>/dev/null || true
      apt remove -y caddy 2>/dev/null || yum remove -y caddy 2>/dev/null || true
      echo "已卸载 Caddy 原生服务。"
    fi
    read -r -e -p "是否同时删除 /root/caddy 配置与证书目录？[y/N]: " del_cfg
    if [[ "$del_cfg" =~ ^[Yy]$ ]]; then
      rm -rf /root/caddy /root/caddy_data /root/caddy_config /etc/caddy
      echo "配置数据已清理。"
    fi
    echo "Caddy 已成功卸载删除。"
  fi
}

