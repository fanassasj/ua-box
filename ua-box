ua_recovery_program() {
  cat <<'PY_UA_RECOVERY'
"""Linux recovery operations. No mutation occurs on import; journals contain secrets."""
import contextlib
import copy
import ctypes
import errno
import fcntl
import fnmatch
import hashlib
import http.client
import io
import json
import os
from pathlib import Path, PurePosixPath
import re
import shlex
import shutil
import signal
import socket
import sqlite3
import stat
import struct
import subprocess
import sys
import tarfile
import tempfile
import time
import uuid
from urllib.parse import quote


class RecoveryError(RuntimeError):
    pass


class Interrupted(KeyboardInterrupt):
    pass


def fault(point):
    """Test seam, deliberately not controlled by environment or user configuration."""


@contextlib.contextmanager
def signals(handling=True):
    previous = {}
    def cancelled(signum, frame):
        raise Interrupted("signal " + str(signum))
    try:
        for sig in (signal.SIGINT, signal.SIGTERM):
            previous[sig] = signal.signal(sig, cancelled if handling else signal.SIG_IGN)
        yield
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)


def sync_dir(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def save_json(path, data):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor, temporary = tempfile.mkstemp(prefix=".journal-", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w") as out:
            json.dump(data, out, ensure_ascii=False, sort_keys=True, indent=2)
            out.flush()
            os.fsync(out.fileno())
        os.replace(temporary, path)
        sync_dir(path.parent)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


@contextlib.contextmanager
def locked(paths):
    with contextlib.ExitStack() as stack:
        for path in sorted(set(map(str, paths))):
            fd = os.open(path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
            stream = stack.enter_context(os.fdopen(fd, "a"))
            fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
        yield


def digest(path):
    hasher = hashlib.sha256()
    with Path(path).open("rb") as source:
        for data in iter(lambda: source.read(1024 * 1024), b""):
            hasher.update(data)
    return hasher.hexdigest()


def metadata(path):
    info = path.lstat()
    if stat.S_ISLNK(info.st_mode) or not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)):
        raise RecoveryError("不支持链接或特殊文件: " + str(path))
    record = {"type": "dir" if path.is_dir() else "file", "mode": stat.S_IMODE(info.st_mode),
              "uid": info.st_uid, "gid": info.st_gid}
    if record["type"] == "file":
        record.update(size=info.st_size, sha256=digest(path))
    return record


def inventory(path):
    path = Path(path)
    result = {".": metadata(path)}
    if path.is_dir():
        for base, dirs, files in os.walk(path, followlinks=False):
            for name in sorted(dirs + files):
                child = Path(base) / name
                result[child.relative_to(path).as_posix()] = metadata(child)
    return result


def identity(path):
    try:
        info = Path(path).lstat()
        return [info.st_dev, info.st_ino]
    except FileNotFoundError:
        return None


def check_path(path):
    path = Path(path)
    if not path.is_absolute() or ".." in path.parts:
        raise RecoveryError("目标必须是规范绝对路径: " + str(path))
    for item in (path, *path.parents):
        if item.is_symlink():
            raise RecoveryError("目标或父目录是符号链接: " + str(item))
    if path.exists():
        metadata(path)
    return path


def require_space(parent, size):
    if shutil.disk_usage(parent).free < size + max(1024 * 1024, size // 20):
        raise RecoveryError("可用磁盘空间不足: " + str(parent))


def copy_verified(source, target):
    before = inventory(source)
    require_space(target.parent, sum(r.get("size", 0) for r in before.values()))
    def copy_file(source_file, target_file):
        result = shutil.copy2(source_file, target_file)
        fault("after_copy_file")
        return result
    if Path(source).is_dir():
        shutil.copytree(source, target, copy_function=copy_file)
    else:
        copy_file(source, target)
    # copy2 does not preserve ownership. Preserve it explicitly, including directories.
    if os.geteuid() == 0:
        for rel, record in before.items():
            os.chown(target if rel == "." else target / rel, record["uid"], record["gid"])
    if inventory(source) != before or inventory(target) != before:
        raise RecoveryError("复制不完整或源文件在复制期间发生变化: " + str(source))
    for rel, record in before.items():
        item = target if rel == "." else target / rel
        if record["type"] == "file":
            with item.open("rb") as stream:
                os.fsync(stream.fileno())
    for base, dirs, files in os.walk(target) if target.is_dir() else []:
        sync_dir(base)
    sync_dir(target.parent)
    fault("copy_complete")
    return before


def exchange(left, right):
    """Atomic exchange on Linux; never fall back to copying over the old directory."""
    libc = ctypes.CDLL(None, use_errno=True)
    function = getattr(libc, "renameat2", None)
    if function is None:
        raise RecoveryError("系统缺少 renameat2；拒绝使用非原子目录覆盖。")
    if function(-100, os.fsencode(left), -100, os.fsencode(right), 2) != 0:
        code = ctypes.get_errno()
        raise OSError(code, os.strerror(code), str(left))
    sync_dir(Path(left).parent)
    sync_dir(Path(right).parent)


CONFIG_NAMES = set("""DEFAULT_WORKSPACE_PREFIX DEFAULT_RCLONE_MOUNT_ARGS UA_BOX_UPDATE_URL
