  echo "将重启 Docker，可能中断现有服务；已创建容器的日志设置不会因此改变。"
  confirm_danger "修改 Docker 日志配置并重启 Docker" "/etc/docker/daemon.json" || return 1
  run_recovery_operation daemon-config /etc/docker/daemon.json '{"log-driver":"json-file","log-opts":{"max-size":"50m","max-file":"3"}}'
}

docker_setup_ipv6() {
  need_root || return 1
  echo "配置 Docker IPv6；实际可达性仍取决于宿主机网络和防火墙。"
  confirm_danger "修改 IPv6 配置并重启 Docker，可能中断现有服务" "/etc/docker/daemon.json" || return 1
  run_recovery_operation daemon-config /etc/docker/daemon.json '{"ipv6":true,"fixed-cidr-v6":"fd00:172:17::/64","ip6tables":true}'
}

