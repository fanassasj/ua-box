net_total() {
  awk -F'[: ]+' '
    NR > 2 {
      iface = $1
      if (iface == "") iface = $2
      if (iface ~ /^(lo|docker|br-|veth|tun|tap|wg|warp|CloudflareWARP|tailscale|zt)/) next
      for (i = 1; i <= NF; i++) {
        if ($i == iface) {
          rx += $(i + 1)
          tx += $(i + 9)
          break
        }
      }
    }
    END {
      printf "%.2fG / %.2fG", rx/1024/1024/1024, tx/1024/1024/1024
    }
  ' /proc/net/dev 2>/dev/null
}

cpu_usage() {
  awk '/^cpu / {u=$2+$4; t=$2+$4+$5; print u, t}' /proc/stat | {
    read -r u1 t1
    sleep 0.2
    awk '/^cpu / {u=$2+$4; t=$2+$4+$5; print u, t}' /proc/stat | {
      read -r u2 t2
      awk -v u1="$u1" -v t1="$t1" -v u2="$u2" -v t2="$t2" 'BEGIN {
        if (t2 == t1) print "0";
        else printf "%.0f", (u2-u1)*100/(t2-t1)
      }'
    }
  }
}

