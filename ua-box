log_action() {
  local message="$*"
  mkdir -p "$UA_BOX_LOG_DIR" || return 1
  [ ! -L "$UA_BOX_LOG_FILE" ] && [ ! -L "${UA_BOX_LOG_FILE}.1" ] || return 1
  # 日志超过 5MB 自动轮转，保留最近一份
  if [ -f "$UA_BOX_LOG_FILE" ] && [ "$(wc -c < "$UA_BOX_LOG_FILE" 2>/dev/null || echo 0)" -gt 5242880 ]; then
    mv "$UA_BOX_LOG_FILE" "${UA_BOX_LOG_FILE}.1"
  fi
  (umask 077; printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')" "$message" >> "$UA_BOX_LOG_FILE") || return 1
  chmod 600 "$UA_BOX_LOG_FILE"
  [ ! -f "${UA_BOX_LOG_FILE}.1" ] || chmod 600 "${UA_BOX_LOG_FILE}.1"
}

confirm_danger() {
  local message="$1"
  local target="$2"

  echo -e "${gl_hong}危险操作:${gl_bai} $message"
  echo "影响范围: 可能修改系统配置、服务状态、数据或网络访问策略。"
  [ -n "$target" ] && echo "对象/命令: $target"
  read -r -p "请输入 yes/y 确认继续，输入 n 取消: " answer
  case "$answer" in
    yes|y|Y) return 0 ;;
    n|N|no|No|NO|"") echo "已取消。"; return 1 ;;
    *) echo "输入未确认，已取消。"; return 1 ;;
  esac
}

prune_old_backups() {
  local dir="$1"
  local pattern="$2"
  local keep="${3:-${UA_MAX_BACKUPS:-10}}"
  [ -d "$dir" ] || return 0
  printf '%s\n' "$keep" | grep -Eq '^[0-9]+$' || keep=10

  local files=()
  local f
  # shellcheck disable=SC2086
  while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$f" ] && files+=("$f")
  done < <(ls -1td "$dir"/$pattern 2>/dev/null)

  local count="${#files[@]}"
  if [ "$count" -gt "$keep" ]; then
    local i
    for ((i = keep; i < count; i++)); do
      rm -f "${files[$i]}" 2>/dev/null || true
    done
  fi
}

backup_self() {
  local src dst
  src="$(readlink -f "$0" 2>/dev/null || echo "$0")"
  mkdir -p "$UA_BOX_BACKUP_DIR" || return 1
  dst="$(mktemp "$UA_BOX_BACKUP_DIR/ua-box-$(date '+%Y%m%d-%H%M%S').XXXXXX.bak")" || return 1
  if ! cp "$src" "$dst" || ! cmp -s "$src" "$dst"; then
    rm -f -- "$dst"
    echo "脚本备份未完成，已停止后续操作。" >&2
    return 1
  fi
  prune_old_backups "$UA_BOX_BACKUP_DIR" "ua-box-*.bak" "${UA_MAX_BACKUPS:-10}"
  log_action "backup_self $dst" || true
  echo "已备份到: $dst"
}

select_with_fzf_or_menu() {
  local prompt_msg="$1"
  shift
  local input_items=("$@")
  
  if [ "${#input_items[@]}" -eq 0 ]; then
    return 1
  fi

  if has_cmd fzf && [ -t 0 ]; then
    printf '%s\n' "${input_items[@]}" | fzf --prompt="${prompt_msg}: " --height=40% --layout=reverse --border --ansi
    return $?
  fi

  local i item_count="${#input_items[@]}"
  echo -e "${gl_kjlan}${prompt_msg}${gl_bai}" >&2
  echo -e "${gl_kjlan}------------------------${gl_bai}" >&2
  for ((i=0; i<item_count; i++)); do
    echo -e "${gl_kjlan}$((i+1)). ${gl_bai}${input_items[$i]}" >&2
  done
  echo -e "${gl_kjlan}0. 取消${gl_bai}" >&2
  echo -e "${gl_kjlan}------------------------${gl_bai}" >&2

  local choice
  read -r -e -p "请输入序号选择 (0-$item_count): " choice
  if [ -z "$choice" ] || ! printf '%s\n' "$choice" | grep -Eq '^[0-9]+$' || [ "$choice" -eq 0 ] || [ "$choice" -gt "$item_count" ]; then
    return 1
  fi

  echo "${input_items[$((choice-1))]}"
}

install_shell_completion() {
  local completion_dir="/etc/bash_completion.d"
  local completion_script="${completion_dir}/ua"

  mkdir -p "$completion_dir" 2>/dev/null || true

  cat > "$completion_script" <<'EOF'
# UA Box Pure Bash Completion
_ua_completion() {
  local cur prev main_commands
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"

  main_commands="doctor ps info sys system ssh ssh-port ssh-key f2b fail2ban tools panel docker dk work rclone test status notify export import recover verify-backup ignore config log backup update init bbr fw fb ol top monitor fzf search find install remove settings"

  if [ "$COMP_CWORD" -eq 1 ]; then
    mapfile -t COMPREPLY < <(compgen -W "${main_commands}" -- "${cur}")
    return 0
  fi

  case "${prev}" in
    docker|dk)
      mapfile -t COMPREPLY < <(compgen -W "ps start stop restart logs rm inspect prune compose" -- "${cur}")
      return 0
      ;;
    rclone)
      local remotes=""
      if command -v rclone >/dev/null 2>&1; then
        remotes="$(rclone listremotes 2>/dev/null | tr -d ':\r' | tr '\n' ' ')"
      fi
      mapfile -t COMPREPLY < <(compgen -W "ls copy sync mount unmount ncdu config ${remotes}" -- "${cur}")
      return 0
      ;;
    ignore)
      mapfile -t COMPREPLY < <(compgen -W "current rclone container service reset" -- "${cur}")
      return 0
      ;;
    install|remove)
      mapfile -t COMPREPLY < <(compgen -W "curl wget sudo socat htop btop iftop unzip tar tmux vim nano git jq ncdu fzf lsof net-tools fail2ban ufw" -- "${cur}")
      return 0
      ;;
    logs|start|stop|restart|rm|inspect)
      if [ "${COMP_WORDS[1]}" = "docker" ] || [ "${COMP_WORDS[1]}" = "dk" ]; then
        local containers=""
        if command -v docker >/dev/null 2>&1; then
          containers="$(docker ps -a --format '{{.Names}}' 2>/dev/null | tr '\n' ' ')"
        fi
        mapfile -t COMPREPLY < <(compgen -W "${containers}" -- "${cur}")
        return 0
      fi
      ;;
  esac
}
complete -o default -F _ua_completion ua ua-box
EOF
  chmod 644 "$completion_script" 2>/dev/null || true

  local user_rc="${HOME:-/root}/.bashrc"
  if [ -f "$user_rc" ]; then
    if ! grep -Fq "$completion_script" "$user_rc" 2>/dev/null; then
      echo "[ -f $completion_script ] && . $completion_script" >> "$user_rc"
    fi
  fi

  echo "已自动配置命令行 Tab 自动补全: $completion_script"
}

create_local_links() {
  local srcTarget
  srcTarget="$(readlink -f "$0" 2>/dev/null || echo "$0")"
  local target="/usr/local/bin/ua"

  chmod +x "$srcTarget"
  ln -sf "$srcTarget" /usr/local/bin/ua-box

  if [ -e "$target" ] && [ ! -L "$target" ]; then
    echo "检测到 $target 已存在且不是符号链接。"
    echo "为避免覆盖已有命令，未自动设置 ua。"
    echo "确认要替换时，可先备份原文件，再执行：ln -sf $srcTarget $target"
  else
    ln -sf "$srcTarget" "$target"
    echo "已设置/修复全局命令: ua"
  fi
  echo "备用命令仍可使用: ua-box"
  install_shell_completion
}

system_live_monitor() {
  (
  trap 'tput cnorm 2>/dev/null || true' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  tput civis 2>/dev/null || true

  local num_cpus
  num_cpus="$(nproc 2>/dev/null || echo 1)"

  get_cpu_stat() {
    grep '^cpu ' /proc/stat 2>/dev/null | awk '{total=$2+$3+$4+$5+$6+$7+$8; printf "%.0f %.0f\n", total, $5}'
  }

  get_net_bytes() {
    awk -F':| +' '
      NR > 2 {
        if ($1 ~ /^(lo|docker|br-|veth)/ || $2 ~ /^(lo|docker|br-|veth)/) next;
        for (i=1; i<=NF; i++) {
          if ($i ~ /^[0-9]+$/) {
            rx += $i
            tx += $(i+8)
            break
          }
        }
      }
      END { printf "%.0f %.0f\n", rx, tx }
    ' /proc/net/dev 2>/dev/null
  }

  get_disk_bytes() {
    awk '
      $3 ~ /^(sd[a-z]|hd[a-z]|vd[a-z]|nvme[0-9]n[0-9]|xvd[a-z])$/ {
        r += $6 * 512
        w += $10 * 512
      }
      END { printf "%.0f %.0f\n", r, w }
    ' /proc/diskstats 2>/dev/null
  }

  format_bytes() {
    local bytes="${1:-0}"
    awk -v b="$bytes" '
      BEGIN {
        if (b >= 1099511627776) {
          printf "%.2f TB", b / 1099511627776
        } else if (b >= 1073741824) {
          printf "%.2f GB", b / 1073741824
        } else if (b >= 1048576) {
          printf "%.2f MB", b / 1048576
        } else if (b >= 1024) {
          printf "%.1f KB", b / 1024
        } else {
          printf "%.0f B", b
        }
      }
    '
  }

  calc_net_speed() {
    local prx="$1" ptx="$2" crx="$3" ctx="$4" sec="${5:-1.5}"
    awk -v prx="$prx" -v ptx="$ptx" -v crx="$crx" -v ctx="$ctx" -v sec="$sec" '
      BEGIN {
        drx = (crx - prx) / sec
        dtx = (ctx - ptx) / sec
        if (drx < 0) drx = 0
        if (dtx < 0) dtx = 0

        if (drx >= 1048576) {
          s_rx = sprintf("%.2f MB/s", drx / 1048576)
        } else {
          s_rx = sprintf("%.1f KB/s", drx / 1024)
        }

        if (dtx >= 1048576) {
          s_tx = sprintf("%.2f MB/s", dtx / 1048576)
        } else {
          s_tx = sprintf("%.1f KB/s", dtx / 1024)
        }

        print s_rx "|" s_tx
      }
    '
  }

  calc_disk_speed() {
    local pr="$1" pw="$2" cr="$3" cw="$4" sec="${5:-1.5}"
    awk -v pr="$pr" -v pw="$pw" -v cr="$cr" -v cw="$cw" -v sec="$sec" '
      BEGIN {
        dr = (cr - pr) / sec
        dw = (cw - pw) / sec
        if (dr < 0) dr = 0
        if (dw < 0) dw = 0

        if (dr >= 1048576) s_r = sprintf("%.2f MB/s", dr / 1048576)
        else s_r = sprintf("%.1f KB/s", dr / 1024)

        if (dw >= 1048576) s_w = sprintf("%.2f MB/s", dw / 1048576)
        else s_w = sprintf("%.1f KB/s", dw / 1024)

        print s_r "|" s_w
      }
    '
  }

  calc_cpu_usage() {
    local ptot="$1" pidle="$2" ctot="$3" cidle="$4"
    awk -v ptot="$ptot" -v pidle="$pidle" -v ctot="$ctot" -v cidle="$cidle" '
      BEGIN {
        dtot = ctot - ptot
        didle = cidle - pidle
        if (dtot <= 0) {
          print 0
        } else {
          u = 100 * (dtot - didle) / dtot
          if (u < 0) u = 0
          if (u > 100) u = 100
          printf "%.0f\n", u
        }
      }
    '
  }

  get_services_status() {
    local svcs=("sshd" "docker" "caddy" "nginx" "mysql" "redis")
    if [ -n "$UA_MONITOR_SERVICES" ]; then
      read -r -a svcs <<< "$UA_MONITOR_SERVICES"
    fi

    local res=""
    for svc in "${svcs[@]}"; do
      [ -z "$svc" ] && continue
      if systemctl is-active "$svc" >/dev/null 2>&1 || pgrep -x "$svc" >/dev/null 2>&1; then
        res+="${svc} [${gl_lv}● 正常${gl_bai}]  "
      elif systemctl list-unit-files "${svc}.service" 2>/dev/null | grep -q "${svc}.service" || has_cmd "$svc"; then
        res+="${svc} [${gl_hong}● 异常${gl_bai}]  "
      fi
    done
    echo -e "${res}"
  }

  local host_name sys_kernel sort_mode="cpu" view_mode="all"
  host_name="$(hostname 2>/dev/null || echo "$HOSTNAME")"
  sys_kernel="$(uname -r 2>/dev/null || echo "Linux")"

  local prev_cpu prev_idle prev_rx prev_tx prev_dr prev_dw
  read -r prev_cpu prev_idle < <(get_cpu_stat)
  read -r prev_rx prev_tx < <(get_net_bytes)
  read -r prev_dr prev_dw < <(get_disk_bytes)

  sleep 1
  clear 2>/dev/null || true

  while true; do
    local curr_cpu curr_idle curr_rx curr_tx curr_dr curr_dw
    read -r curr_cpu curr_idle < <(get_cpu_stat)
    read -r curr_rx curr_tx < <(get_net_bytes)
    read -r curr_dr curr_dw < <(get_disk_bytes)

    local cpu_usage
    cpu_usage="$(calc_cpu_usage "$prev_cpu" "$prev_idle" "$curr_cpu" "$curr_idle")"

    local rx_speed tx_speed
    IFS="|" read -r rx_speed tx_speed < <(calc_net_speed "$prev_rx" "$prev_tx" "$curr_rx" "$curr_tx" 1.5)

    local disk_r_speed disk_w_speed
    IFS="|" read -r disk_r_speed disk_w_speed < <(calc_disk_speed "$prev_dr" "$prev_dw" "$curr_dr" "$curr_dw" 1.5)

    local total_rx total_tx
    total_rx="$(format_bytes "$curr_rx")"
    total_tx="$(format_bytes "$curr_tx")"

    prev_rx="$curr_rx"
    prev_tx="$curr_tx"
    prev_dr="$curr_dr"
    prev_dw="$curr_dw"
    prev_cpu="$curr_cpu"
    prev_idle="$curr_idle"

    local mem_total mem_avail mem_used mem_percent
    mem_total="$(grep MemTotal /proc/meminfo | awk '{print $2}')"
    mem_avail="$(grep MemAvailable /proc/meminfo | awk '{print $2}')"
    if [ -n "$mem_total" ] && [ "$mem_total" -gt 0 ]; then
      mem_used=$((mem_total - mem_avail))
      mem_percent=$((100 * mem_used / mem_total))
      local mem_total_mb=$((mem_total / 1024))
      local mem_used_mb=$((mem_used / 1024))
    else
      mem_percent=0
      mem_total_mb=0
      mem_used_mb=0
    fi

    local swap_total swap_free swap_used=0 swap_percent=0 swap_total_mb=0 swap_used_mb=0
    swap_total="$(grep SwapTotal /proc/meminfo | awk '{print $2}')"
    swap_free="$(grep SwapFree /proc/meminfo | awk '{print $2}')"
    if [ -n "$swap_total" ] && [ "$swap_total" -gt 0 ]; then
      swap_used=$((swap_total - swap_free))
      swap_percent=$((100 * swap_used / swap_total))
      swap_total_mb=$((swap_total / 1024))
      swap_used_mb=$((swap_used / 1024))
    fi

    local sys_load tcp_conns
    sys_load="$(awk '{print $1, $2, $3}' /proc/loadavg 2>/dev/null || echo "0 0 0")"
    tcp_conns="$(ss -t -a state established 2>/dev/null | grep -v '^Recv-Q' | wc -l || echo "0")"

    local disk_info disk_usage disk_total disk_used disk_pct_num=0
    disk_info="$(df -h / | awk 'NR==2 {print $2, $3, $5}')"
    read -r disk_total disk_used disk_usage <<< "$disk_info"
    disk_pct_num="${disk_usage%\%}"

    draw_bar() {
      local pct="${1:-0}"
      local width=20
      local filled=$((pct * width / 100))
      local empty=$((width - filled))
      local bar=""
      for ((i=0; i<filled; i++)); do bar+="#"; done
      for ((i=0; i<empty; i++)); do bar+="-"; done

      local color="$gl_lv"
      if [ "$pct" -ge 90 ]; then
        color="$gl_hong"
      elif [ "$pct" -ge 80 ]; then
        color="$gl_huang"
      fi
      echo -e "${color}[$bar] ${pct}%${gl_bai}"
    }

    local cpu_bar mem_bar swap_bar sys_uptime
    cpu_bar="$(draw_bar "$cpu_usage")"
    mem_bar="$(draw_bar "$mem_percent")"
    swap_bar="$(draw_bar "$swap_percent")"
    sys_uptime="$(uptime -p 2>/dev/null || uptime)"

    local svc_status
    svc_status="$(get_services_status)"

    local sort_title="CPU"
    [ "$sort_mode" = "mem" ] && sort_title="内存"

    # 使用 ANSI \033[H 原地移动光标重绘，彻底解决清屏闪烁
    printf '\033[H'
    echo -e "${gl_kjlan}====================================================${gl_bai}\033[K"
    echo -e "         ${gl_lv}UA Box 动态 Live 系统监控控制台${gl_bai}  (按 Q 键退出)\033[K"
    echo -e "${gl_kjlan}====================================================${gl_bai}\033[K"
    echo -e "  主机名: ${gl_bai}${host_name}${gl_bai} | 内核: ${gl_bai}${sys_kernel}${gl_bai} | Uptime: ${gl_bai}${sys_uptime}${gl_bai}\033[K"
    echo -e "  系统负载 (1/5/15m): ${gl_bai}${sys_load}${gl_bai} | TCP 建立连接: ${gl_lv}${tcp_conns}${gl_bai}\033[K"
    if [ -n "$svc_status" ]; then
      echo -e "  关键服务状态: ${svc_status}\033[K"
    fi
    echo -e "${gl_kjlan}----------------------------------------------------${gl_bai}\033[K"
    echo -e "  CPU 使用率  ($num_cpus 核): ${cpu_bar}\033[K"
    echo -e "  内存 使用率 (${mem_used_mb}M/${mem_total_mb}M): ${mem_bar}\033[K"
    if [ "$swap_total_mb" -gt 0 ]; then
      echo -e "  Swap 虚拟内存 (${swap_used_mb}M/${swap_total_mb}M): ${swap_bar}\033[K"
    fi
    echo -e "  根磁盘 占用 (/):        ${gl_kjlan}${disk_used} / ${disk_total} (${disk_usage})${gl_bai}\033[K"
    echo -e "  磁盘 I/O 读写:          实时 读: ${gl_lv}${disk_r_speed}${gl_bai} | 实时 写: ${gl_lv}${disk_w_speed}${gl_bai}\033[K"
    echo -e "${gl_kjlan}----------------------------------------------------${gl_bai}\033[K"
    echo -e "  全机网络流量: 实时 RX: ${gl_lv}${rx_speed}${gl_bai} (总计: ${gl_kjlan}${total_rx}${gl_bai}) | 实时 TX: ${gl_lv}${tx_speed}${gl_bai} (总计: ${gl_kjlan}${total_tx}${gl_bai})\033[K"
    echo -e "${gl_kjlan}----------------------------------------------------${gl_bai}\033[K"

    local show_proc=1 show_docker=1 proc_limit=9
    if [ "$view_mode" = "proc" ]; then
      show_docker=0
      proc_limit=16
    elif [ "$view_mode" = "docker" ]; then
      show_proc=0
    fi

    if [ "$show_proc" -eq 1 ]; then
      echo -e "${gl_kjlan}系统运行进程 (按 ${sort_title} 排序 | 模式: ${view_mode}):${gl_bai}\033[K"
      if [ "$sort_mode" = "mem" ]; then
        ps -eo pid,user,%cpu,%mem,args --sort=-%mem 2>/dev/null | head -n "$proc_limit" | awk '
          BEGIN { printf "%-8s %-10s %-7s %-7s %s\033[K\n", "PID", "USER", "CPU %", "MEM %", "COMMAND" }
          NR>1 {
            cmd = ""
            for (i=5; i<=NF; i++) {
              cmd = cmd (i==5?"":" ") $i
            }
            sub(/^(\/[^\/ ]+)+\//, "", cmd)
            if (length(cmd) > 35) cmd = substr(cmd, 1, 32) "..."
            printf "%-8s %-10.10s %-7s %-7s %s\033[K\n", $1, $2, $3, $4, cmd
          }
        '
      else
        ps -eo pid,user,%cpu,%mem,args --sort=-%cpu 2>/dev/null | head -n "$proc_limit" | awk '
          BEGIN { printf "%-8s %-10s %-7s %-7s %s\033[K\n", "PID", "USER", "CPU %", "MEM %", "COMMAND" }
          NR>1 {
            cmd = ""
            for (i=5; i<=NF; i++) {
              cmd = cmd (i==5?"":" ") $i
            }
            sub(/^(\/[^\/ ]+)+\//, "", cmd)
            if (length(cmd) > 35) cmd = substr(cmd, 1, 32) "..."
            printf "%-8s %-10.10s %-7s %-7s %s\033[K\n", $1, $2, $3, $4, cmd
          }
        '
      fi
    fi

    if [ "$show_docker" -eq 1 ] && has_cmd docker && docker info >/dev/null 2>&1; then
      [ "$show_proc" -eq 1 ] && echo -e "${gl_kjlan}----------------------------------------------------${gl_bai}\033[K"
      echo -e "${gl_kjlan}运行中 Docker 容器 (按 ${sort_title} 排序 | 模式: ${view_mode}):${gl_bai}\033[K"
      if [ "$sort_mode" = "mem" ]; then
        docker stats --no-stream --format "{{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.MemPerc}}\t{{.NetIO}}\t{{.BlockIO}}" 2>/dev/null | sort -k4 -hr | awk -F'\t' '
          BEGIN { printf "%-18s %-8s %-18s %-8s %-20s %s\033[K\n", "NAME", "CPU %", "MEM USAGE", "MEM %", "NET I/O", "BLOCK I/O" }
          { printf "%-18.18s %-8s %-18s %-8s %-20s %s\033[K\n", $1, $2, $3, $4, $5, $6 }
        '
      else
        docker stats --no-stream --format "{{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.MemPerc}}\t{{.NetIO}}\t{{.BlockIO}}" 2>/dev/null | sort -k2 -hr | awk -F'\t' '
          BEGIN { printf "%-18s %-8s %-18s %-8s %-20s %s\033[K\n", "NAME", "CPU %", "MEM USAGE", "MEM %", "NET I/O", "BLOCK I/O" }
          { printf "%-18.18s %-8s %-18s %-8s %-20s %s\033[K\n", $1, $2, $3, $4, $5, $6 }
        '
      fi
    fi

    echo -e "${gl_kjlan}====================================================${gl_bai}\033[K"
    echo -e "提示: 1.5s 刷新 | Q: 退出 | C: CPU | M: 内存 | A: 全部 | P: 进程 | D: Docker | K: Kill | L: 日志\033[K"
    printf '\033[J'

    read -r -t 1.5 -n 1 input_key || true
    case "$input_key" in
      q|Q)
        tput cnorm 2>/dev/null || true
        clear
        return 0
        ;;
      c|C)
        sort_mode="cpu"
        ;;
      m|M)
        sort_mode="mem"
        ;;
      a|A)
        view_mode="all"
        ;;
      p|P)
        view_mode="proc"
        ;;
      d|D)
        view_mode="docker"
        ;;
      k|K)
        tput cnorm 2>/dev/null || true
        clear
        echo -e "${gl_kjlan}=== 快速终止进程 / 停止容器 ===${gl_bai}"
        echo -e "1. 杀死系统进程 (PID)"
        echo -e "2. 停止 Docker 容器"
        echo -e "0. 返回控制台"
        read -r -p "请选择操作 [0-2]: " kill_opt
        case "$kill_opt" in
          1)
            read -r -p "请输入要终止的进程 PID: " target_pid
            if [ -n "$target_pid" ] && [[ "$target_pid" =~ ^[0-9]+$ ]]; then
              read -r -p "确认强制杀死 PID $target_pid ? [y/N]: " confirm_k
              if [[ "$confirm_k" =~ ^[Yy]$ ]]; then
                kill -9 "$target_pid" 2>/dev/null && echo -e "${gl_lv}已成功杀死进程 $target_pid${gl_bai}" || echo -e "${gl_hong}杀死进程失败${gl_bai}"
                sleep 1.5
              fi
            fi
            ;;
          2)
            if has_cmd docker && docker info >/dev/null 2>&1; then
              read -r -p "请输入要停止的 Docker 容器名称/ID: " target_container
              if [ -n "$target_container" ]; then
                echo "正在停止容器 $target_container..."
                docker stop "$target_container" 2>/dev/null && echo -e "${gl_lv}已成功停止容器 $target_container${gl_bai}" || echo -e "${gl_hong}停止容器失败${gl_bai}"
                sleep 1.5
              fi
            else
              echo "未检测到运行中的 Docker"
              sleep 1.5
            fi
            ;;
        esac
        tput civis 2>/dev/null || true
        clear
        ;;
      l|L)
        tput cnorm 2>/dev/null || true
        clear
        echo -e "${gl_kjlan}=== 查看系统 / 容器日志 ===${gl_bai}"
        echo -e "1. 查看 Docker 容器日志"
        echo -e "2. 查看 Systemd 服务日志"
        echo -e "0. 返回控制台"
        read -r -p "请选择操作 [0-2]: " log_opt
        case "$log_opt" in
          1)
            if has_cmd docker && docker info >/dev/null 2>&1; then
              read -r -p "请输入 Docker 容器名称/ID: " target_container
              if [ -n "$target_container" ]; then
                clear
                echo -e "${gl_lv}按 Ctrl+C 退出日志查看...${gl_bai}"
                docker logs --tail 100 -f "$target_container" 2>/dev/null || true
              fi
            else
              echo "未检测到 Docker"
              sleep 1.5
            fi
            ;;
          2)
            read -r -p "请输入 Systemd 服务名 (如 caddy / sshd): " target_svc
            if [ -n "$target_svc" ]; then
              clear
              echo -e "${gl_lv}按 Ctrl+C 退出日志查看...${gl_bai}"
              journalctl -u "$target_svc" -n 100 -f 2>/dev/null || true
            fi
            ;;
        esac
        tput civis 2>/dev/null || true
        clear
        ;;
    esac
  done
  )
}

