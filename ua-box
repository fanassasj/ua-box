collect_failed_rclone_remotes() {
  local check_timeout remote rc

  has_cmd rclone || return 0
  check_timeout="${RCLONE_STATUS_CHECK_TIMEOUT:-${RCLONE_CHECK_TIMEOUT:-5}}"
  while IFS= read -r remote; do
    [ -z "$remote" ] && continue
    list_has_word "$remote" "$UA_IGNORE_RCLONE_REMOTES" && continue
    if has_cmd timeout; then
      timeout "$check_timeout" rclone lsd "${remote}:" >/dev/null 2>&1
      rc=$?
    else
      rclone lsd "${remote}:" >/dev/null 2>&1
      rc=$?
    fi
    [ "$rc" -ne 0 ] && printf '%s\n' "$remote"
  done < <(rclone listremotes 2>/dev/null | sed 's/:$//')
}

ua_abnormal_summary() {
  local found cpu_pct mem_pct disk_pct disk_warn disk_crit load_avg load_int cores bad_containers check_timeout failed_remotes remote rc output status svc
  local container_name container_status

  # 人类可读报告保持原入口；通知通过独立 JSONL 事件判断状态，不解析报告文字。
  _ua_alert_event() {
    [ -n "${UA_ALERT_EVENTS_FILE:-}" ] || return 0
    if ! python3 -B -c 'import json,sys; print(json.dumps(dict(zip(("type","scope","key","severity","message"),sys.argv[1:])),ensure_ascii=False))' "$@" >> "$UA_ALERT_EVENTS_FILE"; then
      _UA_ALERT_RECORD_FAILED=1
    fi
    return 0
  }
  found=0
  check_timeout="${RCLONE_STATUS_CHECK_TIMEOUT:-${RCLONE_CHECK_TIMEOUT:-5}}"
  disk_warn="${UA_STATUS_DISK_WARN:-80}"
  disk_crit="${UA_STATUS_DISK_CRIT:-90}"
  printf '%s\n' "$disk_warn" | grep -Eq '^[0-9]+$' || disk_warn=80
  printf '%s\n' "$disk_crit" | grep -Eq '^[0-9]+$' || disk_crit=90

  echo -e "${gl_kjlan}异常汇总${gl_bai}"

  cpu_pct="$(cpu_usage 2>/dev/null)" || cpu_pct=""
  mem_pct="$(free | awk '/^Mem:/ {printf "%.0f", $3*100/$2}' 2>/dev/null)"
  disk_pct="$(df -P / | awk 'NR==2 {gsub("%","",$5); print $5}' 2>/dev/null)"
  load_avg="$(awk '{print $1}' /proc/loadavg 2>/dev/null)"
  cores="$(getconf _NPROCESSORS_ONLN 2>/dev/null || nproc 2>/dev/null || echo 1)"

  local metric_scope metric_value
  for metric_scope in host.cpu host.memory host.disk; do
    case "$metric_scope" in host.cpu) metric_value="$cpu_pct" ;; host.memory) metric_value="$mem_pct" ;; host.disk) metric_value="$disk_pct" ;; esac
    if [[ "$metric_value" =~ ^[0-9]+$ ]]; then
      _ua_alert_event checked "$metric_scope"
    else
      _ua_alert_event unknown "$metric_scope"
    fi
  done
  if [[ "$load_avg" =~ ^[0-9]+([.][0-9]+)?$ && "$cores" =~ ^[0-9]+$ ]] && [ "$cores" -gt 0 ]; then
    _ua_alert_event checked host.load
  else
    _ua_alert_event unknown host.load
  fi

  if printf '%s\n' "$cpu_pct" | grep -Eq '^[0-9]+$' && [ "$cpu_pct" -ge 80 ]; then
    _ua_alert_event issue host.cpu host:cpu warning "CPU 占用高: ${cpu_pct}%"
    echo "- CPU 占用高: ${cpu_pct}%"
    echo "  建议: 使用 top/htop 查看高占用进程，必要时重启异常服务。"
    found=1
  fi
  if printf '%s\n' "$mem_pct" | grep -Eq '^[0-9]+$' && [ "$mem_pct" -ge 85 ]; then
    _ua_alert_event issue host.memory host:memory warning "内存占用高: ${mem_pct}%"
    echo "- 内存占用高: ${mem_pct}%"
    echo "  建议: 使用 free -h 和 docker stats 排查占用，必要时增加 swap 或限制容器内存。"
    found=1
  fi
  if printf '%s\n' "$disk_pct" | grep -Eq '^[0-9]+$' && [ "$disk_pct" -ge "$disk_crit" ]; then
    _ua_alert_event issue host.disk disk:root critical "根分区占用严重: ${disk_pct}%"
    echo "- 根分区占用严重: ${disk_pct}% >= ${disk_crit}%"
    echo "  建议: 立即清理日志、缓存、旧备份或 Docker 无用数据。"
    found=1
  elif printf '%s\n' "$disk_pct" | grep -Eq '^[0-9]+$' && [ "$disk_pct" -ge "$disk_warn" ]; then
    _ua_alert_event issue host.disk disk:root warning "根分区占用偏高: ${disk_pct}%"
    echo "- 根分区占用偏高: ${disk_pct}% >= ${disk_warn}%"
    echo "  建议: 使用 ncdu/du 定位大目录，并关注日志和备份增长。"
    found=1
  fi
  load_int="${load_avg%%.*}"
  if printf '%s\n' "$load_int" | grep -Eq '^[0-9]+$' &&
    printf '%s\n' "$cores" | grep -Eq '^[0-9]+$' &&
    [ "$cores" -gt 0 ] && [ "$load_int" -ge "$cores" ]; then
    _ua_alert_event issue host.load host:load warning "系统负载偏高: ${load_avg} / ${cores}核"
    echo "- 系统负载偏高: ${load_avg} / ${cores}核"
    echo "  建议: 使用 uptime/top 查看负载来源，重点检查 CPU、磁盘 IO 和网络任务。"
    found=1
  fi



  local ignored_name
  for ignored_name in $UA_IGNORE_CONTAINERS; do
    _ua_alert_event ignored '' "container:$ignored_name"
  done
  for ignored_name in $UA_IGNORE_SERVICES; do
    _ua_alert_event ignored '' "service:$ignored_name"
  done
  for ignored_name in $UA_IGNORE_RCLONE_REMOTES; do
    _ua_alert_event ignored '' "rclone:$ignored_name"
  done
  if has_cmd docker; then
    _ua_alert_event checked docker.daemon
    if docker info >/dev/null 2>&1; then
      local inventory filtered_inventory="" _bad="" invalid_inventory=0 _bname _bstate _bstatus _project projects project running total
      _ua_alert_event checked probe:docker.inventory
      if ! inventory="$(docker ps -a --format '{{.Names}}\t{{.State}}\t{{.Status}}\t{{.Label "com.docker.compose.project"}}')"; then
        _ua_alert_event unknown docker.container
        _ua_alert_event unknown docker.compose
        _ua_alert_event issue probe:docker.inventory probe:docker.inventory warning "Docker 容器列表检测失败"
        echo "- Docker 容器状态检测失败，不能认定所有容器正常。"
        found=1
      else
        while IFS=$'\t' read -r _bname _bstate _bstatus _project; do
          [ -n "$_bname" ] || continue
          case "$_bname" in *-ua-old-*|*-ua-failed-*) continue ;; esac
          list_has_word "$_bname" "$UA_IGNORE_CONTAINERS" && continue
          if [ -z "$_bstatus" ] || [[ ! "$_bstate" =~ ^(running|exited|created|restarting|paused|dead|removing)$ ]]; then
            _ua_alert_event unknown "docker.container:$_bname"
            invalid_inventory=1
            continue
          fi
          if [ "$_bstate" = running ] && [[ "$_bstatus" = *'health: starting'* ]]; then
            _ua_alert_event unknown "docker.container:$_bname"
          else
            _ua_alert_event checked "docker.container:$_bname"
            if [ "$_bstate" != running ] || [[ "$_bstatus" = *'(unhealthy)'* ]]; then
              _ua_alert_event issue "docker.container:$_bname" "container:$_bname" critical "容器异常（停止或健康检查失败）: $_bname"
              _bad+="$_bname"$'\n'
              found=1
            fi
          fi
          filtered_inventory+="$_bname"$'\t'"$_bstate"$'\t'"$_bstatus"$'\t'"$_project"$'\n'
        done <<< "$inventory"
        if [ "$invalid_inventory" -eq 1 ]; then
          _ua_alert_event unknown docker.compose
          _ua_alert_event issue probe:docker.inventory probe:docker.inventory warning "Docker 列表包含无法确认的状态"
          echo "- Docker 列表包含无法确认的状态，不能判断相关对象恢复。"
          found=1
        fi
        if [ -n "$_bad" ]; then
          echo "- Docker 异常容器（已停止或健康检查失败）:"
          printf '%s' "$_bad"
          echo "  建议: 先查看日志和健康检查结果，再决定是否重启。"
        fi
        projects="$(printf '%s' "$filtered_inventory" | awk -F'\t' '
          $4 != "" {
            total[$4]++
            if ($2 == "running" && $3 !~ /unhealthy|health: starting/) ready[$4]++
          }
          END { for (p in total) printf "%s\t%d\t%d\n", p, ready[p]+0, total[p] }
        ')"
        while IFS=$'\t' read -r project running total; do
          [ -n "$project" ] || continue
          _ua_alert_event checked "docker.compose:$project"
          if [ "$running" -lt "$total" ]; then
            _ua_alert_event issue "docker.compose:$project" "compose:$project" critical "Compose 项目未全部就绪: $project ($running/$total)"
            echo "- Compose 项目未全部就绪: $project ($running/$total)"
            found=1
          fi
        done <<< "$projects"
      fi
    else
      _ua_alert_event issue docker.daemon docker:daemon critical "Docker 服务未运行或不可访问"
      _ua_alert_event unknown docker.container
      _ua_alert_event unknown docker.compose
      _ua_alert_event unknown probe:docker.inventory
      echo "- Docker 服务未运行或不可访问"
      echo "  建议: 使用 systemctl status docker 查看原因。"
      found=1
    fi
  else
    _ua_alert_event unknown docker
    _ua_alert_event unknown probe:docker.inventory
  fi

  if has_cmd systemctl; then
    local _monitor_svcs unit_list active_rc
    _monitor_svcs="${UA_MONITOR_SERVICES:-caddy}"
    for svc in $_monitor_svcs; do
      if list_has_word "$svc" "$UA_IGNORE_SERVICES"; then
        _ua_alert_event ignored '' "service:$svc"
        continue
      fi
      if ! unit_list="$(systemctl list-unit-files "${svc}.service" --no-legend 2>/dev/null)" || [ -z "$unit_list" ]; then
        _ua_alert_event unknown "service:$svc"
        continue
      fi
      active_rc=0
      systemctl is-active --quiet "$svc" 2>/dev/null || active_rc=$?
      case "$active_rc" in
        0) _ua_alert_event checked "service:$svc" ;;
        3)
          _ua_alert_event checked "service:$svc"
          _ua_alert_event issue "service:$svc" "service:$svc" critical "服务未运行: $svc"
          echo "- 服务未运行: $svc"
          found=1
          ;;
        *) _ua_alert_event unknown "service:$svc" ;;
      esac
    done
  else
    _ua_alert_event unknown service
  fi


  if has_cmd rclone; then
    if [ "${UA_STATUS_SKIP_RCLONE:-0}" = 1 ]; then
      _ua_alert_event unknown rclone
      echo "- rclone remote 检测已跳过（UA_STATUS_SKIP_RCLONE=1）"
    else
      local _rclone_list
      if ! _rclone_list="$(rclone listremotes 2>/dev/null)"; then
        _ua_alert_event unknown rclone
        echo "- rclone remote 列表不可读取，不能判断恢复。"
      else
        while IFS= read -r remote; do
          remote="${remote%:}"
          [ -n "$remote" ] || continue
          if list_has_word "$remote" "$UA_IGNORE_RCLONE_REMOTES"; then
            _ua_alert_event ignored '' "rclone:$remote"
            continue
          fi
          if ! has_cmd timeout; then
            _ua_alert_event unknown "rclone:$remote"
            echo "- 缺少 timeout，已跳过远程连接探测: $remote"
            continue
          fi
          rc=0
          timeout "$check_timeout" rclone lsd "${remote}:" >/dev/null 2>&1 || rc=$?
          _ua_alert_event checked "rclone:$remote"
          if [ "$rc" -ne 0 ]; then
            _ua_alert_event issue "rclone:$remote" "rclone:$remote" warning "rclone remote 连接失败或超时: $remote"
            echo "- rclone remote 连接异常: $remote"
            found=1
          fi
        done <<< "$_rclone_list"
      fi
    fi
  else
    _ua_alert_event unknown rclone
  fi

  if has_cmd openssl; then
    local cert_dir crt_file expiring_certs=""
    for cert_dir in "/root/caddy_data/caddy/certificates" "/var/lib/caddy/.local/share/caddy/certificates"; do
      [ -d "$cert_dir" ] || continue
      while IFS= read -r crt_file; do
        [ -z "$crt_file" ] || [ ! -f "$crt_file" ] && continue
        _ua_alert_event checked "certificate:$crt_file"
        if ! openssl x509 -checkend 604800 -noout -in "$crt_file" >/dev/null 2>&1; then
          _ua_alert_event issue "certificate:$crt_file" "certificate:$crt_file" warning "证书即将过期或不可解析: $(basename "$crt_file" .crt)"
          expiring_certs="${expiring_certs}$(basename "$crt_file" .crt) "
        fi
      done < <(find "$cert_dir" -type f -name "*.crt" 2>/dev/null)
    done
    if [ -n "$expiring_certs" ]; then
      echo "- SSL 证书即将过期 (<7天) 或已过期: $expiring_certs"
      echo "  建议: 检查域名 DNS 解析是否仍指向本机，并在「ua panel -> Caddy」中重载服务触发续期。"
      found=1
    fi
  fi

  _UA_LAST_ABNORMAL_FOUND="$found"
  [ "$found" -eq 0 ] && echo "- 暂无明显异常。"
  return 0
}

ua_health_program() {
  cat <<'PY_UA_HEALTH'
"""Read-only diagnostics and private, acknowledged notification state. No work on import."""
import copy
import hashlib
import json
import math
import os
from pathlib import Path
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
