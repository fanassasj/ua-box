    system_init_optimize
    ;;
  bbr)
    system_bbr_menu
    ;;
  fw|firewall|防火墙)
    system_firewall_menu
    ;;
  install|add|安装)
    shift
    install_pkg "$@"
    ;;
  remove|del|uninstall|卸载)
