    echo -e "${gl_kjlan}------------------------${gl_bai}"
    echo -e "${gl_kjlan}1.  ${gl_bai}安装 / 更新 Fail2ban"
    echo -e "${gl_kjlan}2.  ${gl_bai}一键配置 SSH 防暴破规则 (jail.local)"
    echo -e "${gl_kjlan}3.  ${gl_bai}查看 SSH 详细被封禁 IP 列表"
    echo -e "${gl_kjlan}4.  ${gl_bai}手动解封指定 IP (unban)"
    echo -e "${gl_kjlan}5.  ${gl_bai}启动 / 重启 Fail2ban 服务"
    echo -e "${gl_kjlan}6.  ${gl_bai}停止 Fail2ban 服务"
    echo -e "${gl_kjlan}7.  ${gl_bai}卸载 Fail2ban"
    echo -e "${gl_kjlan}0.  ${gl_bai}返回"
    echo -e "${gl_kjlan}------------------------${gl_bai}"
    read -r -e -p "请输入你的选择: " choice || break

    case "$choice" in
      1)
        install_pkg fail2ban
        systemctl enable fail2ban >/dev/null 2>&1 || true
        systemctl start fail2ban >/dev/null 2>&1 || true
        pause
        ;;
      2)
        if ! has_cmd fail2ban-client; then
          echo -e "${gl_huang}检测到 Fail2ban 未安装，正在先进行自动安装...${gl_bai}"
          install_pkg fail2ban || return 1
        fi
        
        local max_retry ban_time cur_ssh_port f2b_port_val
        read -r -e -p "请输入允许失败的最大次数 (直接回车默认为 5): " max_retry
        max_retry="${max_retry:-5}"
        read -r -e -p "请输入封禁时长 (分钟，直接回车默认为 60 分钟): " ban_time
        ban_time="${ban_time:-60}"

        if ! printf '%s\n' "$max_retry" | grep -Eq '^[0-9]+$' || [ "$max_retry" -lt 1 ] ||
           ! printf '%s\n' "$ban_time" | grep -Eq '^[0-9]+$' || [ "$ban_time" -lt 1 ]; then
          echo -e "${gl_hong}错误: 最大失败次数和封禁时长必须为大于 0 的整数！${gl_bai}"
          pause
          continue
        fi

        local ban_seconds=$((ban_time * 60))
        cur_ssh_port="$(ssh_get_current_port)"
        f2b_port_val="ssh"
        [ "$cur_ssh_port" != "22" ] && f2b_port_val="ssh,${cur_ssh_port}"
        mkdir -p "$(dirname "$jail_conf")"

        cat > "$jail_conf" <<EOF
# UA Box 自动生成的 Fail2ban 配置文件
[DEFAULT]
ignoreip = 127.0.0.1/8 ::1
bantime  = ${ban_seconds}
findtime = 600
maxretry = ${max_retry}

[sshd]
enabled = true
port    = ${f2b_port_val}
filter  = sshd
logpath = %(sshd_log)s
backend = %(sshd_backend)s
EOF

        systemctl restart fail2ban >/dev/null 2>&1 || systemctl start fail2ban >/dev/null 2>&1
        systemctl enable fail2ban >/dev/null 2>&1 || true
        log_action "configure fail2ban sshd jail (maxretry=$max_retry, bantime=${ban_time}m)"
        echo -e "${gl_lv}Fail2ban SSH 防暴破规则已写入 $jail_conf 并生效！${gl_bai}"
        echo "策略参数: 10分钟内尝试失败 ${max_retry} 次，封禁 ${ban_time} 分钟。"
        pause
        ;;
      3)
        if has_cmd fail2ban-client; then
          fail2ban-client status sshd 2>/dev/null || echo "无法获取 status，请确认 sshd jail 是否已开启。"
        else
          echo "Fail2ban 未安装。"
        fi
        pause
        ;;
      4)
        if has_cmd fail2ban-client; then
          local unban_ip
          read -r -e -p "请输入要解封的 IP 地址: " unban_ip
          if [ -n "$unban_ip" ]; then
            fail2ban-client unbanip "$unban_ip" && log_action "fail2ban unbanip $unban_ip"
          fi
        else
          echo "Fail2ban 未安装。"
        fi
        pause
        ;;
      5)
        systemctl restart fail2ban && echo -e "${gl_lv}Fail2ban 服务已重启。${gl_bai}"
        pause
        ;;
      6)
        systemctl stop fail2ban && echo -e "${gl_huang}Fail2ban 服务已停止。${gl_bai}"
        pause
        ;;
      7)
        if confirm_danger "卸载 Fail2ban 防暴破组件" "apt/yum remove fail2ban"; then
          systemctl stop fail2ban >/dev/null 2>&1 || true
          systemctl disable fail2ban >/dev/null 2>&1 || true
          remove_pkg fail2ban
        fi
        pause
        ;;
      0) break ;;
      *) echo "无效输入"; pause ;;
    esac
  done
}

