ua_validate_update() {
  local candidate="$1"
  if ! bash -n "$candidate" >/dev/null 2>&1 ||
     ! grep -Eq '^UA_BOX_VERSION="[0-9]+([.][0-9]+)+[a-zA-Z0-9._-]*"$' "$candidate" ||
     ! grep -q '^create_local_links()' "$candidate"; then
    echo "候选文件不是可识别的 UA Box 脚本或语法无效，未应用。" >&2
    return 1
  fi
  if grep -Eq "<<'PY_UA_(RECOVERY|HEALTH)'" "$candidate"; then
    has_cmd python3 || { echo "需要 Python 3 校验内嵌程序，未应用更新。" >&2; return 1; }
    if ! python3 -B -c 'import pathlib,sys
text=pathlib.Path(sys.argv[1]).read_text()
for marker in ("PY_UA_RECOVERY", "PY_UA_HEALTH"):
    prefix="<<"+chr(39)+marker+chr(39)+"\n"
    if prefix in text:
        code=text.split(prefix,1)[1].split("\n"+marker+"\n",1)[0]
        compile(code,marker,"exec")
' "$candidate" >/dev/null 2>&1; then
      echo "内嵌 Python 程序校验失败，未应用更新。" >&2
      return 1
    fi
  fi
}

update_self() {
  local src tmp update_url up_choice update_git branch upstream before target relative status
  src="$(readlink -f "$0" 2>/dev/null || echo "$0")"
  if [ -e "$UA_BOX_HOME/.git" ]; then
    branch="$(git -C "$UA_BOX_HOME" symbolic-ref --quiet --short HEAD 2>/dev/null)" || branch=""
    upstream="$(git -C "$UA_BOX_HOME" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)" || upstream=""
    echo "当前分支: ${branch:-分离 HEAD}；更新目标: ${upstream:-未配置上游}"
    read -r -e -p "是否从该分支上游获取并快进更新？[Y/n]: " update_git || return 1
    if [[ "${update_git:-y}" = [Yy] ]]; then
      [ -n "$branch" ] && [ -n "$upstream" ] || { echo "分支或上游未明确，未更新。" >&2; return 1; }
      status="$(git -C "$UA_BOX_HOME" status --porcelain --untracked-files=no)" || return 1
      [ -z "$status" ] || { echo "存在已跟踪文件的本地修改，请先处理；未覆盖或暂存任何修改。" >&2; return 1; }
      before="$(git -C "$UA_BOX_HOME" rev-parse HEAD)" || return 1
      # 先读取和验证目标脚本，再快进工作区；不自动合并、stash 或 reset。
      if ! git -C "$UA_BOX_HOME" fetch --no-tags >/dev/null 2>&1; then
        echo "Git 获取上游失败，未更新工作区。" >&2; return 1
      fi
      target="$(git -C "$UA_BOX_HOME" rev-parse --verify '@{upstream}^{commit}' 2>/dev/null)" || return 1
      echo "目标提交: $target"
      [ "$before" != "$target" ] || { echo "当前已是上游版本，无需更新。"; return 0; }
      git -C "$UA_BOX_HOME" merge-base --is-ancestor "$before" "$target" || { echo "历史已分叉或本地领先，未自动合并。" >&2; return 1; }
      case "$src" in "$UA_BOX_HOME/"*) relative="${src#"$UA_BOX_HOME/"}" ;; *) echo "脚本不在当前仓库中，未更新。" >&2; return 1 ;; esac
      tmp="$(mktemp "$UA_BOX_TMP_DIR/update.XXXXXX")" || return 1
      git -C "$UA_BOX_HOME" show "$target:$relative" > "$tmp" 2>/dev/null || { echo "无法读取目标脚本，未更新。" >&2; return 1; }
      ua_validate_update "$tmp" || return 1
      status="$(git -C "$UA_BOX_HOME" status --porcelain --untracked-files=no)" || return 1
      [ -z "$status" ] && [ "$(git -C "$UA_BOX_HOME" rev-parse HEAD)" = "$before" ] || { echo "工作区或分支在检查期间发生变化，未继续更新。" >&2; return 1; }
      backup_self || return 1
      if ! git -C "$UA_BOX_HOME" merge --ff-only "$target" >/dev/null 2>&1; then
        echo "Git 快进失败，未认定更新成功；原脚本备份已保留。" >&2; return 1
      fi
      [ "$(git -C "$UA_BOX_HOME" rev-parse HEAD)" = "$target" ] && cmp -s "$tmp" "$src" || { echo "更新结果未通过核验，未重新执行；请检查工作区与原脚本备份。" >&2; return 1; }
      log_action "self update verified git commit=$target" || true
    else
      update_git=n
    fi
  else
    update_git=n
  fi
  if [ "$update_git" = n ]; then
    echo "1) 使用已配置的更新地址（地址内容不显示）"
    echo "2) 手动输入更新地址"
    echo "0) 取消"
    read -r -e -p "请输入选择 (0-2): " up_choice || return 1
    case "$up_choice" in
      1) update_url="${UA_BOX_UPDATE_URL:-}" ;;
      2) read -r -s -p "请输入更新脚本 URL（不回显）: " update_url || return 1; echo ;;
      *) return 0 ;;
    esac
    [ -n "$update_url" ] || { echo "更新地址为空，未更新。" >&2; return 1; }
    tmp="$(mktemp "$UA_BOX_TMP_DIR/update.XXXXXX")" || return 1
    if ! download_to "$update_url" "$tmp" >/dev/null 2>&1; then
      echo "更新下载失败，地址及凭据未写入日志。" >&2; return 1
    fi
    ua_validate_update "$tmp" || return 1
    backup_self || return 1
    local atomic_tmp
    atomic_tmp="$(mktemp "${src}.tmp.XXXXXX")" || return 1
    if ! cp "$tmp" "$atomic_tmp" || ! chmod 755 "$atomic_tmp" || ! mv -f "$atomic_tmp" "$src"; then
      rm -f -- "$atomic_tmp"
      echo "更新文件替换失败，原脚本备份已保留。" >&2; return 1
    fi
    cmp -s "$tmp" "$src" || { echo "更新结果核验失败，未重新执行。" >&2; return 1; }
    log_action "self update verified URL source omitted" || true
  fi
  if ! create_local_links >/dev/null 2>&1; then
    echo "脚本已更新，但快捷入口设置失败；未自动重新执行。" >&2
    return 1
  fi
  echo "更新内容已核验，正在加载新版本。"
  ua_cleanup_tmp
  exec bash "$src"
}

