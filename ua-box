get_compose_projects_summary() {
  has_cmd docker || return 0
  docker info >/dev/null 2>&1 || return 0

  local ps_out
  if ! ps_out="$(docker ps -a --format '{{.Names}}\t{{.Label "com.docker.compose.project"}}\t{{.State}}')"; then
    echo "Compose 状态检测失败"
    return 1
  fi
  if [ -z "$ps_out" ]; then
    echo "-"
    return 0
  fi

  printf '%s\n' "$ps_out" | awk -F'\t' '
    $1 ~ /-ua-(old|failed)-/ { next }
    $2 != "" {
      proj=$2
      total[proj]++
      if ($3 == "running") running[proj]++
    }
    END {
      count = 0
      for (p in total) {
        run_count = running[p] ? running[p] : 0
        printf "%s (%d/%d %s) | ", p, run_count, total[p], (run_count == total[p] ? "运行" : "部分停止")
        count++
      }
      if (count == 0) printf "-"
    }
  ' | sed 's/ | $//'
}

