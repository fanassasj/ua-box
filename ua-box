system_fail2ban_menu() {
  need_root || return 1
  local choice f2b_status banned_ips jail_conf

  jail_conf="/etc/fail2ban/jail.local"

  while true; do
    clear
    echo -e "${gl_kjlan}Fail2ban 防暴破管理${gl_bai}"
    echo -e "${gl_kjlan}------------------------${gl_bai}"

    if is_pkg_installed fail2ban || has_cmd fail2ban-client; then
