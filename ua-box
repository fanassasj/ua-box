    ua_unignore_cli "$@"
    ;;
  config|cfg|配置)
    "${EDITOR:-nano}" "$UA_BOX_CONFIG"
    ;;
  log|logs|日志)
    tail -n 80 "$UA_BOX_LOG_FILE" 2>/dev/null || echo "暂无日志。"
