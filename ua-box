rclone_mount_systemd() {
  need_root || return 1
  rclone_require || return 1
  has_cmd systemd-escape || { echo "需要 systemd-escape。" >&2; return 1; }
  local remote_path mount_point extra config_file rclone_path service_name service_file stage
  read -r -e -p "请输入远程路径，如 remote:path : " remote_path || return 1
  read -r -e -p "请输入本地挂载点: " mount_point || return 1
  read -r -e -p "额外参数，回车使用默认: " extra || return 1
  extra="${extra:-$DEFAULT_RCLONE_MOUNT_ARGS}"
  [ -n "$remote_path" ] && [ -n "$mount_point" ] || return 1
  has_cmd fusermount3 || has_cmd fusermount || { echo "请先安装 FUSE 挂载组件。" >&2; return 1; }
  mkdir -p -- "$mount_point" || return 1
  mount_point="$(readlink -f -- "$mount_point")" || return 1
  mountpoint -q -- "$mount_point" && { echo "挂载点已被占用，未创建服务。" >&2; return 1; }
  service_name="$(systemd-escape --path -- "$mount_point")" || return 1
  service_file="/etc/systemd/system/rclone-mount-${service_name}.service"
  [ ! -e "$service_file" ] && [ ! -L "$service_file" ] || { echo "同名服务已存在，未覆盖: $service_file" >&2; return 1; }
  config_file="$(rclone_config_file_path)"
  rclone_path="$(command -v rclone)" || return 1
  stage="$(mktemp /etc/systemd/system/.ua-rclone.XXXXXX.service)" || return 1
  if ! run_recovery_operation rclone-unit "$stage" "$rclone_path" "$remote_path" "$mount_point" "$config_file" "$extra" ||
     ! systemd-analyze verify "$stage"; then
    rm -f -- "$stage"; return 1
  fi
  # 硬链接是不可覆盖的原子发布，避免检查后覆盖其他进程创建的服务。
  ln -- "$stage" "$service_file" || { rm -f -- "$stage"; return 1; }
  rm -f -- "$stage"
  systemctl daemon-reload && systemctl enable "${service_file##*/}" && systemctl restart "${service_file##*/}" || {
    echo "挂载服务启动未完成，已保留服务文件供检查: $service_file" >&2; return 1;
  }
  if ! systemctl is-active --quiet "${service_file##*/}" || ! mountpoint -q -- "$mount_point"; then
    echo "服务或挂载点未就绪，请查看 journalctl -u ${service_file##*/}" >&2
    return 1
  fi
  log_action "rclone mount verified: $service_name -> $mount_point"
  echo "已核验挂载点，服务: ${service_file##*/}"
}

rclone_unmount_point() {
  local mount_point service_name service_file
  read -r -e -p "请输入本地挂载点: " mount_point
  [ -z "$mount_point" ] && echo "挂载点不能为空。" && return 1

  mount_point="$(readlink -f "$mount_point" 2>/dev/null || echo "$mount_point")"
  service_name="$(systemd-escape --path -- "$mount_point")" || return 1
  [ -z "$service_name" ] && service_name="default"
  service_file="/etc/systemd/system/rclone-mount-${service_name}.service"

  if [ ! -f "$service_file" ]; then
    local legacy_name legacy_file
    legacy_name="$(printf '%s\n' "$mount_point" | sed 's|^/||; s|/|-|g; s|[^a-zA-Z0-9-]||g')"
    legacy_file="/etc/systemd/system/rclone-mount-${legacy_name:-default}.service"
    if [ -f "$legacy_file" ] && grep -Fq -- "\"$mount_point\"" "$legacy_file"; then
      service_file="$legacy_file"
      service_name="${legacy_name:-default}"
    fi
  fi
  if [ -f "$service_file" ]; then
    echo "检测到该挂载点由 Systemd 守护服务运行，正在卸载并删除该开机自启服务..."
    systemctl disable --now "rclone-mount-${service_name}.service" 2>/dev/null || true
    rm -f "$service_file"
    systemctl daemon-reload
    log_action "rclone systemd mount removed: ${service_name}"
    echo "Systemd 守护服务已被清除。"
  fi

  if has_cmd fusermount; then
    fusermount -uz "$mount_point" 2>/dev/null || umount -l "$mount_point" 2>/dev/null || true
  elif has_cmd fusermount3; then
    fusermount3 -uz "$mount_point" 2>/dev/null || umount -l "$mount_point" 2>/dev/null || true
  else
    umount -l "$mount_point" 2>/dev/null || true
  fi
  echo "挂载点卸载操作已完成。"
}

