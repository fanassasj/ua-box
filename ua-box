class HealthError(RuntimeError):
    pass


def query(args):
    """Only callers' fixed read-only probes; never invoke a shell or emit raw stderr."""
    environment = dict(os.environ, BASH_ENV="", ENV="", LC_ALL="C")
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=8, env=environment)
        return result.returncode, result.stdout
    except (OSError, subprocess.SubprocessError):
        return 125, ""


def safe_path(path):
    path = Path(path)
    if not path.is_absolute() or ".." in path.parts:
        raise HealthError("状态路径必须是规范绝对路径。")
    for candidate in (path, *path.parents):
        if candidate.is_symlink():
            raise HealthError("状态路径或父目录不能是符号链接。")
    return path


def private_file(path):
    path = safe_path(path)
    if path.exists():
        info = path.stat()
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
                or stat.S_IMODE(info.st_mode) & 0o077 or info.st_nlink != 1):
            raise HealthError("状态文件必须由当前用户拥有、权限为 600，且不是链接或特殊文件。")
    return path


def prepare_state(directory):
    directory = safe_path(directory)
    if not directory.exists():
        directory.mkdir(parents=True, mode=0o700, exist_ok=True)
    info = directory.stat()
    if not directory.is_dir() or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) & 0o077:
        raise HealthError("告警状态目录必须由当前用户拥有，且权限不大于 700；未修改已有目录。")
    private_file(directory / "state.json")
    private_file(directory / ".notify.lock")
    descriptor = os.open(directory / ".notify.lock", os.O_CREAT | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
    os.close(descriptor)


def write_json(path, data):
    path = private_file(path)
    descriptor, temporary = tempfile.mkstemp(prefix=".ua-notify-", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w") as stream:
            json.dump(data, stream, ensure_ascii=False, sort_keys=True, indent=2)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        descriptor = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def fingerprint(value):
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def load_state(directory):
    directory = safe_path(directory)
    info = directory.stat()
    if not directory.is_dir() or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) & 0o077:
        raise HealthError("告警状态目录权限不安全，未读取或修改状态。")
    path = private_file(Path(directory) / "state.json")
    if not path.exists():
        return {"version": 1, "channels": {}}
    try:
        state = json.loads(path.read_text())
        if type(state.get("version")) is not int or state["version"] != 1 or not isinstance(state.get("channels"), dict):
            raise ValueError()
        for identifier, channel in state["channels"].items():
            if not re.fullmatch(r"[0-9a-f]{64}", identifier) or not isinstance(channel, dict):
                raise ValueError()
            if channel.get("kind") not in ("telegram", "webhook") or not isinstance(channel.get("active"), dict):
                raise ValueError()
            for key, issue in channel["active"].items():
                validate_issue(key, issue)
                for field in ("last_sent", "first_seen"):
                    if type(issue.get(field)) not in (int, float) or not math.isfinite(issue[field]) or issue[field] < 0:
                        raise ValueError()
        return state
    except (ValueError, TypeError, AttributeError, KeyError):
        raise HealthError("告警状态损坏或版本不支持；已保留原文件，未重置去重状态。") from None


def validate_issue(key, issue):
    if (not isinstance(key, str) or not 1 <= len(key) <= 1024 or not isinstance(issue, dict)
            or issue.get("severity") not in ("warning", "critical")
            or not isinstance(issue.get("scope"), str) or not issue["scope"]
            or not isinstance(issue.get("message"), str) or not 1 <= len(issue["message"]) <= 8192):
        raise HealthError("告警对象格式无效，未更新通知状态。")


def observations(path):
    result = {"issues": {}, "checked": set(), "unknown": set(), "ignored": set()}
    for line in Path(path).read_text().splitlines():
        event = json.loads(line)
        kind = event.get("type")
        if kind in ("checked", "unknown") and isinstance(event.get("scope"), str) and event["scope"]:
            result[kind].add(event["scope"])
        elif kind == "ignored" and isinstance(event.get("key"), str):
            result["ignored"].add(event["key"])
        elif kind == "issue":
            key = event.get("key")
            issue = {k: event.get(k) for k in ("scope", "severity", "message")}
            validate_issue(key, issue)
            if key in result["issues"]:
                raise HealthError("巡检产生重复告警标识，未更新通知状态。")
            result["issues"][key] = issue
        else:
            raise HealthError("巡检事件无效，不能推断恢复。")
    if not result["checked"] and not result["unknown"]:
        raise HealthError("没有有效巡检结果，不能推断恢复。")
    return result


def scope_checked(scope, observed):
    return scope in observed["checked"] and not any(
        scope == value or scope.startswith(value + ".") or scope.startswith(value + ":")
        for value in observed["unknown"])


def configured_channels(environment):
    channels = []
    token, chat = environment.get("UA_HEALTH_TG_TOKEN", ""), environment.get("UA_HEALTH_TG_CHAT", "")
    if bool(token) != bool(chat):
        raise HealthError("Telegram 配置不完整，未更新通知状态。")
    if token:
        channels.append({"kind": "telegram", "id": fingerprint(["telegram", token, chat])})
    url, kind = environment.get("UA_HEALTH_WEBHOOK", ""), environment.get("UA_HEALTH_WEBHOOK_KIND", "")
    if url:
        if kind not in ("wecom", "feishu", "dingtalk", "discord", "bark"):
            raise HealthError("Webhook 类型无法识别，未更新通知状态。")
        channels.append({"kind": "webhook", "id": fingerprint(["webhook", kind, url])})
    if not channels:
        raise HealthError("尚未配置有效的告警渠道，未更新通知状态。")
    return channels


def notification_plan(state, observed, channels, cooldown, now):
    if type(cooldown) is not int or not 0 <= cooldown <= 604800 or not math.isfinite(now) or now < 0:
        raise HealthError("冷却时间须为 0–604800 秒；当前时间必须有效。")
    result = {"channels": {}, "unknown_scopes": sorted(observed["unknown"])}
    for channel in channels:
        previous = state["channels"].get(channel["id"], {"kind": channel["kind"], "active": {}})
        active = copy.deepcopy(previous["active"])
        send_keys, recover_keys, lines = [], [], []
        for key, current in sorted(observed["issues"].items()):
            if key in observed["ignored"] or not scope_checked(current["scope"], observed):
                continue
            old = active.get(key)
            changed = old is not None and old["severity"] != current["severity"]
            due = old is None or changed or now < old["last_sent"] or now - old["last_sent"] >= cooldown
            if not due:
                continue
            reason = "新故障" if old is None else "级别变化" if changed else "持续异常提醒"
            lines.append("[" + reason + "][" + current["severity"] + "] " + current["message"])
            active[key] = {**current, "first_seen": min(old["first_seen"], now) if old else now, "last_sent": now}
            send_keys.append(key)
        for key, old in sorted(previous["active"].items()):
            if not scope_checked(old["scope"], observed):
                result["unknown_scopes"].append(old["scope"])
            if key in observed["ignored"]:
                continue
            if key not in observed["issues"] and scope_checked(old["scope"], observed):
                lines.append("[已恢复] " + old["message"] + "（此前告警，当前该项检查正常）")
                active.pop(key, None)
                recover_keys.append(key)
        if not lines:
            continue
        title = "UA Box 状态恢复通知" if not send_keys else "UA Box 状态巡检异常告警"
        if send_keys and recover_keys:
            title = "UA Box 状态变化通知（异常及恢复）"
        result["channels"][channel["kind"]] = {
            "id": channel["id"], "kind": channel["kind"], "expected": fingerprint(previous),
            "active": active, "send_keys": send_keys, "recover_keys": recover_keys,
            "title": title, "body": "\n".join(lines), "planned_at": now}
    result["unknown_scopes"] = sorted(set(result["unknown_scopes"]))
    return result


def plan_delivery(directory, events_path, plan_path, cooldown, environment, now=None):
    cooldown = int(cooldown)
    if not 0 <= cooldown <= 604800:
        raise HealthError("冷却时间须为 0–604800 秒。")
    state = load_state(directory)
    observed = observations(events_path)
    channels = configured_channels(environment)
    # Explicitly ignored objects are retired silently, never described as recovered.
    changed = False
    for channel in state["channels"].values():
        for key in observed["ignored"]:
            if key in channel["active"]:
                del channel["active"][key]
                changed = True
    if changed:
        write_json(Path(directory) / "state.json", state)
    plan = notification_plan(state, observed, channels, int(cooldown), time.time() if now is None else now)
    write_json(plan_path, plan)
    return plan


def commit_delivery(directory, plan_path, kind, now=None):
    plan = json.loads(Path(plan_path).read_text())["channels"][kind]
    state = load_state(directory)
    previous = state["channels"].get(plan["id"], {"kind": kind, "active": {}})
    if fingerprint(previous) != plan["expected"]:
        raise HealthError("通知状态已变化，拒绝提交过期计划。")
    active = plan["active"]
    for key in plan["send_keys"]:
        active[key]["last_sent"] = time.time() if now is None else now
    state["channels"][plan["id"]] = {"kind": kind, "active": active}
    write_json(Path(directory) / "state.json", state)


def static_config(path):
    """Never source a shell configuration or evaluate expansion/substitution."""
    values, dynamic = {}, False
    for raw in Path(path).read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        match = re.fullmatch(r"([A-Z_][A-Z0-9_]*)=(.*)", line)
        if not match:
            dynamic = True
            continue
        try:
            tokens = shlex.split(match[2], comments=True)
        except ValueError:
            dynamic = True
            continue
        # Dynamic shell values are not used to choose paths or claim capabilities.
        if len(tokens) != 1 or re.search(r"[$`]|[;&<>|]", match[2]):
            dynamic = True
            continue
        values[match[1]] = tokens[0]
    return values, dynamic


def doctor(home, config, log_dir, backup_dir, state_dir):
    checks, capabilities = [], {}
    def record(identifier, status, message):
        checks.append({"id": identifier, "status": status, "message": message})
    def dependency(name, required=False):
        found = shutil.which(name) is not None
        record("dependency." + name, "PASS" if found else "FAIL" if required else "SKIP",
               name + (" 可用" if found else " 未安装；相关功能不可用"))
        return found
    record("platform", "PASS" if sys.platform.startswith("linux") else "FAIL", "平台为 Linux" if sys.platform.startswith("linux") else "需要 Linux")
    record("python", "PASS" if sys.version_info >= (3, 9) else "FAIL", "Python " + ".".join(map(str, sys.version_info[:3])) + "；恢复功能要求 ≥3.9")
    if dependency("bash", True):
        code, output = query(["bash", "--noprofile", "--norc", "-c", 'printf "%s" "${BASH_VERSINFO[0]}"'])
        record("bash.version", "PASS" if code == 0 and output.isdigit() and int(output) >= 4 else "FAIL", "Bash 主版本要求 ≥4")
    for name in ("readlink", "awk", "sed", "grep", "tar", "mktemp", "stat"):
        dependency(name, True)
    downloader = bool(shutil.which("curl") or shutil.which("wget"))
    record("download", "PASS" if downloader else "WARN", "下载工具可用" if downloader else "缺少 curl/wget；不会自动安装")
    values = {}
    config_path = Path(config)
    if not config_path.exists():
        record("config", "WARN", "配置文件不存在；只读诊断不会创建默认配置")
    elif not config_path.is_file() or config_path.is_symlink():
        record("config", "FAIL", "配置必须为普通文件；未执行配置")
    else:
        try:
            mode = stat.S_IMODE(config_path.stat().st_mode)
            owner_matches = config_path.stat().st_uid == os.geteuid()
            record("config.owner", "PASS" if owner_matches else "FAIL" if os.geteuid() == 0 else "WARN", "配置属主应与执行用户一致；未修改属主")
            record("config.permissions", "FAIL" if mode & 0o022 else "WARN" if mode & 0o077 else "PASS",
                   "配置权限 " + oct(mode) + "；建议 600，禁止其他用户写入")
            if config_path.stat().st_size > 1048576:
                raise ValueError()
            code, _ = query(["bash", "--noprofile", "--norc", "-n", str(config_path)])
            record("config.syntax", "PASS" if code == 0 else "FAIL", "仅检查 Bash 语法，不执行配置")
            values, dynamic = static_config(config_path)
            record("config.static", "WARN" if dynamic else "PASS", "配置含动态语句，相关值无法静态确认；未执行" if dynamic else "配置可静态读取；不显示配置值或凭据")
        except (OSError, ValueError, UnicodeError):
            record("config.read", "FAIL", "无法安全读取配置；未输出内容")
    for key, default in (("logs", log_dir), ("backups", backup_dir), ("notification-state", state_dir)):
        value = values.get({"logs": "UA_BOX_LOG_DIR", "backups": "UA_BOX_BACKUP_DIR", "notification-state": "UA_NOTIFY_STATE_DIR"}[key], default)
        path = Path(value)
        try:
            safe_path(path)
            nearest = path
            while not nearest.exists():
                nearest = nearest.parent
            valid = nearest.is_dir() and os.access(nearest, os.W_OK | os.X_OK)
            record("path." + key, "PASS" if valid else "WARN", key + (" 目录或最近父目录具备访问权限（未写入验证）" if valid else " 路径不可用；未创建或修改"))
            if key == "notification-state" and path.exists():
                info = path.stat()
                private = info.st_uid == os.geteuid() and not stat.S_IMODE(info.st_mode) & 0o077
                record("notification.permissions", "PASS" if private else "FAIL", "状态目录应由当前用户拥有，权限不大于 700")
                try:
                    load_state(path)
                    private_file(path / ".notify.lock")
                    record("notification.state", "PASS", "已有告警状态可读取；未修改")
                except (HealthError, OSError):
                    record("notification.state", "FAIL", "告警状态不可安全读取，不能可靠去重；未修改")
        except (OSError, HealthError):
            record("path." + key, "FAIL", key + " 路径不安全或不可访问；未修改")
    try:
        disk = Path(home)
        while not disk.exists():
            disk = disk.parent
        free = shutil.disk_usage(disk).free
        record("disk.free", "FAIL" if free < 128 * 1024**2 else "WARN" if free < 512 * 1024**2 else "PASS", "项目所在文件系统可用空间约 " + str(free // 1024**2) + " MiB（仅查询）")
    except OSError:
        record("disk.free", "WARN", "可用空间无法读取")
    docker_found = dependency("docker")
    capabilities["docker_readable"] = False
    capabilities["local_docker_recovery"] = False
    capabilities["compose_port_edit"] = False
    if docker_found:
        code, _ = query(["docker", "version", "--format", "{{.Server.Version}}"])
        capabilities["docker_readable"] = code == 0
        record("docker.daemon", "PASS" if code == 0 else "WARN", "Docker daemon 可只读访问" if code == 0 else "Docker daemon 不可访问或探测超时；未尝试启动")
        endpoint = os.environ.get("DOCKER_HOST") if not os.environ.get("DOCKER_CONTEXT") else None
        if not endpoint:
            args = ["docker", "context", "inspect"]
            if os.environ.get("DOCKER_CONTEXT"):
                args.append(os.environ["DOCKER_CONTEXT"])
            code, output = query(args)
            try:
                endpoint = json.loads(output)[0]["Endpoints"]["docker"]["Host"] if code == 0 else None
            except (ValueError, KeyError, IndexError, TypeError):
                endpoint = None
        local = bool(endpoint and endpoint.startswith("unix://"))
        capabilities["local_docker_recovery"] = local and capabilities["docker_readable"]
        record("docker.endpoint", "PASS" if local else "WARN", "本机 Unix Socket，满足自动恢复的连接前提" if local else "远程或未知连接，不支持自动恢复；不显示连接地址")
        code, _ = query(["docker", "compose", "version", "--short"])
        if code == 0:
            help_code, help_text = query(["docker", "compose", "config", "--help"])
            capabilities["compose_port_edit"] = help_code == 0 and "--format" in help_text
            record("docker.compose", "PASS" if capabilities["compose_port_edit"] else "WARN", "Compose 插件支持配置格式输出" if capabilities["compose_port_edit"] else "Compose 缺少可确认的配置格式输出能力")
        else:
            record("docker.compose", "WARN", "Compose 插件不可用；自动 Compose 端口切换不可用")
        dependency("dockerd")
    for name in ("rclone", "bbolt", "systemctl", "systemd-escape", "systemd-analyze"):
        dependency(name)
    fuse = bool(shutil.which("fusermount3") or shutil.which("fusermount")) and os.access("/dev/fuse", os.R_OK | os.W_OK)
    capabilities["rclone_mount_prerequisites"] = bool(shutil.which("rclone") and shutil.which("systemd-escape") and shutil.which("systemd-analyze") and fuse)
    record("rclone.fuse", "PASS" if fuse else "SKIP", "FUSE 工具及设备权限可用；未执行挂载" if fuse else "FUSE 工具或设备权限不足；挂载前需处理")
    capabilities["notification_prerequisites"] = bool(shutil.which("curl") and shutil.which("flock") and sys.version_info >= (3, 9))
    record("notification.dependencies", "PASS" if capabilities["notification_prerequisites"] else "WARN", "告警需要 Python ≥3.9、curl 和 flock；未发送测试消息")
    token, chat = values.get("UA_NOTIFY_TG_BOT_TOKEN", ""), values.get("UA_NOTIFY_TG_CHAT_ID", "")
    webhook = values.get("UA_NOTIFY_WEBHOOK_URL", "")
    capabilities["notification_configured"] = bool(token and chat or webhook)
    if bool(token) != bool(chat):
        record("notification.configuration", "WARN", "Telegram 参数不完整；不显示凭据")
    else:
        record("notification.configuration", "PASS" if capabilities["notification_configured"] else "SKIP",
               "静态配置中存在通知渠道；未验证远端送达" if capabilities["notification_configured"] else "未发现可静态确认的通知渠道")
    cooldown = values.get("UA_NOTIFY_COOLDOWN_SECONDS", "3600")
    record("notification.cooldown", "PASS" if cooldown.isdigit() and 0 <= int(cooldown) <= 604800 else "FAIL", "冷却时间必须为 0–604800 秒；默认 3600 秒")
    code = 2 if any(check["status"] == "FAIL" for check in checks) else 1 if any(check["status"] == "WARN" for check in checks) else 0
    return {"read_only": True, "checks": checks, "capabilities": capabilities, "exit_code": code}



CRON_MARKER = "# ua-box:status-notify"


def owned_notify_cron(line, executable, script):
    content = line.strip()
    if not content or content.startswith("#"):
        return False
    if content.endswith(" " + CRON_MARKER):
        return True
    fields = content.split(None, 5)
    if len(fields) != 6 or fields[:5] != ["*/30", "*", "*", "*", "*"]:
        return False
    try:
        command = shlex.split(fields[5])
    except ValueError:
        return False
    # Only the exact legacy command generated by UA Box is migrated.
    aliases = {executable, script}
    return len(command) == 5 and command[0] in aliases and command[1:] == ["status", "--notify", ">/dev/null", "2>&1"]


def notify_cron_plan(content, executable, script, action):
    if action not in ("enable", "disable") or not Path(executable).is_absolute() or any(ord(c) < 32 or ord(c) == 127 for c in executable):
        raise HealthError("定时任务参数无效，未修改。")
    retained = [line for line in content.splitlines(keepends=True) if not owned_notify_cron(line, executable, script)]
    result = "".join(retained)
    if action == "enable":
        if result and not result.endswith("\n"):
            result += "\n"
        # crond interprets '%' before the shell, including inside quoted strings.
        command = shlex.quote(executable).replace("%", "\\%")
        result += "*/30 * * * * " + command + " status --notify >/dev/null 2>&1 " + CRON_MARKER + "\n"
    return result

def main(args=None):
    args = sys.argv[1:] if args is None else args
    try:
        command, *args = args
        if command == "doctor":
            paths, options = args[:5], args[5:]
            if options not in ([], ["--json"]):
                raise HealthError("用法: ua doctor [--json]")
            try:
                report = doctor(*paths)
            except (OSError, ValueError, HealthError):
                report = {"read_only": True, "checks": [{"id": "diagnostic", "status": "FAIL", "message": "部分路径或配置无法安全读取；未修改"}],
                          "capabilities": {}, "exit_code": 2}
            if options:
                print(json.dumps(report, ensure_ascii=False, indent=2))
            else:
                print("UA Box 只读诊断（不执行配置、不安装、不修复、不启动服务）")
                for check in report["checks"]:
                    print("[" + check["status"] + "] " + check["id"] + ": " + check["message"])
                print("退出码: 0=检查通过，1=存在提醒，2=存在错误；能力检查不等同于业务验收。")
            return report["exit_code"]
        if command == "cron-plan":
            source, destination, executable, script, action = args
            content = Path(source).read_bytes().decode()
            Path(destination).write_text(notify_cron_plan(content, executable, script, action))
        elif command == "cron-status":
            source, executable, script = args
            lines = Path(source).read_bytes().decode().splitlines()
            count = sum(owned_notify_cron(line, executable, script) for line in lines)
            print("已开启（" + str(count) + " 条 UA Box 任务）" if count else "未开启")
        elif command == "state-init":
            prepare_state(*args)
        elif command == "state-plan":
            plan_delivery(*args, environment=os.environ)
        elif command == "state-commit":
            commit_delivery(*args)
        elif command == "plan-field":
            plan = json.loads(Path(args[0]).read_text())
            value = plan["channels"].get(args[1])
            if value is None:
                return 3
            print(value[args[2]])
        elif command == "plan-summary":
            plan = json.loads(Path(args[0]).read_text())
            print("计划通知渠道数: " + str(len(plan["channels"])))
            if plan["unknown_scopes"]:
                print("部分检查未完成或已跳过；这些对象不会被判定恢复。")
            if not plan["channels"]:
                print("没有需要发送的状态变化：正常或仍在冷却期。")
        else:
            raise HealthError("未知健康检查命令。")
    except HealthError as error:
        print("诊断/告警处理失败：" + str(error), file=sys.stderr)
        return 2
    except (OSError, ValueError, TypeError, KeyError):
        # Raw probe/config/state errors may contain credentials; never echo their contents.
        print("诊断/告警处理失败：参数、探测结果或私有状态不可用；原状态未被重置。", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
PY_UA_HEALTH
}

ua_health_operation() {
  has_cmd python3 || { echo "需要 Python 3，只读诊断及告警不会自动安装依赖。" >&2; return 2; }
  python3 -B -c "$(ua_health_program)" "$@"
}

ua_doctor() {
  if ! has_cmd python3; then
    if [ "${1:-}" = --json ]; then
      printf '%s\n' '{"read_only":true,"checks":[{"id":"python","status":"FAIL","message":"缺少 Python 3；未自动安装"}],"capabilities":{},"exit_code":2}'
    else
      echo "[FAIL] 缺少 Python 3；只读诊断不会安装依赖。"
    fi
    return 2
  fi
  ua_health_operation doctor "$UA_BOX_HOME" "$UA_BOX_CONFIG" "$UA_BOX_LOG_DIR" "$UA_BOX_BACKUP_DIR" "${UA_NOTIFY_STATE_DIR:-$UA_BOX_HOME/state/notify}" "$@"
}

ua_notify_serialized() {
  (
  trap 'exit 130' INT
  trap 'exit 143' TERM
  umask 077
  has_cmd python3 && has_cmd curl && has_cmd flock || { echo "告警去重需要 Python 3、curl 和 flock；未自动安装。" >&2; exit 1; }
  local state_dir="${UA_NOTIFY_STATE_DIR:-$UA_BOX_HOME/state/notify}" notify_fd lock_rc
  local events summary plan channel title body field_rc webhook_kind="" failed=0
  ua_health_operation state-init "$state_dir" || exit 1
  exec {notify_fd}>> "$state_dir/.notify.lock" || exit 1
  if flock -n "$notify_fd"; then
    :
  else
    lock_rc=$?
    [ "$lock_rc" -eq 1 ] && { echo "已有巡检正在运行，本次跳过。"; exit 0; }
    echo "告警锁不可用，未执行通知。" >&2; exit 1
  fi
  events="$(mktemp "$UA_BOX_TMP_DIR/alert-events.XXXXXX")" || exit 1
  summary="$(mktemp "$UA_BOX_TMP_DIR/alert-summary.XXXXXX")" || exit 1
  plan="$(mktemp "$UA_BOX_TMP_DIR/alert-plan.XXXXXX")" || exit 1
  local UA_ALERT_EVENTS_FILE="$events" _UA_ALERT_RECORD_FAILED=0
  if ! ua_abnormal_summary > "$summary" 2>&1 || [ "$_UA_ALERT_RECORD_FAILED" -ne 0 ]; then
    echo "巡检或事件记录失败，未更新告警状态。" >&2
    exit 1
  fi
  [ -z "${UA_NOTIFY_WEBHOOK_URL:-}" ] || webhook_kind="$(ua_webhook_kind)" || { echo "Webhook 类型无法识别，未更新状态。" >&2; exit 1; }
  UA_HEALTH_TG_TOKEN="${UA_NOTIFY_TG_BOT_TOKEN:-}" UA_HEALTH_TG_CHAT="${UA_NOTIFY_TG_CHAT_ID:-}" \
    UA_HEALTH_WEBHOOK="${UA_NOTIFY_WEBHOOK_URL:-}" UA_HEALTH_WEBHOOK_KIND="$webhook_kind" \
    ua_health_operation state-plan "$state_dir" "$events" "$plan" "${UA_NOTIFY_COOLDOWN_SECONDS:-3600}" || exit 1
  ua_health_operation plan-summary "$plan" || exit 1
  for channel in telegram webhook; do
    field_rc=0
    title="$(ua_health_operation plan-field "$plan" "$channel" title)" || field_rc=$?
    if [ "$field_rc" -ne 0 ]; then
      [ "$field_rc" -eq 3 ] || failed=1
      continue
    fi
    body="$(ua_health_operation plan-field "$plan" "$channel" body)" || { failed=1; continue; }
    if ua_send_notification "$title" "$body" "$channel"; then
      ua_health_operation state-commit "$state_dir" "$plan" "$channel" || {
        echo "平台已确认，但告警状态保存失败；下次可能重复通知。" >&2; failed=1;
      }
    else
      echo "$channel 未确认送达，保留待重试状态。" >&2
      failed=1
    fi
  done
  [ "$failed" -eq 0 ]
  )
}

ua_notification_post() {
  local kind="$1" url="$2" payload="$3" response status
  response="$(mktemp "$UA_BOX_TMP_DIR/notify.XXXXXX")" || return 1
  if ! status="$(curl -sS --max-time 15 --output "$response" --write-out '%{http_code}' \
    -X POST "$url" -H 'Content-Type: application/json' -d "$payload" 2>/dev/null)"; then
    rm -f -- "$response"
    return 1
  fi
  if run_recovery_operation notify-verify "$kind" "$status" "$response" >/dev/null 2>&1; then
    rm -f -- "$response"
    return 0
  fi
  rm -f -- "$response"
  return 1
}

ua_webhook_kind() {
  case "${UA_NOTIFY_WEBHOOK_TYPE:-auto}" in
    wecom|feishu|dingtalk|discord|bark) printf '%s\n' "$UA_NOTIFY_WEBHOOK_TYPE"; return 0 ;;
    auto|"") ;;
    *) return 1 ;;
  esac
  case "$UA_NOTIFY_WEBHOOK_URL" in
    https://qyapi.weixin.qq.com/*) echo wecom ;;
    https://open.feishu.cn/*|https://open.larksuite.com/*) echo feishu ;;
    https://oapi.dingtalk.com/*) echo dingtalk ;;
    https://discord.com/*|https://discordapp.com/*) echo discord ;;
    https://api.day.app/*) echo bark ;;
    *) return 1 ;;
  esac
}

ua_send_notification() {
  local title="$1" body="$2" channel="${3:-all}" full_text payload kind sent_any=0 failed=0
  case "$channel" in all|telegram|webhook) ;; *) return 1 ;; esac
  has_cmd python3 || { echo "需要 python3 生成及验证通知。" >&2; return 1; }
  full_text="【${title}】
主机: $(hostname 2>/dev/null || echo unknown)
时间: $(date '+%Y-%m-%d %H:%M:%S %Z')
${body}"
  if [ "$channel" != webhook ] && [ -n "${UA_NOTIFY_TG_BOT_TOKEN:-}" ] && [ -n "${UA_NOTIFY_TG_CHAT_ID:-}" ]; then
    payload="$(python3 -c 'import json,sys; print(json.dumps({"chat_id":sys.argv[1],"text":sys.argv[2]}))' "$UA_NOTIFY_TG_CHAT_ID" "$full_text")" || return 1
    if ua_notification_post telegram "https://api.telegram.org/bot${UA_NOTIFY_TG_BOT_TOKEN}/sendMessage" "$payload"; then
      echo "Telegram 已确认接收。"; sent_any=1
    else
      echo "Telegram 发送或平台确认失败。" >&2; failed=1
    fi
  fi
  if [ "$channel" != telegram ] && [ -n "${UA_NOTIFY_WEBHOOK_URL:-}" ]; then
    if kind="$(ua_webhook_kind)" && payload="$(run_recovery_operation notify-payload "$kind" "$title" "$full_text")" &&
       ua_notification_post "$kind" "$UA_NOTIFY_WEBHOOK_URL" "$payload"; then
      echo "Webhook 平台已确认接收。"; sent_any=1
    else
      echo "Webhook 类型未知、发送失败或平台未确认；请核对渠道配置。" >&2; failed=1
    fi
  fi
  [ "$sent_any" -eq 1 ] || { echo "没有通知渠道确认成功。" >&2; return 1; }
  [ "$failed" -eq 0 ] || return 1
  log_action "notification delivery acknowledged" || echo "通知已确认，但审计日志写入失败。" >&2
  return 0
}

ua_status_notify() {
  local force_test="${1:-}"
  if [ "$force_test" = "--test" ] || [ "$force_test" = test ]; then
    ua_send_notification "UA Box 告警通道测试" "这是一条测试通知；测试不会改变去重或恢复状态。"
    return $?
  fi
  ua_notify_serialized
}

ua_crontab_read() {
  local destination="$1" rc=0
  LC_ALL=C crontab -l > "$destination" 2> "${destination}.stderr" || rc=$?
  [ "$rc" -eq 0 ] && return 0
  if [ "$rc" -eq 1 ] && [ ! -s "$destination" ] &&
     grep -Eq '^(crontab: )?no crontab for [a-zA-Z0-9_.-]+$' "${destination}.stderr"; then
    return 0
  fi
  echo "无法确认当前定时任务，未覆盖或清空。" >&2
  return 1
}

ua_notify_cron_status() {
  local current ua_bin="/usr/local/bin/ua" script="${SCRIPT_REAL_PATH:-$UA_BOX_HOME/ua-box}"
  has_cmd crontab || { echo "未安装 crontab"; return 1; }
  if [ ! -x "$ua_bin" ] || [ "$(readlink -f -- "$ua_bin")" != "$(readlink -f -- "$script")" ]; then ua_bin="$script"; fi
  current="$(mktemp "$UA_BOX_TMP_DIR/cron-status.XXXXXX")" || return 1
  ua_crontab_read "$current" || { echo "读取失败，状态未知"; return 1; }
  ua_health_operation cron-status "$current" "$ua_bin" "$script"
}

ua_notify_cron_update() {
  (
  umask 077
  local action="$1" state_dir="${UA_NOTIFY_STATE_DIR:-$UA_BOX_HOME/state/notify}" lock_fd
  local current planned check verify backup ua_bin="/usr/local/bin/ua" script="${SCRIPT_REAL_PATH:-$UA_BOX_HOME/ua-box}"
  need_root || exit 1
  has_cmd crontab && has_cmd flock || { echo "缺少 crontab/flock，未修改任务。" >&2; exit 1; }
  case "$action" in enable|disable) ;; *) exit 1 ;; esac
  if [ ! -x "$ua_bin" ] || [ "$(readlink -f -- "$ua_bin")" != "$(readlink -f -- "$script")" ]; then ua_bin="$script"; fi
  [ "$action" != enable ] || [ -x "$ua_bin" ] || { echo "当前脚本不可执行，未开启定时任务。" >&2; exit 1; }
  ua_health_operation state-init "$state_dir" || exit 1
  exec {lock_fd}>> "$state_dir/.notify.lock" || exit 1
  flock -w 5 "$lock_fd" || { echo "巡检或任务设置正在运行，请稍后重试。" >&2; exit 1; }
  current="$(mktemp "$UA_BOX_TMP_DIR/cron-current.XXXXXX")" || exit 1
  planned="$(mktemp "$UA_BOX_TMP_DIR/cron-plan.XXXXXX")" || exit 1
  check="$(mktemp "$UA_BOX_TMP_DIR/cron-check.XXXXXX")" || exit 1
  verify="$(mktemp "$UA_BOX_TMP_DIR/cron-verify.XXXXXX")" || exit 1
  ua_crontab_read "$current" || exit 1
  ua_health_operation cron-plan "$current" "$planned" "$ua_bin" "$script" "$action" || exit 1
  cmp -s "$current" "$planned" && { echo "UA Box 定时任务已符合所选状态。"; exit 0; }
  mkdir -p "$UA_BOX_BACKUP_DIR" || exit 1
  backup="$(mktemp "$UA_BOX_BACKUP_DIR/crontab-before-$(date +%Y%m%d-%H%M%S).XXXXXX.bak")" || exit 1
  if ! cp "$current" "$backup" || ! cmp -s "$current" "$backup"; then
    rm -f -- "$backup"  # 只移除本次 mktemp 创建、未通过校验的副本。
    echo "原任务保护副本未完成，未应用。" >&2; exit 1
  fi
  ua_crontab_read "$check" || exit 1
  cmp -s "$current" "$check" || { echo "定时任务被其他进程修改，已停止写入。" >&2; exit 1; }
  if ! crontab "$planned"; then
    echo "定时任务安装失败，未认定成功。原任务副本: $backup" >&2; exit 1
  fi
  ua_crontab_read "$verify" && cmp -s "$verify" "$planned" || { echo "任务写入结果未确认，请核对。原任务副本: $backup" >&2; exit 1; }
  log_action "notify cron $action verified; previous crontab retained" || true
  echo "UA Box 定时任务 $action 已核验；原任务副本: $backup"
  )
}

ua_notify_menu() {
  while true; do
    clear
    local tg_stat wh_stat cron_stat choice
    if [ -n "${UA_NOTIFY_TG_BOT_TOKEN:-}" ] && [ -n "${UA_NOTIFY_TG_CHAT_ID:-}" ]; then
      tg_stat="${gl_lv}已配置 (Chat ID: ${UA_NOTIFY_TG_CHAT_ID})${gl_bai}"
    else
      tg_stat="${gl_hui}未配置${gl_bai}"
    fi
    if [ -n "${UA_NOTIFY_WEBHOOK_URL:-}" ]; then
      wh_stat="${gl_lv}已配置${gl_bai}"
    else
      wh_stat="${gl_hui}未配置${gl_bai}"
    fi
    cron_stat="$(ua_notify_cron_status)" || cron_stat="${cron_stat:-读取失败，状态未知}"

    echo -e "${gl_kjlan}状态巡检主动告警推送 (Telegram / Webhook)${gl_bai}"
    echo -e "${gl_kjlan}------------------------${gl_bai}"
    echo -e "Telegram Bot:  ${tg_stat}"
    echo -e "Webhook 通知:  ${wh_stat}"
    echo -e "定时自动巡检:  ${cron_stat}"
    echo -e "${gl_kjlan}------------------------${gl_bai}"
    echo -e "${gl_kjlan}1.  ${gl_bai}配置 Telegram Bot (Token & Chat ID)"
    echo -e "${gl_kjlan}2.  ${gl_bai}配置通用 Webhook URL (兼容企微/飞书/钉钉/Discord/Bark)"
    echo -e "${gl_kjlan}3.  ${gl_bai}发送测试告警通知"
    echo -e "${gl_kjlan}4.  ${gl_bai}立即执行一次异常巡检并推送 (ua status --notify)"
    echo -e "${gl_kjlan}5.  ${gl_bai}开启 Cron 定时自动巡检告警 (每 30 分钟)"
    echo -e "${gl_kjlan}6.  ${gl_bai}关闭 Cron 定时自动巡检告警"
    echo "7.  设置重复告警冷却时间（当前 ${UA_NOTIFY_COOLDOWN_SECONDS:-3600} 秒，恢复立即通知）"
    echo -e "${gl_kjlan}0.  ${gl_bai}返回"
    echo -e "${gl_kjlan}------------------------${gl_bai}"
    read -r -e -p "请输入你的选择: " choice || break

    case "$choice" in
      1)
        local token chat_id
        read -r -e -p "请输入 Telegram Bot Token (留空清除): " token
        read -r -e -p "请输入 Telegram Chat ID (留空清除): " chat_id
        config_set_var "UA_NOTIFY_TG_BOT_TOKEN" "$token" || { pause; continue; }
        config_set_var "UA_NOTIFY_TG_CHAT_ID" "$chat_id" || { pause; continue; }
        echo -e "${gl_lv}Telegram 告警配置已保存。${gl_bai}"
        pause
        ;;
      2)
        local wh_url wh_type
        read -r -e -p "请输入 Webhook URL (留空清除): " wh_url
        read -r -e -p "渠道类型 auto/wecom/feishu/dingtalk/discord/bark，回车自动识别: " wh_type || { pause; continue; }
        wh_type="${wh_type:-auto}"
        case "$wh_type" in auto|wecom|feishu|dingtalk|discord|bark) ;; *) echo "未知类型。"; pause; continue ;; esac
        config_set_var "UA_NOTIFY_WEBHOOK_TYPE" "$wh_type" || { pause; continue; }
        config_set_var "UA_NOTIFY_WEBHOOK_URL" "$wh_url" || { pause; continue; }
        echo -e "${gl_lv}Webhook 告警配置已保存。${gl_bai}"
        pause
        ;;
      3)
        ua_status_notify --test
        pause
        ;;
      4)
        ua_status_notify
        pause
        ;;
      5)
        if ua_notify_cron_update enable; then
          echo "已核验每 30 分钟巡检任务。"
        else
          echo "定时任务设置未完成。" >&2
        fi
        pause
        ;;
      6)
        if ua_notify_cron_update disable; then
          echo "已核验 UA Box 自动巡检任务已关闭。"
        else
          echo "关闭操作未完成，请核对实际任务。" >&2
        fi
        pause
        ;;
      7)
        local cooldown
        read -r -e -p "冷却秒数 0–604800（0 表示每次提醒，回车取消）: " cooldown || break
        [ -n "$cooldown" ] || continue
        if [[ "$cooldown" =~ ^[0-9]{1,6}$ ]] && ((10#$cooldown <= 604800)); then
          config_set_var UA_NOTIFY_COOLDOWN_SECONDS "$((10#$cooldown))"
        else
          echo "冷却时间无效。"
        fi
        pause
        ;;
      0) break ;;
      *) echo "无效输入"; pause ;;
    esac
  done
}

ua_export_bundle() {
  need_root || return 1
  mkdir -p "$UA_BOX_BACKUP_DIR"

  local rclone_dest="${1:-}"
  local items=()
  local candidate
  local rclone_cfg=""
  if has_cmd rclone; then
    rclone_cfg="$(rclone_config_file_path 2>/dev/null)"
  fi

  for candidate in \
    "$UA_BOX_CONFIG" \
    "/etc/caddy/Caddyfile" \
    "/root/caddy" \
    "/root/caddy_data" \
    "/root/caddy_config" \
    "/root/openlist" \
    "/root/filebrowser" \
    "/root/uptime-kuma" \
    "/root/nginx-proxy-manager" \
    "/root/it-tools" \
    "$rclone_cfg"; do
    [ -z "$candidate" ] && continue
    if [ -e "$candidate" ]; then
      items+=("${candidate#/}")
    fi
  done

  # 附加 systemd rclone-mount 服务文件
  local svc_file
  for svc_file in /etc/systemd/system/rclone-mount-*.service; do
    [ -f "$svc_file" ] && items+=("${svc_file#/}")
  done

  if [ "${#items[@]}" -eq 0 ]; then
    echo "未找到可导出的面板配置或数据目录。"
    return 1
  fi

  local host_tag archive_name archive_path
  host_tag="$(hostname 2>/dev/null | tr -cd 'a-zA-Z0-9-' || echo 'server')"
  [ -z "$host_tag" ] && host_tag="server"
  archive_name="ua-migration-${host_tag}-$(date '+%Y%m%d-%H%M%S').tar.gz"
  archive_path="$UA_BOX_BACKUP_DIR/$archive_name"

  echo -e "${gl_kjlan}正在打包以下配置与面板数据目录：${gl_bai}"
  local it
  for it in "${items[@]}"; do
    echo "  - /$it"
  done

  local absolute_items=()
  for candidate in "${items[@]}"; do absolute_items+=("/$candidate"); done
  archive_name="ua-migration-${host_tag}-$(date '+%Y%m%d-%H%M%S')-$$-${RANDOM}.tar.gz"
  archive_path="$UA_BOX_BACKUP_DIR/$archive_name"
  if run_recovery_operation export "$archive_path" "${absolute_items[@]}"; then
    log_action "export migration bundle verified $archive_path"
    echo -e "${gl_lv}✓ 数据库与归档独立验证通过: $archive_path${gl_bai}"
  else
    echo -e "${gl_hong}备份未通过验证，未报告备份成功。请先停止所有数据写入者。${gl_bai}"
    return 1
  fi

  # 支持命令行直接指定 rclone 目标或交互式询问上传
  if [ -n "$rclone_dest" ]; then
    rclone_require || return 1
    echo "正在通过 rclone 上传备份至 ${rclone_dest} ..."
    rclone copy "$archive_path" "$rclone_dest" -P && echo -e "${gl_lv}✓ 已上传至远程网盘: ${rclone_dest}${gl_bai}"
    return $?
  fi

  if [ -t 0 ] && has_cmd rclone; then
    local remotes_list=()
    mapfile -t remotes_list < <(rclone listremotes 2>/dev/null | sed 's/:$//')
    if [ "${#remotes_list[@]}" -gt 0 ]; then
      echo ""
      read -r -e -p "检测到已配置 rclone 远程网盘，是否同时将备份包上传至云端？[y/N]: " up_cloud
      if [[ "$up_cloud" =~ ^[Yy]$ ]]; then
        local sel_remote
        sel_remote="$(select_with_fzf_or_menu '选择要上传到的 rclone remote' "${remotes_list[@]}")"
        if [ -n "$sel_remote" ]; then
          local remote_dir="ua-box-backups"
          read -r -e -p "请输入远程目录名 (默认 ua-box-backups): " input_rdir
          remote_dir="${input_rdir:-ua-box-backups}"
          echo "正在上传到 ${sel_remote}:${remote_dir} ..."
          if rclone copy "$archive_path" "${sel_remote}:${remote_dir}" -P; then
            log_action "upload migration bundle to ${sel_remote}:${remote_dir}"
            echo -e "${gl_lv}✓ 已成功上传到远程网盘: ${sel_remote}:${remote_dir}/${archive_name}${gl_bai}"
          else
            echo -e "${gl_hong}✗ 上传至远程网盘失败。${gl_bai}"
          fi
        fi
      fi
    fi
  fi
}

restore_migration_archive() {
  local rclone_cfg="/root/.config/rclone/rclone.conf"
  if has_cmd rclone; then
    rclone_cfg="$(rclone_config_file_path)" || return 1
  fi
  run_recovery_operation restore "$1" "$2" "$UA_BOX_CONFIG" "$rclone_cfg" "$UA_BOX_BACKUP_DIR"
}

ua_import_bundle() {
  need_root || return 1
  local archive_path="${1:-}"

  if [ -z "$archive_path" ]; then
    local local_bundles=()
    local f
    while IFS= read -r f; do
      [ -n "$f" ] && [ -f "$f" ] && local_bundles+=("$f")
    done < <(ls -1td "$UA_BOX_BACKUP_DIR"/ua-migration-*.tar.gz 2>/dev/null)

    if [ "${#local_bundles[@]}" -gt 0 ]; then
      echo -e "${gl_kjlan}检测到本地有以下迁移备份包：${gl_bai}"
      local idx=1
      for f in "${local_bundles[@]}"; do
        echo "  ${idx}) $(basename "$f") ($(du -h "$f" 2>/dev/null | awk '{print $1}'))"
        idx=$((idx + 1))
      done
      echo "  m) 手动输入归档文件完整路径"
      echo "  0) 取消"
      local sel
      read -r -e -p "请选择要恢复的备份序号或输入 m: " sel
      if [ -z "$sel" ] || [ "$sel" = "0" ]; then
        echo "已取消。"
        return 0
      elif [ "$sel" = "m" ] || [ "$sel" = "M" ]; then
        read -r -e -p "请输入 .tar.gz 备份包完整路径: " archive_path
      elif printf '%s\n' "$sel" | grep -Eq '^[0-9]+$' && [ "$sel" -ge 1 ] && [ "$sel" -le "${#local_bundles[@]}" ]; then
        archive_path="${local_bundles[$((sel - 1))]}"
      else
        echo "无效选择。"
        return 1
      fi
    else
      read -r -e -p "请输入要恢复的 .tar.gz 备份包完整路径 (回车取消): " archive_path
    fi
  fi

  [ -z "$archive_path" ] && echo "已取消。" && return 0
  if [ ! -f "$archive_path" ]; then
    echo -e "${gl_hong}错误: 备份文件不存在: $archive_path${gl_bai}"
    return 1
  fi

  echo "正在检查归档路径、文件类型与配置内容..."
  restore_migration_archive "$archive_path" check || return 1
  if confirm_danger "覆盖恢复面板配置与数据；请先停止相关服务以保证数据一致性" "$archive_path"; then
    if restore_migration_archive "$archive_path" apply; then
