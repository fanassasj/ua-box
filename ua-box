    if has_cmd fail2ban-client && systemctl is-active fail2ban >/dev/null 2>&1; then
      banned_ips="$(fail2ban-client status sshd 2>/dev/null | grep -i 'Banned IP list:' | awk -F: '{print $2}' | sed 's/^[[:space:]]*//')"
      echo -e "SSH 正在封禁 IP: ${gl_hong}${banned_ips:-无}${gl_bai}"
