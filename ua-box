download_to() {
  local url="$1"
  local output="$2"

  log_action "download -> $output (URL omitted)"

  try_dl() {
    local target_url="$1"
    if has_cmd curl; then
      curl --connect-timeout 8 --max-time 120 -fsSL "$target_url" -o "$output"
    elif has_cmd wget; then
      wget --timeout=10 -qO "$output" "$target_url"
    else
      echo "未找到 curl/wget，先安装基础下载工具。"
      install_pkg curl wget || return 1
      curl --connect-timeout 8 --max-time 120 -fsSL "$target_url" -o "$output"
    fi
  }

  if try_dl "$url"; then
    return 0
  fi

  if [[ "$url" =~ github\.com ]] || [[ "$url" =~ raw\.githubusercontent\.com ]]; then
    echo -e "${gl_huang}直连 GitHub 超时，自动尝试加速代理池...${gl_bai}"
    local proxy proxy_list
    proxy_list="${GITHUB_PROXY_URLS:-https://ghp.ci https://gh-proxy.com https://ghproxy.net}"
    # shellcheck disable=SC2086
    for proxy in $proxy_list; do
      proxy="${proxy%/}"
      [ -z "$proxy" ] && continue
      echo "尝试加速源: ${proxy}/..."
      if try_dl "${proxy}/${url}"; then
        return 0
      fi
    done
    return 1
  else
    return 1
  fi
}

download_first_to() {
  local output="$1"
  shift

  local url
  for url in "$@"; do
    [ -z "$url" ] && continue
    echo "尝试下载: $url"
    if download_to "$url" "$output"; then
      echo "$url" > "${output}.source"
      return 0
    fi
    echo "下载失败，切换备用源。"
  done

  echo "所有下载源都不可用。"
  return 1
}

