def safe_config(text):
    lexer = shlex.shlex(text, posix=True, punctuation_chars=";&|<>()")
    lexer.whitespace_split = True
    seen, assignments = set(), []
    for token in lexer:
        name, sep, value = token.partition("=")
        if not sep or name not in CONFIG_NAMES or name in seen:
            raise RecoveryError("迁移配置含未知配置名、重复项或可执行语法: " + name)
        seen.add(name)
        if value not in ("$" + name, "${" + name + "}"):
            assignments.append(name + "=" + shlex.quote(value))
    return "# UA Box 已校验的迁移配置\n" + "\n".join(assignments) + "\n"


def sqlite_verify(path):
    # Only call on an independent copy. SQLite may create SHM files when reading WAL.
    with contextlib.closing(sqlite3.connect(str(path))) as database:
        result = database.execute("PRAGMA integrity_check").fetchall()
        if result != [("ok",)]:
            raise RecoveryError("SQLite 完整性检查失败: " + str(path))
        if database.execute("PRAGMA foreign_key_check").fetchone() is not None:
            raise RecoveryError("SQLite 外键完整性检查失败: " + str(path))
        schema = database.execute("SELECT type,name,sql FROM sqlite_master ORDER BY type,name").fetchall()
        return {"engine": "sqlite", "schema_sha256": hashlib.sha256(json.dumps(schema).encode()).hexdigest()}


def normalize_sqlite(path):
    destination = path.with_name(path.name + ".ua-snapshot")
    if destination.exists():
        raise RecoveryError("备份暂存文件冲突: " + str(destination))
    with contextlib.closing(sqlite3.connect(str(path))) as source, contextlib.closing(sqlite3.connect(str(destination))) as target:
        source.backup(target)
        target.commit()
        target.execute("PRAGMA journal_mode=DELETE")
    report = sqlite_verify(destination)
    shutil.copystat(path, destination)
    if os.geteuid() == 0:
        info = path.stat()
        os.chown(destination, info.st_uid, info.st_gid)
    os.replace(destination, path)
    for suffix in ("-wal", "-shm", "-journal"):
        companion = Path(str(path) + suffix)
        if companion.exists():
            companion.unlink()  # Only an independent staging copy, never the source database.
    return report


def bbolt_verify(path):
    binary = shutil.which("bbolt")
    if not binary:
        raise RecoveryError("检测到 Bolt/bbolt 数据库；缺少 bbolt check，不能认定备份有效。")
    subprocess.run([binary, "check", str(path)], check=True, capture_output=True, timeout=120)
    return {"engine": "bbolt", "check": "ok"}


def inspect_databases(tree, normalize=False, expected=()):
    tree = Path(tree)
    candidates = [tree] if tree.is_file() else sorted(p for p in tree.rglob("*") if p.is_file())
    found = {}
    normalized_companions = set()
    for path in candidates:
        if path in normalized_companions and not path.exists():
            continue
        relative = "." if tree.is_file() else path.relative_to(tree).as_posix()
        if path.name in ("config.json", "db-config.json"):
            try:
                config = json.loads(path.read_text())
            except (ValueError, UnicodeError):
                raise RecoveryError("无法识别数据库配置: " + str(path))
            database = config.get("database", config if path.name == "db-config.json" else {})
            kind = database.get("type", "sqlite3")
            if kind not in ("sqlite", "sqlite3", ""):
                raise RecoveryError("检测到外部数据库 " + str(kind) + "；需要独立逻辑备份和恢复演练，自动操作已阻止。")
        with path.open("rb") as stream:
            header = stream.read(32)
        report = None
        if header.startswith(b"SQLite format 3\x00"):
            report = normalize_sqlite(path) if normalize else sqlite_verify(path)
            if normalize:
                normalized_companions.update(Path(str(path) + suffix) for suffix in ("-wal", "-shm", "-journal"))
        elif len(header) >= 24 and struct.unpack_from("<I", header, 16)[0] == 0xED0CDAED:
            report = bbolt_verify(path)
        elif path.suffix.lower() in (".db", ".sqlite", ".sqlite3"):
            raise RecoveryError("数据库损坏、为空或格式不受支持: " + str(path))
        if report:
            found[relative] = report
    for name in expected:
        if name not in found:
            raise RecoveryError("数据库备份缺失: " + name)
    return found


def is_npm(runtime):
    image = ((runtime.get("Config", {}).get("Labels") or {}).get("ua.recovery.image_ref")
             or runtime.get("Config", {}).get("Image", ""))
    return "nginx-proxy-manager" in image.lower()


def npm_config_file(runtime, environment):
    """Read the selected container config, including image-layer/legacy overrides, without exec."""
    directory = environment.get("NODE_CONFIG_DIR", "./config")
    mode = environment.get("NODE_ENV", "default")
    working = runtime.get("Config", {}).get("WorkingDir")
    if not isinstance(working, str) or not working.startswith("/") or not re.fullmatch(r"[A-Za-z0-9_-]+", mode):
        raise RecoveryError("NPM 配置来源无法确认。")
    path = PurePosixPath(directory)
    if not path.is_absolute():
        path = PurePosixPath(working) / path
    if ".." in path.parts:
        raise RecoveryError("NPM 配置来源无法确认。")
    # Never expose docker cp stderr: config paths and environment may contain credentials.
    result = subprocess.run(["docker", "cp", runtime["Id"] + ":" + str(path / (mode + ".json")), "-"],
                            capture_output=True, timeout=30)
    if result.returncode:
        if b"Could not find the file" in result.stderr or b"no such file or directory" in result.stderr:
            return None
        raise RecoveryError("NPM 配置读取失败，不能推断数据库后端。")
    try:
        with tarfile.open(fileobj=io.BytesIO(result.stdout), mode="r:*") as archive:
            members = archive.getmembers()
            if len(members) != 1 or not members[0].isfile() or members[0].size > 1024 * 1024:
                raise ValueError()
            config = json.loads(archive.extractfile(members[0]).read())
        if not isinstance(config, dict):
            raise ValueError()
        return config
    except Exception:
        raise RecoveryError("NPM 配置无法识别，不能推断数据库后端。") from None


def identify_npm_backend(runtime, config_loader=None):
    """One decision function for update/export/restore; never infer the backend from a DB file."""
    unknown = {"backend": "unknown", "source": "unconfirmed"}
    try:
        if not is_npm(runtime):
            return unknown
        config_metadata = runtime["Config"]
        entrypoint, command = config_metadata.get("Entrypoint") or [], config_metadata.get("Cmd") or []
        if not ((entrypoint == ["/init"] and not command) or (not entrypoint and command == ["/init"])):
            return unknown  # Custom startup can override inspect's environment before Node starts.
        env, seen = {}, set()
        for item in runtime["Config"]["Env"]:
            key, sep, value = item.partition("=")
            if not sep or key in seen:
                return unknown
            seen.add(key)
            env[key] = value
        # These indirections can change backend selectors outside inspect's environment.
        selectors = ("DB_MYSQL_HOST", "DB_MYSQL_USER", "DB_MYSQL_NAME", "DB_POSTGRES_HOST",
                     "DB_POSTGRES_USER", "DB_POSTGRES_NAME", "DB_SQLITE_FILE", "NODE_CONFIG_DIR", "NODE_ENV")
        if any(key.endswith(("_FILE", "__FILE")) and key.removesuffix("__FILE").removesuffix("_FILE") in selectors
               and value for key, value in env.items()):
            return unknown
        config = (config_loader or npm_config_file)(runtime, env)
        if config is not None and "database" in config and config["database"] not in (None, False, "", 0):
            database = config["database"]
            engine = database.get("engine")
            if engine in ("mysql", "mysql2", "pg", "postgres", "postgresql"):
                return {"backend": "mysql" if engine in ("mysql", "mysql2") else "postgres", "source": "runtime-file"}
            knex = database.get("knex", {})
            if engine != "knex-native" or knex.get("client") not in ("sqlite3", "better-sqlite3"):
                return unknown
            filename = knex["connection"]["filename"]
            source = "runtime-file"
        else:
            # Match NPM precedence; partial selectors are deliberately rejected instead of silently falling back.
            for prefix, backend in (("DB_MYSQL_", "mysql"), ("DB_POSTGRES_", "postgres")):
                if all(env.get(prefix + suffix) for suffix in ("HOST", "USER", "NAME")):
                    return {"backend": backend, "source": "runtime-env"}
            if any(value for key, value in env.items() if key.startswith(("DB_MYSQL_", "DB_POSTGRES_"))):
                return unknown
            filename, source = env.get("DB_SQLITE_FILE") or "/data/database.sqlite", "runtime-env"
        path = PurePosixPath(filename)
        if not path.is_absolute() or ".." in path.parts or not path.is_relative_to("/data") or str(path) == "/data":
            return unknown
        return {"backend": "sqlite", "source": source, "sqlite_file": str(path), "runtime_id": runtime["Id"]}
    except Exception:
        return unknown


def require_npm_sqlite(decision):
    if (not isinstance(decision, dict) or decision.get("backend") != "sqlite"
            or decision.get("source") not in ("runtime-env", "runtime-file")):
        raise RecoveryError("NPM 使用外部数据库或后端无法确认，已拒绝自动备份、更新或恢复。")
    filename = decision.get("sqlite_file")
    if not isinstance(filename, str):
        raise RecoveryError("NPM 数据库位置无法确认。")
    path = PurePosixPath(filename)
    if not path.is_absolute() or ".." in path.parts or not path.is_relative_to("/data") or str(path) == "/data":
        raise RecoveryError("NPM 数据库位置无法确认。")
    return "data/" + path.relative_to("/data").as_posix()


def npm_runtime_for_root(root, allow_absent=False):
    """Use the actual stopped/running formal container, not compose text or quarantined instances."""
    if not shutil.which("docker"):
        raise RecoveryError("无法读取 NPM 实际运行配置，已拒绝推断数据库后端。")
    Engine()  # Enforce a local Docker context for local filesystem evidence.
    matches = []
    for runtime in all_containers():
        if not is_npm(runtime) or re.search(r"-ua-(old|failed)-[0-9a-f]{12}$", runtime.get("Name", "")):
            continue
        if any(m.get("Destination") == "/data" and Path(m["Source"]) == Path(root) / "data"
               for m in runtime.get("Mounts", [])):
            matches.append(runtime)
    if not matches and allow_absent and not (Path(root) / "data").exists():
        return None
    if len(matches) != 1:
        raise RecoveryError("NPM 实际运行配置缺失或不唯一，已拒绝推断数据库后端。")
    return matches[0]


def npm_backend_for_root(root):
    decision = identify_npm_backend(npm_runtime_for_root(root))
    require_npm_sqlite(decision)
    return decision


def profile_expected(name, tree, npm_backend=None):
    name = name.strip("/")
    if name == "root/uptime-kuma":
        return ["kuma.db"]
    if name == "root/nginx-proxy-manager":
        return [require_npm_sqlite(npm_backend)]
    if name == "root/filebrowser":
        return ["filebrowser.db"]
    if name == "root/openlist":
        config = Path(tree) / "data/config.json"
        if config.exists():
            database = json.loads(config.read_text()).get("database", {})
            if database.get("type", "sqlite3") not in ("sqlite", "sqlite3"):
                raise RecoveryError("OpenList 配置使用外部数据库，自动迁移已阻止。")
            filename = database.get("db_file", "data/data.db")
            if Path(filename).is_absolute() or ".." in Path(filename).parts:
                raise RecoveryError("OpenList 数据库不在完整迁移目录内。")
            return [filename]
        return ["data/data.db"]
    return []


class DirectoryTransaction:
    """Sibling copies + atomic exchange. Originals and failed candidates are retained."""
    def __init__(self, journal):
        self.path = Path(journal)
        self.data = json.loads(self.path.read_text())

    @classmethod
    def prepare(cls, pairs, journal, normalize=False, config_path=None):
        path = Path(journal)
        if path.exists():
            raise RecoveryError("事务记录已存在，不能覆盖: " + str(path))
        data = {"format": 2, "kind": "directories", "state": "preparing", "entries": []}
        save_json(path, data)
        for target, source in pairs:
            target, source = check_path(target), Path(source)
            if not target.parent.is_dir() or os.path.ismount(target):
                raise RecoveryError("原子切换要求已存在的父目录且目标不是挂载点: " + str(target))
            private = Path(tempfile.mkdtemp(prefix=".ua-recovery-", dir=target.parent))
            os.chmod(private, 0o700)
            slot = private / target.name
            before = inventory(target) if target.exists() else None
            copy_verified(source, slot)
            databases = inspect_databases(slot, normalize=normalize)
            if config_path is not None and target == Path(config_path):
                slot.write_text(safe_config(slot.read_text()))
                os.chmod(slot, 0o600)
                if os.geteuid() == 0:
                    os.chown(slot, os.geteuid(), os.getegid())
            for rel, item in inventory(slot).items():
                copied = slot if rel == "." else slot / rel
                if item["type"] == "file":
                    with copied.open("rb") as stream:
                        os.fsync(stream.fileno())
            sync_dir(slot if slot.is_dir() else slot.parent)
            after = inventory(slot)
            if before is not None and inventory(target) != before:
                raise RecoveryError("目标在准备期间发生变化，未切换: " + str(target))
            entry = {"target": str(target), "slot": str(slot), "before": before, "after": after,
                     "old_id": identity(target), "new_id": identity(slot), "databases": databases}
            data["entries"].append(entry)
            save_json(path, data)
        data["state"] = "prepared"
        save_json(path, data)
        return cls(path)

    def lock_paths(self):
        return [Path(e["target"]).parent / (".ua-recovery-" + Path(e["target"]).name + ".lock") for e in self.data["entries"]]

    def commit(self):
        with locked(self.lock_paths()):
            return self._commit()

    def rollback(self):
        with locked(self.lock_paths()):
            return self._rollback()

    def _commit(self):
        if self.data["state"] == "committed":
            return
        if self.data["state"] != "prepared":
            raise RecoveryError("事务尚未准备完整。")
        self.data["state"] = "switching"
        save_json(self.path, self.data)
        for entry in self.data["entries"]:
            target, slot = Path(entry["target"]), Path(entry["slot"])
            if identity(target) != entry["old_id"] or inventory(slot) != entry["after"]:
                raise RecoveryError("切换前身份或内容校验失败: " + str(target))
            if entry["before"] is not None and inventory(target) != entry["before"]:
                raise RecoveryError("切换前原数据发生变化: " + str(target))
            fault("before_exchange")
            if entry["old_id"] is None:
                os.rename(slot, target)
                sync_dir(target.parent)
            else:
                exchange(target, slot)
            fault("after_exchange")  # Journal intent exists even if killed before recording completion.
        self.data["state"] = "committed"
        save_json(self.path, self.data)

    def _rollback(self):
        errors = []
        for entry in reversed(self.data["entries"]):
            target, slot = Path(entry["target"]), Path(entry["slot"])
            try:
                check_path(target)
                check_path(slot)
                current = identity(target)
                if current == entry["old_id"]:
                    if current is not None and self.data["state"] != "rolled_back" and inventory(target) != entry["before"]:
                        raise RecoveryError("原目录内容已变化，拒绝覆盖。")
                    continue
                if current != entry["new_id"]:
                    raise RecoveryError("目标身份变化，拒绝覆盖未知数据。")
                if entry["old_id"] is None:
                    if slot.exists():
                        raise RecoveryError("候选保留位置已被占用。")
                    os.rename(target, slot)
                    sync_dir(target.parent)
                else:
                    if identity(slot) != entry["old_id"] or inventory(slot) != entry["before"]:
                        raise RecoveryError("原始备份身份或内容校验失败；备份未覆盖。")
                    exchange(target, slot)
                fault("after_rollback_exchange")
                if identity(target) != entry["old_id"]:
                    raise RecoveryError("回滚后的目标身份不匹配。")
            except Exception as error:
                errors.append({"target": str(target), "error": str(error)})
        self.data["state"] = "rollback_failed" if errors else "rolled_back"
        self.data["errors"] = errors
        save_json(self.path, self.data)
        if errors:
            raise RecoveryError("目录回滚未完成: " + json.dumps(errors, ensure_ascii=False))


def docker(*args):
    return subprocess.check_output(["docker", *args], text=True, stderr=subprocess.PIPE, timeout=180).strip()


class Engine:
    def __init__(self):
        context = os.environ.get("DOCKER_CONTEXT")
        endpoint = os.environ.get("DOCKER_HOST") if not context else None
        if not endpoint:
            endpoint = json.loads(docker("context", "inspect", *([context] if context else [])))[0]["Endpoints"]["docker"]["Host"]
        if not endpoint.startswith("unix://"):
            raise RecoveryError("自动操作仅支持本机 Unix Socket Docker。")
        self.socket_path, self.version = endpoint[7:], ""
        self.version = "/v" + self.request("GET", "/version")["ApiVersion"]

    def request(self, method, path, data=None):
        conn = http.client.HTTPConnection("localhost", timeout=30)
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            sock.settimeout(30)
            sock.connect(self.socket_path)
            conn.sock = sock
            conn.request(method, self.version + path, None if data is None else json.dumps(data).encode(),
                         {"Content-Type": "application/json"})
            response = conn.getresponse()
            raw = response.read()
            result = json.loads(raw) if raw else {}
            if response.status >= 300:
                raise RecoveryError("Docker API: " + result.get("message", str(response.status)))
            return result
        finally:
            conn.close()
            sock.close()


def get_container(identifier, missing=False):
    try:
        return json.loads(docker("container", "inspect", identifier))[0]
    except subprocess.CalledProcessError as error:
        if missing and any(text in str(error.stderr) for text in ("No such object", "No such container")):
            # Do not confuse daemon unavailability with a genuinely missing container.
            docker("info")
            return None
        raise error


def all_containers():
    ids = docker("ps", "-aq", "--no-trunc").split()
    return json.loads(docker("container", "inspect", *ids)) if ids else []


def overlaps(left, right):
    left, right = Path(left), Path(right)
    return left == right or left in right.parents or right in left.parents


def offline_guard(roots, exclude=()):
    roots = [Path(p) for p in roots]
    if not roots:
        return
    native_caddy = (Path("/etc/caddy"), Path("/root/caddy"), Path("/root/caddy_data"), Path("/root/caddy_config"))
    if any(overlaps(root, path) for root in roots for path in native_caddy) and shutil.which("systemctl"):
        status = subprocess.run(["systemctl", "is-active", "caddy.service"], capture_output=True, text=True, timeout=15)
        if status.returncode == 0:
            raise RecoveryError("原生 Caddy 仍在运行，必须先停止其证书/配置写入。")
        if status.returncode not in (3, 4):
            raise RecoveryError("不能确认原生 Caddy 停写状态，操作已阻止。")
    if shutil.which("docker"):
        for container in all_containers():
            if container["Id"] in exclude or not container["State"].get("Running"):
                continue
            for mount in container.get("Mounts", []):
                if any(overlaps(mount["Source"], root) for root in roots):
                    raise RecoveryError("仍有运行中的数据卷使用者: " + container["Id"][:12])
    # Reject native processes with writable handles. No guessed 'stopped' acknowledgement.
    for process in Path("/proc").iterdir():
        if not process.name.isdigit() or int(process.name) == os.getpid():
            continue
        try:
            for fd in (process / "fd").iterdir():
                try:
                    name = Path(os.readlink(fd))
                    if not name.is_absolute() or not any(overlaps(name, root) for root in roots):
                        continue
                    info = (process / "fdinfo" / fd.name).read_text()
                    flags = int(next(line.split()[1] for line in info.splitlines() if line.startswith("flags:")), 8)
                    if flags & os.O_ACCMODE:
                        raise RecoveryError("仍有宿主机写入句柄，PID=" + process.name)
                except (FileNotFoundError, ProcessLookupError):
                    pass
        except (FileNotFoundError, ProcessLookupError):
            pass
        except PermissionError as error:
            raise RecoveryError("无法确认进程停写状态: " + process.name) from error


def endpoint_config(endpoint, old_id):
    result = {k: copy.deepcopy(endpoint[k]) for k in ("IPAMConfig", "Links", "Aliases", "DriverOpts", "GwPriority")
              if endpoint.get(k) is not None}
    if "Aliases" in result:
        result["Aliases"] = [x for x in result["Aliases"] if x not in (old_id, old_id[:12])]
    return result


def create_config(old, image_id):
    config = copy.deepcopy(old["Config"])
    config["Image"] = image_id
    config["Labels"] = config.get("Labels") or {}
    if config.get("Hostname") == old["Id"][:12]:
        config.pop("Hostname")
    if "com.docker.compose.image" in (config.get("Labels") or {}):
        config["Labels"]["com.docker.compose.image"] = image_id
    host = copy.deepcopy(old["HostConfig"])
    binds = list(host.get("Binds") or [])
    targets = {b.split(":")[1] for b in binds if ":" in b}
    targets.update(m.get("Target") for m in host.get("Mounts") or [])
    for mount in old.get("Mounts", []):
        if mount["Type"] == "volume" and mount["Destination"] not in targets:
            binds.append(mount["Name"] + ":" + mount["Destination"] + (":rw" if mount["RW"] else ":ro"))
    host["Binds"] = binds
    config["HostConfig"] = host
    config["NetworkingConfig"] = {"EndpointsConfig": {
        n: endpoint_config(e, old["Id"]) for n, e in old.get("NetworkSettings", {}).get("Networks", {}).items()
        if n not in ("host", "none")}}
    return config


def wait_ready(container, timeout):
    deadline, consecutive = time.monotonic() + timeout, 0
    while time.monotonic() < deadline:
        state = get_container(container)["State"]
        if not state.get("Running") or state.get("Restarting"):
            raise RecoveryError("容器未保持运行。")
        health = state.get("Health", {}).get("Status")
        if health == "unhealthy":
            raise RecoveryError("容器健康检查失败。")
        consecutive += 1
        if health == "healthy" or (health is None and consecutive >= 3):
            return
        time.sleep(1)
    raise RecoveryError("容器启动/健康检查超时。")


def data_roots(old, npm_backend=None):
    if is_npm(old):
        require_npm_sqlite(npm_backend if npm_backend is not None else identify_npm_backend(old))
    env = dict(item.split("=", 1) for item in old["Config"].get("Env") or [] if "=" in item)
    if not is_npm(old) and any(value for key, value in env.items() if key.startswith(("DB_MYSQL_", "DB_POSTGRES_"))):
        raise RecoveryError("外部 MySQL/PostgreSQL 必须先独立完成一致性备份及恢复演练；自动更新已阻止。")
    if env.get("UPTIME_KUMA_DB_TYPE", "sqlite") not in ("sqlite", "sqlite3", ""):
        raise RecoveryError("外部 Kuma 数据库不支持自动回退。")
    roots = []
    for mount in old.get("Mounts", []):
        if not mount.get("RW", True):
            continue
        path = check_path(mount["Source"])
        if path in (Path("/"), Path("/root"), Path("/var"), Path("/etc")):
            raise RecoveryError("全盘或系统目录可写挂载无法提供完整数据回退，拒绝自动更新: " + str(path))
        if not path.exists() or not path.is_dir():
            raise RecoveryError("自动更新要求独立持久化目录挂载: " + str(path))
        roots.append(path)
    return sorted(set(p for p in roots if not any(other != p and other in p.parents for other in roots)))


def database_expectations(old, roots, npm_backend=None):
    image = ((old["Config"].get("Labels") or {}).get("ua.recovery.image_ref") or old["Config"]["Image"]).lower()
    expected = []
    names = []
    if "uptime-kuma" in image:
        names = ["kuma.db"]
    elif "nginx-proxy-manager" in image:
        relative = require_npm_sqlite(npm_backend if npm_backend is not None else identify_npm_backend(old))
        mounts = [m for m in old.get("Mounts", []) if m.get("Destination") == "/data"]
        if len(mounts) != 1:
            raise RecoveryError("NPM 数据库挂载无法确认。")
        path = Path(mounts[0]["Source"]) / PurePosixPath(relative).relative_to("data")
        if not path.is_file() or not any(path.is_relative_to(root) for root in roots):
            raise RecoveryError("实际使用的 NPM 数据库不在备份目录内或不存在。")
        return [path]
    elif "openlist" in image:
        names = ["data.db"]
    elif "filebrowser/filebrowser" in image:
        names = ["filebrowser.db"]
    for name in names:
        matches = [p for root in roots for p in root.rglob(name)]
        if len(matches) != 1:
            raise RecoveryError("必须确认唯一数据库位置及完整性: " + name)
        expected.extend(matches)
    return expected


NO_RESTART = {"Name": "no", "MaximumRetryCount": 0}


def restart_policy(container):
    policy = container.get("HostConfig", {}).get("RestartPolicy") or NO_RESTART
    name, retries = policy.get("Name", "no") or "no", policy.get("MaximumRetryCount", 0)
    if name not in ("no", "always", "unless-stopped", "on-failure") or not isinstance(retries, int) or retries < 0:
        raise RecoveryError("无法确认容器重启策略，操作已阻止。")
    return {"Name": name, "MaximumRetryCount": retries if name == "on-failure" else 0}


def set_restart_policy(engine, identifier, policy):
    """Reconcile an acknowledged or response-lost update against actual daemon state."""
    if restart_policy(get_container(identifier)) == policy:
        return
    try:
        engine.request("POST", "/containers/" + quote(identifier, safe="") + "/update", {"RestartPolicy": policy})
    except Exception:
        if restart_policy(get_container(identifier)) != policy:
            raise RecoveryError("容器重启策略更新失败，未确认策略已恢复。") from None
    fault("after_restart_policy_update")
    if restart_policy(get_container(identifier)) != policy:
        raise RecoveryError("容器重启策略实际值与目标不符。")


def record_restart_policy(record, path, container):
    """Persist the real pre-quarantine policy before changing any retained container."""
    policies = record.setdefault("restart_policies", {})
    retained = policies.setdefault("retained_original", {})
    if container["Id"] not in retained:
        retained[container["Id"]] = restart_policy(container)
        save_json(path, record)


def _recover_container(journal):
    path = Path(journal)
    record = json.loads(path.read_text())
    engine, old = Engine(), record["old"]
    original_policy = restart_policy(old)
    record_restart_policy(record, path, old)
    errors, log_errors = [], []
    def persist():
        try:
            save_json(path, record)
        except OSError as error:
            log_errors.append(str(error))
            print("恢复日志写入失败，将继续尝试恢复旧容器: " + str(error), file=sys.stderr)
    def attempt(step, action):
        event = {"step": step, "time": time.time()}
        try:
            action()
        except Exception as error:
            event["error"] = str(error)
            errors.append({"step": step, "error": str(error)})
        finally:
            try:
                observed = get_container(old["Id"])
                event["old"] = {"id": observed["Id"], "name": observed["Name"],
                                "state": observed["State"],
                                "networks": sorted(observed.get("NetworkSettings", {}).get("Networks", {})),
                                "restart_policy": restart_policy(observed)}
            except Exception as error:
                event["observation_error"] = str(error)
                errors.append({"step": "observe:" + step, "error": str(error)})
            record.setdefault("events", []).append(event)
            record["errors"] = list(errors)
            persist()
    with signals(False):
        # Discover actual state by immutable ID and operation label, never by a stale boolean.
        old_isolated = True
        attempt("isolate_old_restart", lambda: set_restart_policy(engine, old["Id"], NO_RESTART))
        old_isolated = restart_policy(get_container(old["Id"])) == NO_RESTART
        candidate = get_container(record.get("new_id") or record["name"], missing=True)
        if candidate is None and record.get("new_id"):
            candidate = get_container(record["name"], missing=True)
        if candidate and candidate["Id"] == old["Id"]:
            candidate = None
        if candidate and (candidate["Config"].get("Labels") or {}).get("ua.recovery.operation") != record["operation"]:
            errors.append({"step": "candidate_identity", "error": "名称已被未知容器占用，未操作该容器。"})
            candidate_safe = False
            candidate = None
        else:
            candidate_safe = True
        if candidate:
            record["new_id"] = candidate["Id"]
            # If this write fails, do not mutate an unrecorded retained instance.
            record_restart_policy(record, path, candidate)
            attempt("isolate_candidate_restart", lambda: set_restart_policy(engine, candidate["Id"], NO_RESTART))
            if candidate["State"].get("Running"):
                attempt("stop_candidate", lambda: docker("stop", candidate["Id"]))
            actual = get_container(candidate["Id"])
            candidate_safe = not actual["State"].get("Running") and restart_policy(actual) == NO_RESTART
            if candidate_safe:
                if actual["Name"].lstrip("/") != record["failed_name"]:
                    attempt("rename_candidate", lambda: docker("rename", candidate["Id"], record["failed_name"]))
                for network in list(actual.get("NetworkSettings", {}).get("Networks", {})):
                    if network not in ("host", "none"):
                        attempt("detach_candidate:" + network, lambda n=network: docker("network", "disconnect", n, candidate["Id"]))
        data_safe = candidate_safe and old_isolated
        attempt("restore_compose_binding", lambda: restore_compose_binding(record))
        transaction = record.get("data_journal")
        if transaction and data_safe:
            try:
                data_transaction = DirectoryTransaction(transaction)
                if any(identity(e["target"]) != e["old_id"] for e in data_transaction.data["entries"]):
                    offline_guard([Path(e["target"]) for e in data_transaction.data["entries"]])
                data_transaction.rollback()
            except Exception as error:
                errors.append({"step": "data_rollback", "error": str(error)})
                data_safe = False
        def restore_old_name():
            actual = get_container(old["Id"])
            if actual["Name"].lstrip("/") != record["name"]:
                docker("rename", old["Id"], record["name"])
        attempt("rename_old", restore_old_name)
        expected_networks = record["payload"]["NetworkingConfig"]["EndpointsConfig"]
        def restore_network(network, endpoint):
            fault("before_restore_network")
            actual = get_container(old["Id"])
            if network not in actual.get("NetworkSettings", {}).get("Networks", {}):
                engine.request("POST", "/networks/" + quote(network, safe="") + "/connect",
                               {"Container": old["Id"], "EndpointConfig": endpoint})
        for network, endpoint in expected_networks.items():
            attempt("connect:" + network, lambda n=network, e=endpoint: restore_network(n, e))
        # Only the selected instance regains its original policy; retained peers stay isolated.
        if data_safe:
            attempt("restore_old_restart", lambda: set_restart_policy(engine, old["Id"], original_policy))
        # Network failure MUST NOT skip the independent start attempt.
        if old["State"].get("Running") and data_safe:
            attempt("start_old", lambda: docker("start", old["Id"]))
            attempt("verify_old_readiness", lambda: wait_ready(old["Id"], record["timeout"]))
        elif not data_safe:
            errors.append({"step": "start_old_blocked", "error": "无法验证数据回退或新写入者停写状态，保留停止状态。"})
        actual = get_container(old["Id"])
        networks = actual.get("NetworkSettings", {}).get("Networks", {})
        for network, endpoint in expected_networks.items():
            current = networks.get(network)
            if (current is None or (endpoint.get("IPAMConfig") and current.get("IPAMConfig") != endpoint["IPAMConfig"])
                    or not set(endpoint.get("Aliases") or []).issubset(set((current or {}).get("Aliases") or []))):
                errors.append({"step": "verify_network:" + network, "error": "网络未完整恢复。"})
        correct = (actual["Id"] == old["Id"] and actual["Name"].lstrip("/") == record["name"]
                   and bool(actual["State"].get("Running")) == bool(old["State"].get("Running")) and data_safe
                   and restart_policy(actual) == original_policy)
        record["observed"] = {"id": actual["Id"], "name": actual["Name"], "state": actual["State"],
                              "networks": sorted(networks), "data_restored": data_safe if record.get("operation_type") != "bind" else None,
                              "writer_isolation_verified": data_safe, "restart_policy": restart_policy(actual)}
        if candidate:
            retained = get_container(candidate["Id"])
            record["observed"]["retained_candidate"] = {"id": retained["Id"], "running": retained["State"].get("Running"),
                                                         "restart_policy": restart_policy(retained)}
        record["errors"] = errors
        record["state"] = "recovered" if correct and not errors else "recovery_incomplete"
        record["log_errors"] = log_errors
        persist()
        if log_errors:
            print("恢复结果无法完整持久化，当前观测状态: " + json.dumps(record["observed"], ensure_ascii=False), file=sys.stderr)
            raise RecoveryError("日志写入失败，不能认定恢复记录完整；请核对现有日志与终端观测状态。")
        if record["state"] != "recovered":
            raise RecoveryError("恢复未完成；真实状态已记录: " + str(path))
        verified_part = "端口配置" if record.get("operation_type") == "bind" else "数据恢复"
        print("已验证旧容器名称、ID、运行状态、网络和" + verified_part + ": " + str(path))
    return record


def recover_container(journal):
    try:
        return _recover_container(journal)
    except BaseException as error:
        with signals(False):
            record = json.loads(Path(journal).read_text())
            record["state"] = "recovery_incomplete"
            record["recovery_error"] = str(error)
            try:
                save_json(journal, record)
            except OSError as log_error:
                print("无法持久化恢复失败结果: " + str(log_error), file=sys.stderr)
        raise


def update_container(name, backup_dir, timeout):
    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_.-]*", name) or not 3 <= int(timeout) <= 3600:
        raise RecoveryError("容器名或超时参数无效。")
    os.umask(0o077)
    backup_dir = Path(backup_dir)
    backup_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    with locked([backup_dir / ".recovery.lock"]):
        pending_bind = backup_dir / (".container-bind-" + name + ".json")
        if pending_bind.exists() and json.loads(pending_bind.read_text())["state"] not in ("committed", "recovered"):
            raise RecoveryError("存在未完成的端口切换，请先恢复: " + str(pending_bind))
        active = backup_dir / (".container-update-" + name + ".json")
        if active.exists():
            record = json.loads(active.read_text())
            if record["state"] not in ("committed", "recovered"):
                recover_container(active)
                return
        engine = Engine()
        old = get_container(name)
        if old["HostConfig"].get("AutoRemove") or old["HostConfig"].get("NetworkMode", "").startswith("container:"):
            raise RecoveryError("自动删除或共享其他容器网络的部署不支持自动恢复。")
        npm_backend = identify_npm_backend(old) if is_npm(old) else None
        roots = data_roots(old, npm_backend)
        expected = database_expectations(old, roots, npm_backend)
        # Check external database configuration and verifier availability before stopping anything.
        for root in roots:
            for config in list(root.rglob("config.json")) + list(root.rglob("db-config.json")):
                data = json.loads(config.read_text())
                db = data.get("database", data if config.name == "db-config.json" else {})
                if db.get("type", "sqlite") not in ("sqlite", "sqlite3", ""):
                    raise RecoveryError("外部数据库必须使用独立逻辑备份与验证流程，自动更新已阻止。")
        if any(p.name == "filebrowser.db" for p in expected) and not shutil.which("bbolt"):
            raise RecoveryError("缺少 bbolt check，不能验证 File Browser 数据库。")
        reference = (old["Config"].get("Labels") or {}).get("ua.recovery.image_ref") or old["Config"]["Image"]
        if reference.startswith("sha256:"):
            raise RecoveryError("镜像仅有本地 ID 且没有可验证更新引用；请先明确镜像仓库标签。")
        docker("pull", reference)
        image_id = json.loads(docker("image", "inspect", reference))[0]["Id"]
        operation = uuid.uuid4().hex
        payload = create_config(old, image_id)
        original_policy = restart_policy(old)
        payload["HostConfig"]["RestartPolicy"] = dict(NO_RESTART)
        payload.setdefault("Labels", {})["ua.recovery.operation"] = operation
        payload["Labels"]["ua.recovery.image_ref"] = reference
        record = {"format": 2, "kind": "container", "operation": operation, "name": name,
                  "old": old, "payload": payload, "timeout": int(timeout), "state": "intent",
                  "restart_policies": {"old_original": original_policy, "candidate_requested": original_policy,
                                       "candidate_initial": dict(NO_RESTART), "retained_original": {old["Id"]: original_policy}},
                  "backup_name": name + "-ua-old-" + operation[:12],
                  "failed_name": name + "-ua-failed-" + operation[:12]}
        if npm_backend is not None:
            record["database_backend"] = npm_backend  # Sanitized evidence, no environment/password values.
        save_json(active, record)
        snapshot = backup_dir / ("container-" + name + "-" + operation + ".json")
        save_json(snapshot, old)
        try:
            set_restart_policy(engine, old["Id"], NO_RESTART)
            if old["State"].get("Running"):
                docker("stop", old["Id"])
            if get_container(old["Id"])["State"].get("Running"):
                raise RecoveryError("无法确认旧容器已经停写。")
            offline_guard(roots)
            if roots:
                data_journal = backup_dir / ("data-" + operation + ".json")
                transaction = DirectoryTransaction.prepare([(p, p) for p in roots], data_journal, normalize=True)
                record["data_journal"] = str(data_journal)
                save_json(active, record)  # Durable BEFORE the first directory exchange.
                for expected_db in expected:
                    root = next(p for p in roots if p == expected_db or p in expected_db.parents)
                    entry = next(e for e in transaction.data["entries"] if e["target"] == str(root))
                    if expected_db.relative_to(root).as_posix() not in entry["databases"]:
                        raise RecoveryError("数据库副本未通过验证。")
                offline_guard(roots)
                transaction.commit()
            record["state"] = "replacing"
            save_json(active, record)
            for network in payload["NetworkingConfig"]["EndpointsConfig"]:
                docker("network", "disconnect", network, old["Id"])
            docker("rename", old["Id"], record["backup_name"])
            fault("after_container_rename")
            candidate = engine.request("POST", "/containers/create?name=" + quote(name, safe=""), payload)
            record["new_id"] = candidate["Id"]
            save_json(active, record)
            docker("start", candidate["Id"])
            wait_ready(candidate["Id"], int(timeout))
            actual = get_container(candidate["Id"])
            if actual["Name"].lstrip("/") != name or (actual["Config"].get("Labels") or {}).get("ua.recovery.operation") != operation:
                raise RecoveryError("新容器实际身份不匹配。")
            old_actual = get_container(old["Id"])
            if restart_policy(old_actual) != NO_RESTART or old_actual["State"].get("Running"):
                raise RecoveryError("旧容器重启隔离未保持，拒绝提升候选容器。")
            record["state"] = "promoting"
            save_json(active, record)
            set_restart_policy(engine, candidate["Id"], original_policy)
            fault("after_candidate_promotion")
            wait_ready(candidate["Id"], int(timeout))
            if restart_policy(get_container(candidate["Id"])) != original_policy:
                raise RecoveryError("正式容器重启策略未确认。")
            record["state"] = "committed"
            save_json(active, record)
            # Keep a permanent operation journal as well as the per-name active pointer.
            save_json(backup_dir / ("update-" + operation + ".json"), record)
            print("更新已验证；旧容器与原始数据均保留。恢复记录: " + str(active))
        except BaseException:
            with signals(False):
                try:
                    recover_container(active)
                except Exception as error:
                    print(str(error), file=sys.stderr)
            raise


TREES = ("root/caddy", "root/caddy_data", "root/caddy_config", "root/openlist", "root/filebrowser",
         "root/uptime-kuma", "root/nginx-proxy-manager", "root/it-tools")


def allowed_path(name, config_path, rclone_path):
    return (name in (config_path.lstrip("/"), rclone_path.lstrip("/"), "etc/caddy/Caddyfile")
            or any(name == p or name.startswith(p + "/") for p in TREES)
            or (name.startswith("etc/systemd/system/") and name.count("/") == 3
                and fnmatch.fnmatchcase(name.rsplit("/", 1)[1], "rclone-mount-*.service")))


def canonical_name(name):
    result = str(PurePosixPath(name))
    if not name or name.startswith("/") or ".." in PurePosixPath(name).parts or result == ".":
        raise RecoveryError("非法归档路径: " + name)
    return result


def build_archive(pairs, archive_path, guard=offline_guard):
    """Quiesced sources -> independent copy -> DB backup/restore validation -> manifest."""
    archive_path = Path(archive_path)
    if archive_path.exists():
        raise RecoveryError("拒绝覆盖已有备份: " + str(archive_path))
    guard([source for _, source in pairs])
    with tempfile.TemporaryDirectory(prefix="ua-export-") as temporary:
        stage = Path(temporary)
        roots, entries, databases, backends = [], {}, {}, {}
        originals = {}
        for name, source in pairs:
            name = canonical_name(name)
            if any(overlaps(Path('/' + name), Path('/' + old)) for old in roots):
                raise RecoveryError("备份根目录不能重叠。")
            backend = npm_backend_for_root(source) if name == "root/nginx-proxy-manager" else None
            if backend is not None:
                backends[name] = backend
            destination = stage / name
            destination.parent.mkdir(parents=True, exist_ok=True)
            originals[str(source)] = copy_verified(Path(source), destination)
            roots.append(name)
            databases[name] = inspect_databases(destination, normalize=True, expected=profile_expected(name, destination, backend))
            for relative, record in inventory(destination).items():
                entries[name if relative == "." else name + "/" + relative] = record
        guard([source for _, source in pairs])
        for source, before in originals.items():
            if inventory(Path(source)) != before:
                raise RecoveryError("停写校验失败，源数据发生变化。")
        manifest = {"format": 2, "roots": roots, "entries": entries, "databases": databases,
                    "database_backends": backends}
        save_json(stage / "UA-MANIFEST.json", manifest)
        archive_path.parent.mkdir(parents=True, exist_ok=True)
        descriptor, temporary_archive = tempfile.mkstemp(prefix=".ua-export-", dir=archive_path.parent)
        os.close(descriptor)
        try:
            with tarfile.open(temporary_archive, "w:gz", dereference=True) as archive:
                archive.add(stage / "UA-MANIFEST.json", arcname="UA-MANIFEST.json")
                for name in roots:
                    archive.add(stage / name, arcname=name)
            # Independent unpack + hash + database verification, not just tar readability.
            with verified_archive(temporary_archive) as verified:
                pass
            with open(temporary_archive, "rb") as stream:
                os.fsync(stream.fileno())
            # Link is no-clobber and atomic on the same filesystem.
            os.link(temporary_archive, archive_path)
            sync_dir(archive_path.parent)
        finally:
            if os.path.exists(temporary_archive):
                os.unlink(temporary_archive)
    return manifest


@contextlib.contextmanager
def verified_archive(archive_path):
    with tempfile.TemporaryDirectory(prefix="ua-verify-") as temporary:
        stage = Path(temporary)
        names, members = set(), []
        with tarfile.open(archive_path, "r:gz") as archive:
            for member in archive:
                name = canonical_name(member.name.rstrip("/"))
                if name in names or not (member.isdir() or member.isfile()):
                    raise RecoveryError("归档包含重复路径、链接或特殊文件: " + name)
                names.add(name)
                members.append((name, member))
            if "UA-MANIFEST.json" not in names:
                raise RecoveryError("缺少版本 2 完整性清单；旧版归档不能自动恢复数据库。")
            require_space(stage, sum(member.size for _, member in members))
            for name, member in members:
                dest = stage / name
                if member.isdir():
                    dest.mkdir(parents=True, exist_ok=True)
                else:
                    dest.parent.mkdir(parents=True, exist_ok=True)
                    with archive.extractfile(member) as source, dest.open("xb") as target:
                        shutil.copyfileobj(source, target)
            manifest = json.loads((stage / "UA-MANIFEST.json").read_text())
            if manifest.get("format") != 2 or not manifest.get("roots"):
                raise RecoveryError("完整性清单版本或根目录无效。")
            roots = [canonical_name(name) for name in manifest["roots"]]
            if len(roots) != len(set(roots)) or any(overlaps(Path('/'+a), Path('/'+b)) for i,a in enumerate(roots) for b in roots[i+1:]):
                raise RecoveryError("清单根目录重复或重叠。")
            if names - {"UA-MANIFEST.json"} != set(manifest["entries"]):
                raise RecoveryError("备份文件数量或路径与清单不一致。")
            for name, record in manifest["entries"].items():
                canonical_name(name)
                if not any(name == root or name.startswith(root + "/") for root in roots):
                    raise RecoveryError("清单包含未声明的数据根目录。")
                path = stage / name
                actual = metadata(path)
                if actual["type"] != record["type"] or (actual["type"] == "file" and (actual["size"] != record["size"] or actual["sha256"] != record["sha256"])):
                    raise RecoveryError("备份内容或校验和不匹配: " + name)
            # Only apply archived permissions after extraction and content verification.
            for name in sorted(manifest["entries"], key=lambda n: len(PurePosixPath(n).parts), reverse=True):
                record = manifest["entries"][name]
                if os.geteuid() == 0:
                    os.chown(stage / name, record["uid"], record["gid"])
                os.chmod(stage / name, record["mode"] & 0o777)
            for name in roots:
                if inspect_databases(stage / name, expected=profile_expected(name, stage / name, manifest.get("database_backends", {}).get(name))) != manifest["databases"].get(name):
                    raise RecoveryError("数据库验证记录不匹配或数据库缺失: " + name)
        yield stage, manifest


def restore_archive(archive_path, apply, config_path, rclone_path, backup_dir, root=Path("/"), guard=None):
    root = Path(root)
    with verified_archive(archive_path) as (stage, manifest):
        names = manifest["roots"]
        for name in manifest["entries"]:
            if not allowed_path(name, config_path, rclone_path):
                raise RecoveryError("不允许恢复的路径: " + name)
        # Data trees must be complete roots, not partial overlays of individual database files.
        for name in names:
            owner = next((tree for tree in TREES if name == tree or name.startswith(tree + "/")), None)
            if owner and name != owner:
                raise RecoveryError("必须提供完整面板根目录: " + owner)
            expected_type = "dir" if owner else "file"
            if manifest["entries"][name]["type"] != expected_type:
                raise RecoveryError("迁移根目录或配置文件类型不匹配: " + name)
            check_path(root / name)
        if not apply:
            print("完整性、文件数量与数据库验证通过: " + str(len(manifest["entries"])))
            return
        backup_dir = Path(backup_dir)
        backup_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
        with locked([backup_dir / ".recovery.lock"]):
            guard = guard or offline_guard
            targets = [root / name for name in names]
            for name, target in zip(names, targets):
                if name == "root/nginx-proxy-manager":
                    archived = manifest.get("database_backends", {}).get(name)
                    require_npm_sqlite(archived)
                    runtime = npm_runtime_for_root(target, allow_absent=True)
                    if runtime is not None:
                        actual = identify_npm_backend(runtime)
                        require_npm_sqlite(actual)
                        if actual["sqlite_file"] != archived["sqlite_file"]:
                            raise RecoveryError("NPM 源与目标实际数据库位置不一致，已拒绝恢复。")
            guard(targets)
            # New parent directories contain no previous data. Track creation in the journal.
            for target in targets:
                target.parent.mkdir(parents=True, exist_ok=True)
            recovery = Path(tempfile.mkdtemp(prefix="pre-import-", dir=backup_dir))
            journal = recovery / "journal.json"
            transaction = DirectoryTransaction.prepare(list(zip(targets, (stage / name for name in names))),
                                                       journal, config_path=root / config_path.lstrip("/"))
            try:
                guard(targets)
                transaction.commit()
            except BaseException:
                with signals(False):
                    transaction.rollback()
                raise
            print("整目录恢复已完成；原始目录与回滚记录保留: " + str(journal))


def recover_journal(path):
    data = json.loads(Path(path).read_text())
    if data.get("kind") == "container":
        with locked([Path(path).parent / ".recovery.lock"]):
            return recover_container(path)
    if data.get("kind") != "directories":
        raise RecoveryError("未知恢复记录。")
    targets = [Path(e["target"]) for e in data["entries"]]
    parent = Path(path).parent
    lock_parent = parent.parent if parent.name.startswith("pre-import-") else parent
    with locked([lock_parent / ".recovery.lock"]):
        offline_guard(targets)
        with signals(False):
            DirectoryTransaction(path).rollback()
    print("原目录身份及内容已核对，恢复完成。")


def atomic_bytes(path, content, info=None):
    path = Path(path)
    fd, temporary = tempfile.mkstemp(prefix=".ua-config-", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            if info:
                os.fchown(stream.fileno(), info.st_uid, info.st_gid)
                os.fchmod(stream.fileno(), stat.S_IMODE(info.st_mode))
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        sync_dir(path.parent)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def restart_docker_service():
    if shutil.which("systemctl"):
        command = ["systemctl", "restart", "docker"]
        verify = ["systemctl", "is-active", "--quiet", "docker"]
    elif shutil.which("service"):
        command, verify = ["service", "docker", "restart"], ["service", "docker", "status"]
    else:
        raise RecoveryError("缺少 Docker 服务管理工具。")
    for args in (command, verify):
        if subprocess.run(args, capture_output=True, timeout=180).returncode:
            raise RecoveryError("Docker 服务重启或状态核验失败。")


def configure_daemon(path, patch, mode="merge"):
    """Fail closed, validate staged config, preserve the unique original on restart failure."""
    path = check_path(path)
    patch = json.loads(patch)
    if not isinstance(patch, dict) or mode not in ("merge", "replace"):
        raise RecoveryError("Docker 配置必须是 JSON 对象。")
    if not shutil.which("dockerd"):
        raise RecoveryError("缺少 dockerd，不能校验配置，未修改原文件。")
    path.parent.mkdir(parents=True, exist_ok=True)
    with locked([path.parent / ".ua-daemon-config.lock"]):
        if path.exists() and not path.is_file():
            raise RecoveryError("Docker 配置不是普通文件。")
        original = path.read_bytes() if path.exists() else None
        info = path.stat() if original is not None else None
        current = json.loads(original) if original is not None else {}
        if not isinstance(current, dict):
            raise RecoveryError("已有 Docker 配置不是对象，未覆盖。")
        desired = copy.deepcopy(current) if mode == "merge" else {}
        for key, value in patch.items():
            if mode == "merge" and isinstance(value, dict):
                if key in desired and not isinstance(desired[key], dict):
                    raise RecoveryError("已有 Docker 配置字段类型不兼容，未覆盖。")
                desired[key] = {**desired.get(key, {}), **value}
            else:
                desired[key] = value
        content = (json.dumps(desired, indent=2) + "\n").encode()
        fd, stage = tempfile.mkstemp(prefix=".ua-daemon-", suffix=".json", dir=path.parent)
        os.close(fd)
        backup = path.with_name(path.name + ".ua-box." + uuid.uuid4().hex + ".bak")
        try:
            Path(stage).write_bytes(content)
            validation = subprocess.run(["dockerd", "--validate", "--config-file", stage], capture_output=True, timeout=30)
            if validation.returncode:
                raise RecoveryError("dockerd 拒绝暂存配置，原文件未修改。")
            if (path.read_bytes() if path.exists() else None) != original:
                raise RecoveryError("配置被其他进程修改，未覆盖。")
            if original is not None:
                with backup.open("xb") as stream:
                    os.chmod(backup, 0o600)
                    stream.write(original)
                    stream.flush()
                    os.fsync(stream.fileno())
                sync_dir(path.parent)
            with signals(False):
                restart_attempted = False
                try:
                    atomic_bytes(path, content, info)
                    fault("after_daemon_config_write")
                    restart_attempted = True
                    restart_docker_service()
                except BaseException:
                    backup_note = str(backup) if original is not None else "原配置不存在"
                    try:
                        observed = path.read_bytes() if path.exists() else None
                        if observed != original:
                            if observed != content:
                                raise RecoveryError("配置被外部修改，不能覆盖。")
                            if original is None:
                                path.unlink()
                                sync_dir(path.parent)
                            else:
                                atomic_bytes(path, original, info)
                        if (path.read_bytes() if path.exists() else None) != original:
                            raise RecoveryError("原配置恢复未通过核对。")
                    except Exception:
                        raise RecoveryError("配置恢复未完成，请手动核对；保留原始备份: " + backup_note) from None
                    if not restart_attempted:
                        raise RecoveryError("配置写入未完成，原配置已核对；未重启 Docker。备份: " + backup_note) from None
                    try:
                        restart_docker_service()
                    except Exception:
                        raise RecoveryError("原配置已恢复，但 Docker 服务恢复未确认；请手动核对。备份: " + backup_note) from None
                    raise RecoveryError("新配置应用失败；已恢复原配置并核验 Docker 服务。备份: " + backup_note) from None
            print("Docker 配置和服务状态已核验。已有容器日志策略不会自动改变。")
        finally:
            if os.path.exists(stage):
                os.unlink(stage)


def compose_command(old, source):
    labels = old["Config"].get("Labels") or {}
    working = labels.get("com.docker.compose.project.working_dir")
    project = labels.get("com.docker.compose.project")
    if not working or not project or not Path(working).is_dir():
        raise RecoveryError("Compose 项目身份不完整，未操作容器。")
    # Do not guess directories, switch projects, or run 'down'.
    return ["docker", "compose", "--project-name", project, "--project-directory", working,
            "-f", str(source), "config", "--format", "json"]


def compose_config(old, source):
    result = subprocess.run(compose_command(old, source), capture_output=True, text=True, timeout=30)
    if result.returncode:
        raise RecoveryError("Compose 配置校验失败，未输出可能包含密码的配置/错误内容。")
    return json.loads(result.stdout)


def prepare_compose_binding(old, host_port, container_port, address):
    labels = old["Config"].get("Labels") or {}
    if not labels.get("com.docker.compose.project"):
        return None
    paths = labels.get("com.docker.compose.project.config_files", "").split(",")
    if len(paths) != 1 or not paths[0]:
        raise RecoveryError("多文件 Compose 配置暂不支持自动改端口；请在原项目中修改并校验，未操作容器。")
    source = check_path(paths[0])
    if not source.is_file():
        raise RecoveryError("Compose 原文件不存在。")
    original, info = source.read_bytes(), source.stat()
    before = compose_config(old, source)
    service = labels.get("com.docker.compose.service")
    if service not in before.get("services", {}):
        raise RecoveryError("Compose 服务身份不匹配。")
    # A narrow textual edit keeps interpolation, comments, permissions and all other services intact.
    # Long/ranged/variable syntax is deliberately refused unless it can be verified without guessing.
    pattern = re.compile(r"^(\s*-\s*)(['\"]?)(?:(?:[0-9.]+|\[[0-9a-fA-F:]+\]):)?" + re.escape(host_port) +
                         ":" + re.escape(container_port) + r"(/tcp)?\2(\s*(?:#.*)?)$")
    lines, matches = [], 0
    for line in original.decode().splitlines(keepends=True):
        match = pattern.fullmatch(line.rstrip("\r\n"))
        if match:
            matches += 1
            if matches == 1:
                newline = "\r\n" if line.endswith("\r\n") else "\n"
                line = match[1] + '"' + address + ":" + host_port + ":" + container_port + (match[3] or "") + '"' + match[4] + newline
            else:
                # Ambiguous multiple matches might belong to another service; don't guess.
                raise RecoveryError("Compose 端口出现多个匹配，请在原项目中明确修改。")
        lines.append(line)
    if not matches:
        raise RecoveryError("Compose 端口语法无法可靠识别，请在原项目中明确修改。")
    content = "".join(lines).encode()
    fd, stage = tempfile.mkstemp(prefix=".ua-port-", suffix=source.suffix, dir=source.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(content)
        after = compose_config(old, stage)
    finally:
        os.unlink(stage)
    desired = copy.deepcopy(before)
    ports = desired["services"][service].get("ports", [])
    selected = [p for p in ports if str(p.get("published")) == host_port and str(p.get("target")) == container_port and p.get("protocol", "tcp") == "tcp"]
    if len(selected) != 1:
        raise RecoveryError("Compose 实际生效端口无法唯一确认。")
    selected[0]["host_ip"] = address
    if after != desired:
        raise RecoveryError("Compose 暂存配置包含预期之外的变化，未操作容器。")
    return {"path": str(source), "original": original.hex(), "content": content.hex(),
            "before": hashlib.sha256(original).hexdigest(), "after": hashlib.sha256(content).hexdigest(),
            "identity": identity(source), "mode": stat.S_IMODE(info.st_mode), "uid": info.st_uid, "gid": info.st_gid}


def restore_compose_binding(record):
    binding = record.get("compose_binding")
    if not binding:
        return
    source = check_path(binding["path"])
    if digest(source) == binding["before"]:
        return
    if digest(source) != binding["after"]:
        raise RecoveryError("Compose 文件被外部修改，未覆盖该文件。")
    atomic_bytes(source, bytes.fromhex(binding["original"]), source.stat())


def rebind_container(name, host_port, container_port, address, backup_dir, timeout):
    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_.-]*", name) or not 3 <= int(timeout) <= 3600:
        raise RecoveryError("容器名称或超时无效。")
    if address not in ("127.0.0.1", "0.0.0.0") or any(not p.isdigit() or not 1 <= int(p) <= 65535 for p in (host_port, container_port)):
        raise RecoveryError("端口绑定参数无效。")
    os.umask(0o077)
    backup_dir = Path(backup_dir)
    backup_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    with locked([backup_dir / ".recovery.lock"]):
        active = backup_dir / (".container-bind-" + name + ".json")
        for prefix in (".container-bind-", ".container-update-"):
            journal = backup_dir / (prefix + name + ".json")
            if journal.exists() and json.loads(journal.read_text())["state"] not in ("committed", "recovered"):
                raise RecoveryError("存在未完成的操作，请先恢复: " + str(journal))
        old, engine = get_container(name), Engine()
        host = old["HostConfig"]
        if host.get("AutoRemove") or host.get("PublishAllPorts") or host.get("NetworkMode") in ("host", "none") or host.get("NetworkMode", "").startswith("container:"):
            raise RecoveryError("当前容器网络/删除模式不支持安全端口切换。")
        if re.search(r"-ua-(old|failed)-", old["Name"]):
            raise RecoveryError("隔离容器不能直接切换端口，请通过恢复记录操作。")
        payload = create_config(old, old["Image"])
        key = container_port + "/tcp"
        bindings = payload["HostConfig"].get("PortBindings", {})
        if not any(p.get("HostPort") == host_port for p in bindings.get(key) or []):
            raise RecoveryError("实际端口映射与输入不符。")
        others = [p for p in bindings[key] if p.get("HostPort") != host_port]
        bindings[key] = others + [{"HostIp": address, "HostPort": host_port}]
        compose_binding = prepare_compose_binding(old, host_port, container_port, address)
        operation, original_policy = uuid.uuid4().hex, restart_policy(old)
        payload["HostConfig"]["RestartPolicy"] = dict(NO_RESTART)
        payload.setdefault("Labels", {})["ua.recovery.operation"] = operation
        payload["Labels"]["ua.recovery.image_ref"] = (old["Config"].get("Labels") or {}).get("ua.recovery.image_ref") or old["Config"]["Image"]
        record = {"format": 2, "kind": "container", "operation_type": "bind", "operation": operation, "name": name,
                  "old": old, "payload": payload, "timeout": int(timeout), "state": "intent",
                  "backup_name": name + "-ua-old-" + operation[:12], "failed_name": name + "-ua-failed-" + operation[:12],
                  "restart_policies": {"old_original": original_policy, "candidate_requested": original_policy,
                                       "candidate_initial": dict(NO_RESTART), "retained_original": {old["Id"]: original_policy}}}
        if compose_binding:
            record["compose_binding"] = compose_binding
        save_json(backup_dir / ("bind-" + operation + ".json"), record)
        save_json(active, record)
        try:
            if compose_binding:
                source = check_path(compose_binding["path"])
                if identity(source) != compose_binding["identity"] or digest(source) != compose_binding["before"]:
                    raise RecoveryError("Compose 原文件身份改变。")
                atomic_bytes(source, bytes.fromhex(compose_binding["content"]), source.stat())
                fault("after_compose_binding_write")
            set_restart_policy(engine, old["Id"], NO_RESTART)
            if old["State"].get("Running"):
                docker("stop", old["Id"])
            if get_container(old["Id"])["State"].get("Running"):
                raise RecoveryError("旧容器未确认停止。")
            for network in payload["NetworkingConfig"]["EndpointsConfig"]:
                docker("network", "disconnect", network, old["Id"])
            docker("rename", old["Id"], record["backup_name"])
            fault("after_container_rename")
            candidate = engine.request("POST", "/containers/create?name=" + quote(name, safe=""), payload)
            record["new_id"] = candidate["Id"]
            save_json(active, record)
            if old["State"].get("Running"):
                docker("start", candidate["Id"])
                wait_ready(candidate["Id"], int(timeout))
            actual = get_container(candidate["Id"])
            if actual["Name"].lstrip("/") != name or actual["HostConfig"].get("PortBindings") != bindings:
                raise RecoveryError("新容器身份或全部端口映射不匹配。")
            if old["State"].get("Running") and actual.get("NetworkSettings", {}).get("Ports", {}).get(key) != bindings[key]:
                raise RecoveryError("运行中的实际端口绑定未确认。")
            retained = get_container(old["Id"])
            if retained["State"].get("Running") or restart_policy(retained) != NO_RESTART:
                raise RecoveryError("旧容器隔离未保持。")
            if compose_binding and digest(compose_binding["path"]) != compose_binding["after"]:
                raise RecoveryError("Compose 文件在操作期间被修改。")
            set_restart_policy(engine, candidate["Id"], original_policy)
            record["state"] = "committed"
            save_json(active, record)
            save_json(backup_dir / ("bind-" + operation + ".json"), record)
            print("端口绑定、容器身份及旧实例隔离已核验；恢复记录: " + str(active))
        except BaseException:
            with signals(False):
                try:
                    recover_container(active)
                except Exception as error:
                    print(str(error), file=sys.stderr)
            raise


def update_fail2ban_port(path, port):
    path = check_path(path)
    text, info = path.read_text(), path.stat()
    lines, active, found, seen_port = [], False, False, False
    for line in text.splitlines(keepends=True):
        section = re.match(r"^\s*\[([^]]+)\]\s*(?:[#;].*)?$", line.rstrip())
        if section:
            if active and not seen_port:
                lines.append("port = " + port + "\n")
            active = section[1] == "sshd"
            found |= active
            seen_port = False
        if active and re.match(r"^\s*port\s*=", line):
            line = "port = " + port + "\n"
            seen_port = True
        lines.append(line)
    if active and not seen_port:
        if lines and not lines[-1].endswith("\n"):
            lines[-1] += "\n"
        lines.append("port = " + port + "\n")
    if not found:
        raise RecoveryError("没有 sshd 配置段，未修改。")
    atomic_bytes(path, "".join(lines).encode(), info)


def write_rclone_unit(destination, executable, remote, mount, config, extra):
    arguments = [executable, "mount", remote, mount, "--config=" + config, *shlex.split(extra)]
    def unit_arg(value):
        if any(ord(c) < 32 or ord(c) == 127 for c in value):
            raise RecoveryError("挂载参数不能包含控制字符。")
        return '"' + value.replace("\\", "\\\\").replace('"', '\\"').replace("%", "%%").replace("$", "$$") + '"'
    command = " ".join(map(unit_arg, arguments))
    content = ("[Unit]\nDescription=UA Box rclone mount\nAfter=network-online.target\nWants=network-online.target\n"
               "StartLimitIntervalSec=300\nStartLimitBurst=5\n[Service]\nType=simple\nExecStart=" + command +
               "\nRestart=on-failure\nRestartSec=15\n[Install]\nWantedBy=multi-user.target\n")
    Path(destination).write_text(content)
    os.chmod(destination, 0o600)


def notification_payload(kind, title, body):
    if kind in ("wecom", "dingtalk"):
        return {"msgtype": "text", "text": {"content": body}}
    if kind == "feishu":
        return {"msg_type": "text", "content": {"text": body}}
    if kind == "discord":
        return {"content": body}
    if kind == "bark":
        return {"title": title, "body": body}
    raise RecoveryError("Webhook 类型未知，请配置 wecom/feishu/dingtalk/discord/bark。")


def verify_notification(kind, status, payload):
    if not 200 <= int(status) < 300:
        raise RecoveryError("通知 HTTP 请求失败。")
    if kind == "discord" and int(status) == 204:
        return
    data = json.loads(payload)
    if not isinstance(data, dict):
        raise RecoveryError("通知响应不是对象。")
    success = ((kind == "telegram" and data.get("ok") is True)
               or (kind in ("wecom", "dingtalk") and type(data.get("errcode")) is int and data["errcode"] == 0)
               or (kind == "feishu" and (type(data.get("code")) is int and data["code"] == 0
                                        or type(data.get("StatusCode")) is int and data["StatusCode"] == 0))
               or (kind == "bark" and type(data.get("code")) is int and data["code"] == 200)
               or (kind == "discord" and "id" in data))
    if not success:
        raise RecoveryError("通知平台未确认接收成功。")


def main(argv=None):
    args = sys.argv[1:] if argv is None else argv
    try:
        os.umask(0o077)
        with signals():
            command, *args = args
            if command == "update":
                update_container(*args)
            elif command == "bind":
                rebind_container(*args)
            elif command == "daemon-config":
                configure_daemon(*args)
            elif command == "daemon-config-file":
                configure_daemon(args[0], Path(args[1]).read_text(), "replace")
            elif command == "fail2ban-port":
                update_fail2ban_port(*args)
            elif command == "rclone-unit":
                write_rclone_unit(*args)
            elif command == "notify-payload":
                print(json.dumps(notification_payload(*args)))
            elif command == "notify-verify":
                verify_notification(args[0], args[1], Path(args[2]).read_text())
            elif command == "recover":
                recover_journal(*args)
            elif command == "verify":
                with verified_archive(args[0]) as verified:
                    print("备份内容、文件数量和数据库独立验证通过。")
            elif command == "restore":
                archive, mode, config, rclone, backup = args
                if mode not in ("check", "apply"):
                    raise RecoveryError("恢复模式无效。")
                restore_archive(archive, mode == "apply", config, rclone, backup)
            elif command == "export":
                destination, *paths = args
                build_archive([(str(Path(path)).lstrip("/"), Path(path)) for path in paths], destination)
                print("一致性备份与独立恢复验证通过: " + destination)
            else:
                raise RecoveryError("未知恢复操作。")
    except (Exception, KeyboardInterrupt) as error:
        print("操作失败，不能认定已恢复: " + str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
PY_UA_RECOVERY
}

