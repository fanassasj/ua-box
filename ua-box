ua_disk_io_test() {
  (
  local target="${UA_IO_TEST_DIR:-$PWD}" size="${UA_IO_TEST_MB:-256}" free_kb temporary owner rate
  [[ "$size" =~ ^[0-9]{1,4}$ ]] && ((10#$size >= 1 && 10#$size <= 4096)) || { echo "测速大小必须为 1–4096 MiB。" >&2; exit 1; }
  size=$((10#$size))
  target="$(readlink -f -- "$target")" && [ -d "$target" ] || { echo "待测目录不可用。" >&2; exit 1; }
  free_kb="$(df -Pk -- "$target" 2>/dev/null | awk 'NR==2 {print $4}')"
  [[ "$free_kb" =~ ^[0-9]+$ ]] && [ "$free_kb" -ge $(((size + 128) * 1024)) ] || { echo "测速空间不足或无法读取，未写入测试数据。" >&2; exit 1; }
  temporary="$(mktemp -d "$target/.ua-io.XXXXXX")" || exit 1
  owner="$(stat -c '%d:%i' -- "$temporary")" || exit 1
  ua_disk_cleanup() {
    if [ "$(stat -c '%d:%i' -- "$temporary" 2>/dev/null)" = "$owner" ]; then
      rm -rf -- "$temporary"
    else
      echo "测速目录身份改变，未清理该路径。" >&2
    fi
  }
  trap ua_disk_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  cd -- "$temporary" || exit 1
  [ "$(stat -c '%d:%i' .)" = "$owner" ] || exit 1
  echo "正在测试目标文件系统写入（${size} MiB）..."
  if ! LC_ALL=C dd if=/dev/zero of=data bs=1M count="$size" oflag=direct 2> result; then
    echo "磁盘写入测试失败，未报告速率。" >&2; exit 1
  fi
  [ "$(stat -c '%s' data 2>/dev/null)" = "$((size * 1024 * 1024))" ] || { echo "测速写入量未通过核验。" >&2; exit 1; }
  rate="$(awk '/copied/ {rate=$(NF-1) " " $NF} END {print rate}' result)"
  echo "磁盘写入速度: ${rate:-写入完成，无法解析速率}"
  )
}

