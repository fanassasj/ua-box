need_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo -e "${gl_hong}错误:${gl_bai} 此操作需要 root 权限。"
    echo "请使用 root 用户或 sudo 运行。"
    return 1
  fi
}

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

is_pkg_installed() {
  local pkg="$1"
  if has_cmd dpkg; then
    dpkg -s "$pkg" 2>/dev/null | grep -q "Status: install ok installed" && return 0
  elif has_cmd rpm; then
    rpm -q "$pkg" >/dev/null 2>&1 && return 0
  elif has_cmd apk; then
    apk info -e "$pkg" >/dev/null 2>&1 && return 0
  fi
  has_cmd "$pkg" && return 0
  return 1
}

is_port_taken() {
  local port="$1"
  if has_cmd ss; then
    ss -tlnp 2>/dev/null | grep -Eq ":${port}\s"
  elif has_cmd netstat; then
    netstat -tlnp 2>/dev/null | grep -Eq ":${port}\s"
  else
    lsof -i :"$port" >/dev/null 2>&1
  fi
}

list_has_word() {
  local needle="$1"
  local list="$2"
  local item

  # shellcheck disable=SC2086
  for item in $list; do
    [ "$item" = "$needle" ] && return 0
  done
  return 1
}

list_add_words() {
  local list="$1"
  shift

  local item
  for item in "$@"; do
    [ -z "$item" ] && continue
    list_has_word "$item" "$list" || list="${list:+$list }$item"
  done
  printf '%s\n' "$list"
}

list_remove_words() {
  local list="$1"
  shift

  local result item remove word
  result=""
  # shellcheck disable=SC2086
  for item in $list; do
    remove=0
    for word in "$@"; do
      [ "$item" = "$word" ] && remove=1
    done
    [ "$remove" -eq 0 ] && result="${result:+$result }$item"
  done
  printf '%s\n' "$result"
}

config_set_var() {
  local var="$1" value="$2" tmp escaped assignment
  [[ "$var" =~ ^[A-Z_][A-Z0-9_]*$ ]] || return 1
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || { echo "配置值不能包含换行。" >&2; return 1; }

  # 单引号字面量，避免配置重新加载时执行 $()、反引号或变量展开。
  escaped=${value//\'/\'\\\'\'}
  assignment="$var='$escaped'"
  tmp="$(mktemp "${UA_BOX_CONFIG}.tmp.XXXXXX")" || return 1
  if ! UA_CONFIG_ASSIGNMENT="$assignment" awk -v var="$var" '
    BEGIN { found=0 }
    $0 ~ "^" var "=" {
      if (!found) print ENVIRON["UA_CONFIG_ASSIGNMENT"]
      found=1
      next
    }
    { print }
    END { if (!found) print ENVIRON["UA_CONFIG_ASSIGNMENT"] }
  ' "$UA_BOX_CONFIG" > "$tmp" || ! bash -n "$tmp" ||
    ! chmod 600 "$tmp" || ! mv -f "$tmp" "$UA_BOX_CONFIG"; then
    rm -f "$tmp"
    return 1
  fi
  # shellcheck disable=SC1090
  . "$UA_BOX_CONFIG"
}

pkg_manager() {
  if [ -n "$_UA_PKG_MANAGER" ]; then
    echo "$_UA_PKG_MANAGER"
    return
  fi

  local pm=""
  if has_cmd apt; then
    pm="apt"
  elif has_cmd dnf; then
    pm="dnf"
  elif has_cmd yum; then
    pm="yum"
  elif has_cmd apk; then
    pm="apk"
  elif has_cmd pacman; then
    pm="pacman"
  elif has_cmd zypper; then
    pm="zypper"
  elif has_cmd opkg; then
    pm="opkg"
  fi

  _UA_PKG_MANAGER="$pm"
  echo "$pm"
}

install_pkg() {
  if [ "$#" -eq 0 ]; then
    echo "未提供软件包参数。"
    return 1
  fi

  need_root || return 1
  log_action "install_pkg $*"

  local pm
  pm="$(pkg_manager)"
  if [ -z "$pm" ]; then
    echo -e "${gl_hong}未知包管理器，无法安装。${gl_bai}"
    return 1
  fi

  # 过滤出未安装的包
  local pkgs_to_install=""
  local pkg
  for pkg in "$@"; do
    if ! is_pkg_installed "$pkg"; then
      pkgs_to_install="$pkgs_to_install $pkg"
    fi
  done

  if [ -z "$pkgs_to_install" ]; then
    echo "所有请求的软件包已安装。"
    return 0
  fi

  case "$pm" in
    apt)
      local _apt_interval="${UA_APT_UPDATE_INTERVAL:-60}"
      if [ ! -f /tmp/.ua-apt-updated ] || \
         [ -n "$(find /tmp/.ua-apt-updated -mmin +"$_apt_interval" 2>/dev/null)" ]; then
        apt update -y
        touch /tmp/.ua-apt-updated
      fi
      DEBIAN_FRONTEND=noninteractive apt install -y "$@"
      ;;
    dnf)
      dnf install -y "$@"
      ;;
    yum)
      yum install -y epel-release
      yum install -y "$@"
      ;;
    apk)
      apk update
      apk add "$@"
      ;;
    pacman)
      pacman -Syu --noconfirm
      pacman -S --noconfirm "$@"
      ;;
    zypper)
      zypper refresh
      zypper install -y "$@"
      ;;
    opkg)
      opkg update
      opkg install "$@"
      ;;
  esac
}

remove_pkg() {
