caddy_remove_domain_block() {
  local cfg_file="$1"
  local target_domain="$2"
  local tmp_file="$UA_BOX_TMP_DIR/caddyfile.clean.$$"

  awk -v dom="$target_domain" '
    BEGIN { skip = 0; depth = 0 }
    {
      if (!skip) {
        line = $0
        sub(/^[[:space:]]+/, "", line)
        if (index(line, dom) == 1) {
          rest = substr(line, length(dom) + 1)
          if (rest ~ /^[[:space:]]*\{/) {
            skip = 1
            depth = 0
          }
        }
      }
      if (skip) {
        tmp = $0
        gsub(/(^|[[:space:]])#.*/, "", tmp)
        open_c = gsub(/\{/, "{", tmp)
        close_c = gsub(/\}/, "}", tmp)
        depth += open_c - close_c
        if (depth <= 0) {
          skip = 0
          depth = 0
        }
        next
      }
      print $0
    }
  ' "$cfg_file" > "$tmp_file" && mv "$tmp_file" "$cfg_file"
}

caddy_get_domain_upstream() {
  local cfg_file="$1"
  local target_domain="$2"

  awk -v dom="$target_domain" '
    BEGIN { in_block = 0; depth = 0 }
    {
      if (!in_block) {
        line = $0
        sub(/^[[:space:]]+/, "", line)
        if (index(line, dom) == 1) {
          rest = substr(line, length(dom) + 1)
          if (rest ~ /^[[:space:]]*\{/) {
            in_block = 1
            depth = 0
          }
        }
      }
      if (in_block) {
        tmp = $0
        gsub(/(^|[[:space:]])#.*/, "", tmp)
        if (tmp ~ /(^|[[:space:]])reverse_proxy[[:space:]]+/) {
          n = split(tmp, arr, /[[:space:]]+/)
          for (i = 1; i <= n; i++) {
            if (arr[i] == "reverse_proxy" && i < n) {
              print arr[i + 1]
              exit
            }
          }
        }
        open_c = gsub(/\{/, "{", tmp)
        close_c = gsub(/\}/, "}", tmp)
        depth += open_c - close_c
        if (depth <= 0) {
          in_block = 0
          depth = 0
        }
      }
    }
  ' "$cfg_file"
}

caddy_add_reverse_proxy() {
  need_root || return 1

  local default_port="$1"
  local target_container_name="$2"
  local target_container_port="$3"
  local domain upstream cfg_file
  if docker_container_exists caddy; then
    cfg_file="/root/caddy/Caddyfile"
  else
    cfg_file="/etc/caddy/Caddyfile"
  fi

  read -r -e -p "请输入域名，如 example.com: " domain
  local default_target=""
  if [ -n "$default_port" ]; then
    default_target="http://127.0.0.1:${default_port}"
    read -r -e -p "请输入反代目标，回车默认 ${default_target}: " upstream
    upstream="${upstream:-$default_target}"
  else
    read -r -e -p "请输入反代目标，如 http://127.0.0.1:3000: " upstream
  fi

  if [ -z "$domain" ] || [ -z "$upstream" ]; then
    echo "域名和反代目标不能为空。"
    return 1
  fi

  # DNS 解析与本机公网 IP 一致性校验
  local resolved_ip resolved_ip6 local_ip_v4 local_ip_v6
  echo "正在获取公网 IP 并验证域名解析指向，请稍候..."
  local_ip_v4="$(public_ip)"
  local_ip_v6="$(public_ipv6)"
  resolved_ip="$(resolve_dns "$domain" "A" | head -n 1)"
  resolved_ip6="$(resolve_dns "$domain" "AAAA" | head -n 1)"

  local dns_ok=0
  if [ -n "$resolved_ip" ] && [ "$resolved_ip" = "$local_ip_v4" ]; then
    dns_ok=1
  fi
  if [ -n "$resolved_ip6" ] && [ "$resolved_ip6" = "$local_ip_v6" ]; then
    dns_ok=1
  fi

  if [ "$dns_ok" -eq 0 ]; then
    echo -e "${gl_huang}⚠️  警告:${gl_bai} 域名 $domain 解析到的公网 IP 与本机不匹配。"
    echo -e "  域名解析到: IPv4: ${gl_lv}${resolved_ip:-无}${gl_bai} / IPv6: ${gl_lv}${resolved_ip6:-无}${gl_bai}"
    echo -e "  本机公网IP: IPv4: ${gl_lv}${local_ip_v4:-无}${gl_bai} / IPv6: ${gl_lv}${local_ip_v6:-无}${gl_bai}"
    echo "  如果强行添加，Caddy 在为该域名申请 SSL 证书时极大概率会报错或阻塞。"
    read -r -e -p "是否仍然强制添加反代配置？输入 y 继续，回车取消: " _caddy_confirm
    [ "$_caddy_confirm" != "y" ] && [ "$_caddy_confirm" != "Y" ] && echo "已取消操作。" && return 1
  else
    echo -e "${gl_lv}✓ DNS 解析校验通过，域名已正确指向本机。${gl_bai}"
  fi

  # ===== 判定模式 1: Docker 容器化 Caddy =====
  if docker_container_exists caddy; then
    # 1. 确保共享虚拟网络 ua-net 存在并将 Caddy 容器加入
    docker network create ua-net >/dev/null 2>&1 || true
    docker network connect ua-net caddy >/dev/null 2>&1 || true

    local matched_container="" matched_internal_port=""
    if [ -n "$target_container_name" ] && docker_container_exists "$target_container_name"; then
      matched_container="$target_container_name"
      matched_internal_port="${target_container_port:-$default_port}"
    elif docker_container_exists it-tools && ([ "$default_port" = "8080" ] || [ "$target_container_name" = "it-tools" ]); then
      matched_container="it-tools"; matched_internal_port="80"
    elif docker_container_exists filebrowser && ([ "$default_port" = "8082" ] || [ "$target_container_name" = "filebrowser" ]); then
      matched_container="filebrowser"; matched_internal_port="80"
    elif docker_container_exists openlist && ([ "$default_port" = "5244" ] || [ "$target_container_name" = "openlist" ]); then
      matched_container="openlist"; matched_internal_port="5244"
    elif docker_container_exists kuma && ([ "$default_port" = "3001" ] || [ "$default_port" = "3003" ] || [ "$target_container_name" = "kuma" ]); then
      matched_container="kuma"; matched_internal_port="3001"
    elif docker_container_exists "$(npm_container_name)" && ([ "$default_port" = "81" ] || [ "$target_container_name" = "$(npm_container_name)" ]); then
      matched_container="$(npm_container_name)"; matched_internal_port="81"
    fi

    if [ -n "$matched_container" ]; then
      # 2. 自动将目标容器拉入 ua-net 网络，并替换为容器内网直连地址 (http://container_name:internal_port)
      docker network connect ua-net "$matched_container" >/dev/null 2>&1 || true
      upstream="http://${matched_container}:${matched_internal_port}"
      echo -e "${gl_lv}已识别为 [Docker Caddy 模式]，自动优化为 Docker 内网直连代理: ${upstream}${gl_bai}"
    else
      upstream="${upstream//127.0.0.1/172.17.0.1}"
      upstream="${upstream//localhost/172.17.0.1}"
    fi
  # ===== 判定模式 2: 原生 Systemd Caddy =====
  else
    echo -e "${gl_lv}已识别为 [原生 Systemd Caddy 模式]，保留宿主机回环地址反代: ${upstream}${gl_bai}"
  fi

  mkdir -p "$(dirname "$cfg_file")"
  touch "$cfg_file"
  local bak_file="${cfg_file}.ua-box.$(date +%Y%m%d-%H%M%S).bak"
  cp "$cfg_file" "$bak_file"
  prune_old_backups "$(dirname "$cfg_file")" "$(basename "$cfg_file").ua-box.*.bak" "${UA_MAX_BACKUPS:-10}"

  # 清理旧的重复域名配置块（支持嵌套花括号块），防止 Caddy 报 Ambiguous site definition 错误崩溃
  if grep -E "^[[:space:]]*${domain}[[:space:]]*\{" "$cfg_file" >/dev/null 2>&1; then
    echo "提示: 检测到 Caddyfile 中已存在 $domain 配置，正在覆写更新..."
    caddy_remove_domain_block "$cfg_file" "$domain"
  fi

  cat >> "$cfg_file" <<EOF

$domain {
    reverse_proxy $upstream
}
EOF
  log_action "add caddy reverse proxy $domain -> $upstream"
  
  if docker_container_exists caddy; then
    if docker_container_running caddy; then
      docker exec -w /etc/caddy caddy caddy fmt --overwrite Caddyfile 2>/dev/null || true
      if ! docker exec -w /etc/caddy caddy caddy validate --config /etc/caddy/Caddyfile >/dev/null 2>&1; then
        echo -e "${gl_hong}错误: Caddyfile 语法校验失败，已自动回滚至修改前配置。${gl_bai}"
        cp "$bak_file" "$cfg_file"
        return 1
      fi
      docker exec -w /etc/caddy caddy caddy reload --config /etc/caddy/Caddyfile 2>/dev/null || docker restart caddy 2>/dev/null || true
    fi
  elif has_cmd caddy; then
    caddy fmt --overwrite /etc/caddy/Caddyfile 2>/dev/null || true
    if ! caddy validate --config /etc/caddy/Caddyfile; then
      echo -e "${gl_hong}错误: Caddyfile 语法校验失败，已自动回滚至修改前配置。${gl_bai}"
      cp "$bak_file" "$cfg_file"
      return 1
    fi
    svc reload caddy 2>/dev/null || svc restart caddy 2>/dev/null || true
  fi
  echo "已追加 Caddy 反代配置并重载服务。"
}

panel_setup_caddy_proxy() {
  local service_name="$1"
  local default_port="$2"
  local container_name="$3"
  local container_port="${4:-$default_port}"

  local curr_port=""
  if [ -n "$container_name" ] && docker_container_exists "$container_name"; then
    curr_port="$(docker container inspect --format "{{(index (index .HostConfig.PortBindings \"${container_port}/tcp\") 0).HostPort}}" "$container_name" 2>/dev/null)"
  fi
  curr_port="${curr_port:-$default_port}"

  if caddy_add_reverse_proxy "$curr_port" "$container_name" "$container_port"; then
    if [ -n "$container_name" ] && docker_container_exists "$container_name"; then
      local current_ports
      current_ports="$(docker container inspect "$container_name" --format '{{json .NetworkSettings.Ports}}' 2>/dev/null)"
      if [[ "$current_ports" != *"127.0.0.1"* ]]; then
        echo -e "${gl_huang}为了最高安全性，建议防外网扫端口：${gl_bai}"
        local lock_port
        read -r -e -p "是否自动收紧端口为 127.0.0.1 (仅保留 Caddy 域名安全访问，禁止公网直连)？[Y/n]: " lock_port
        lock_port="${lock_port:-Y}"
        if [[ "$lock_port" =~ ^[Yy]$ ]]; then
          if run_recovery_operation bind "$container_name" "$curr_port" "$container_port" 127.0.0.1 "$UA_BOX_BACKUP_DIR" "${UA_CONTAINER_UPDATE_TIMEOUT:-120}"; then
            echo -e "${gl_lv}已核验 $container_name 的端口绑定为 127.0.0.1。${gl_bai}"
          else
            echo "反代已配置，但端口收紧未完成，请核对恢复记录与实际端口。" >&2
            return 1
          fi
        fi
      fi
    fi
  fi
}

