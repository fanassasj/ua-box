npm_install() {
  need_root || return 1
  docker_require || install_docker || return 1

  local name
  name="$(npm_container_name)"
  if docker_container_exists "$name"; then
    docker start "$name"
    echo "Nginx Proxy Manager 容器已存在并已启动: $name"
    return 0
  fi

  local port_80 port_443 port_81
  echo "提示: 如果你的服务器上已经运行了其他 Web 服务(如 Caddy 或 Nginx)，绑定默认的 80/443 会导致冲突。"
  read -r -e -p "请输入 HTTP(80) 映射端口，回车默认 80: " u_80
  port_80="${u_80:-80}"
  read -r -e -p "请输入 HTTPS(443) 映射端口，回车默认 443: " u_443
  port_443="${u_443:-443}"
  read -r -e -p "请输入管理后台(81) 映射端口，回车默认 81: " u_81
  port_81="${u_81:-81}"

  for p in "$port_80" "$port_443" "$port_81"; do
    if ! valid_port "$p"; then
      echo "错误: 端口必须是纯数字。"
      return 1
    fi
    if is_port_taken "$p"; then
      echo -e "${gl_hong}错误:${gl_bai} 端口 $p 已被系统占用，请先释放该端口，或者在安装时指定其他映射端口。"
      return 1
    fi
  done

  local bind_ip deploy_mode
  bind_ip="$(ask_port_bind_ip "Nginx Proxy Manager 管理后台 (端口 $port_81)")"
  deploy_mode="$(ask_deploy_mode "Nginx Proxy Manager")"

  mkdir -p /root/nginx-proxy-manager/data /root/nginx-proxy-manager/letsencrypt
  chmod 750 /root/nginx-proxy-manager /root/nginx-proxy-manager/data /root/nginx-proxy-manager/letsencrypt || return 1
  log_action "install Nginx Proxy Manager (80:$port_80, 443:$port_443, 81:$port_81)"
  
  if [ "$deploy_mode" = "2" ]; then
    cat > /root/nginx-proxy-manager/docker-compose.yml <<EOF
version: '3.8'
services:
  app:
    image: 'jc21/nginx-proxy-manager:latest'
    container_name: '$name'
    restart: unless-stopped
    ports:
      - '${port_80}:80'
      - '${port_443}:443'
      - '${bind_ip}${port_81}:81'
    volumes:
      - '/root/nginx-proxy-manager/data:/data'
      - '/root/nginx-proxy-manager/letsencrypt:/etc/letsencrypt'
EOF
    (cd /root/nginx-proxy-manager && (docker compose up -d 2>/dev/null || docker-compose up -d))
  else
    docker run -d \
      --name "$name" \
      --restart unless-stopped \
      -p "${port_80}:80" -p "${port_443}:443" -p "${bind_ip}${port_81}:81" \
      -v /root/nginx-proxy-manager/data:/data \
      -v /root/nginx-proxy-manager/letsencrypt:/etc/letsencrypt \
      jc21/nginx-proxy-manager:latest
  fi

  if [ "$bind_ip" = "127.0.0.1:" ]; then
    echo -e "Nginx Proxy Manager 已部署。\n本地管理后台端口: http://127.0.0.1:$port_81 (已锁定本地防扫，无法通过外网 IP 直连)"
  else
    echo "Nginx Proxy Manager 已部署。如果映射了非标准端口，请访问对应的映射端口，例如管理后台: http://$(get_display_ip):$port_81"
  fi
  check_and_prompt_caddy_proxy "Nginx Proxy Manager 管理后台" "$port_81" "$name" "81"
}

